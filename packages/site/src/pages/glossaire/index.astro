---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GlossaryList from '../../components/GlossaryList';
import { glossaryEntries } from '../../lib/glossary.js';

const entries = glossaryEntries.map((e) => ({
  slug: e.slug,
  term: e.term,
  category: e.category,
  shortDefinition: e.shortDefinition,
}));

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://www.elupedia.fr/' },
    { '@type': 'ListItem', position: 2, name: 'Glossaire', item: 'https://www.elupedia.fr/glossaire' },
  ],
};

const definedTermSetJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  name: 'Glossaire électoral — Elupedia',
  description:
    "Définitions des mécanismes électoraux français peu connus : panachage, prime majoritaire, triangulaires, communes nouvelles...",
  url: 'https://www.elupedia.fr/glossaire',
  hasDefinedTerm: entries.map((e) => ({
    '@type': 'DefinedTerm',
    name: e.term,
    description: e.shortDefinition,
    url: `https://www.elupedia.fr/glossaire/${e.slug}`,
  })),
};
---

<BaseLayout
  title="Glossaire électoral"
  description="Comprendre les mécanismes électoraux français peu connus — panachage, prime majoritaire, triangulaires, communes nouvelles, secteurs PLM — avec des exemples réels chiffrés."
  jsonLd={breadcrumbJsonLd}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(definedTermSetJsonLd)} />
  </Fragment>

  <div class="max-w-3xl">
    <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white">
      Glossaire électoral
    </h1>
    <p class="mt-3 text-lg text-slate-600 dark:text-slate-400">
      Le droit électoral français a ses subtilités : panachage, prime majoritaire,
      triangulaires, communes nouvelles... Des mécanismes réels qui peuvent
      surprendre à la lecture des résultats. Chaque terme est expliqué avec des
      exemples chiffrés issus de vrais scrutins.
    </p>
  </div>

  <div class="mt-8 max-w-3xl">
    <GlossaryList client:load entries={entries} />
  </div>
</BaseLayout>

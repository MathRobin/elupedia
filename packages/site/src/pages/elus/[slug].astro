---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDb } from '../../lib/db.js';
import { officials, mandates, votes, ballots, affiliations, staffers, interests, pressMentions, addresses, externalLinks, parliamentaryActivity } from '@elupedia/shared';
import { eq, isNull, desc, and, lt, gt, isNotNull } from 'drizzle-orm';

export async function getStaticPaths() {
  const db = getDb();

  const rows = await db
    .select({
      id: officials.id,
      firstName: officials.firstName,
      lastName: officials.lastName,
      birthDate: officials.birthDate,
      photoUrl: officials.photoUrl,
      district: mandates.district,
      department: mandates.department,
      startDate: mandates.startDate,
      politicalGroup: mandates.politicalGroup,
      mandateType: mandates.type,
    })
    .from(officials)
    .innerJoin(mandates, eq(mandates.officialId, officials.id))
    .where(isNull(mandates.endDate));

  const allVotes = await db
    .select({
      officialId: votes.officialId,
      position: votes.position,
      ballotTitle: ballots.title,
      ballotDate: ballots.date,
    })
    .from(votes)
    .innerJoin(ballots, eq(ballots.id, votes.ballotId))
    .orderBy(desc(ballots.date));

  const votesByOfficial = new Map<string, typeof allVotes>();
  for (const v of allVotes) {
    const list = votesByOfficial.get(v.officialId) ?? [];
    list.push(v);
    votesByOfficial.set(v.officialId, list);
  }

  const allAffiliations = await db
    .select({
      officialId: affiliations.officialId,
      partyOrGroup: affiliations.partyOrGroup,
      startDate: affiliations.startDate,
      endDate: affiliations.endDate,
    })
    .from(affiliations)
    .orderBy(desc(affiliations.startDate));

  const affiliationsByOfficial = new Map<string, typeof allAffiliations>();
  for (const a of allAffiliations) {
    const list = affiliationsByOfficial.get(a.officialId) ?? [];
    list.push(a);
    affiliationsByOfficial.set(a.officialId, list);
  }

  const allStaffers = await db
    .select({
      officialId: staffers.officialId,
      firstName: staffers.firstName,
      lastName: staffers.lastName,
      startDate: staffers.startDate,
      endDate: staffers.endDate,
    })
    .from(staffers)
    .orderBy(desc(staffers.startDate));

  const staffersByOfficial = new Map<string, typeof allStaffers>();
  for (const s of allStaffers) {
    const list = staffersByOfficial.get(s.officialId) ?? [];
    list.push(s);
    staffersByOfficial.set(s.officialId, list);
  }

  const allInterests = await db
    .select({
      officialId: interests.officialId,
      type: interests.type,
      entityName: interests.entityName,
      roleDescription: interests.roleDescription,
      declaredDate: interests.declaredDate,
    })
    .from(interests)
    .orderBy(desc(interests.declaredDate));

  const interestsByOfficial = new Map<string, typeof allInterests>();
  for (const i of allInterests) {
    const list = interestsByOfficial.get(i.officialId) ?? [];
    list.push(i);
    interestsByOfficial.set(i.officialId, list);
  }

  const allPress = await db
    .select({
      officialId: pressMentions.officialId,
      title: pressMentions.title,
      sourceName: pressMentions.sourceName,
      sourceUrl: pressMentions.sourceUrl,
      publishedDate: pressMentions.publishedDate,
      summary: pressMentions.summary,
    })
    .from(pressMentions)
    .orderBy(desc(pressMentions.publishedDate));

  const pressByOfficial = new Map<string, typeof allPress>();
  for (const p of allPress) {
    const list = pressByOfficial.get(p.officialId) ?? [];
    list.push(p);
    pressByOfficial.set(p.officialId, list);
  }

  const allAddresses = await db
    .select({
      officialId: addresses.officialId,
      type: addresses.type,
      street: addresses.street,
      postalCode: addresses.postalCode,
      city: addresses.city,
      phone: addresses.phone,
      email: addresses.email,
    })
    .from(addresses);

  const addressesByOfficial = new Map<string, typeof allAddresses>();
  for (const addr of allAddresses) {
    const list = addressesByOfficial.get(addr.officialId) ?? [];
    list.push(addr);
    addressesByOfficial.set(addr.officialId, list);
  }

  const allLinks = await db
    .select({
      officialId: externalLinks.officialId,
      platform: externalLinks.platform,
      url: externalLinks.url,
    })
    .from(externalLinks);

  const linksByOfficial = new Map<string, typeof allLinks>();
  for (const l of allLinks) {
    const list = linksByOfficial.get(l.officialId) ?? [];
    list.push(l);
    linksByOfficial.set(l.officialId, list);
  }

  const allActivities = await db
    .select({
      officialId: parliamentaryActivity.officialId,
      type: parliamentaryActivity.type,
      title: parliamentaryActivity.title,
      date: parliamentaryActivity.date,
      status: parliamentaryActivity.status,
    })
    .from(parliamentaryActivity)
    .orderBy(desc(parliamentaryActivity.date));

  const activitiesByOfficial = new Map<string, typeof allActivities>();
  for (const act of allActivities) {
    const list = activitiesByOfficial.get(act.officialId) ?? [];
    list.push(act);
    activitiesByOfficial.set(act.officialId, list);
  }

  const allMandates = await db
    .select({
      officialId: mandates.officialId,
      firstName: officials.firstName,
      lastName: officials.lastName,
      type: mandates.type,
      district: mandates.district,
      startDate: mandates.startDate,
      endDate: mandates.endDate,
    })
    .from(mandates)
    .innerJoin(officials, eq(officials.id, mandates.officialId))
    .orderBy(mandates.startDate);

  type Neighbor = { id: string; firstName: string; lastName: string } | null;
  const predecessorMap = new Map<string, Neighbor>();
  const successorMap = new Map<string, Neighbor>();

  const seatMap = new Map<string, typeof allMandates>();
  for (const m of allMandates) {
    const key = `${m.type}::${m.district ?? ''}`;
    const list = seatMap.get(key) ?? [];
    list.push(m);
    seatMap.set(key, list);
  }

  for (const row of rows) {
    const key = `${row.mandateType}::${row.district ?? ''}`;
    const seat = seatMap.get(key) ?? [];
    const idx = seat.findIndex((m) => m.officialId === row.id);
    if (idx > 0) {
      const prev = seat[idx - 1];
      predecessorMap.set(row.id, { id: prev.officialId, firstName: prev.firstName, lastName: prev.lastName });
    }
    if (idx >= 0 && idx < seat.length - 1) {
      const next = seat[idx + 1];
      if (next.officialId !== row.id) {
        successorMap.set(row.id, { id: next.officialId, firstName: next.firstName, lastName: next.lastName });
      }
    }
  }

  return rows.map((row) => ({
    params: { slug: row.id },
    props: {
      deputy: row,
      deputyVotes: votesByOfficial.get(row.id) ?? [],
      deputyAffiliations: affiliationsByOfficial.get(row.id) ?? [],
      deputyStaffers: staffersByOfficial.get(row.id) ?? [],
      deputyInterests: interestsByOfficial.get(row.id) ?? [],
      deputyPress: pressByOfficial.get(row.id) ?? [],
      deputyAddresses: addressesByOfficial.get(row.id) ?? [],
      deputyLinks: linksByOfficial.get(row.id) ?? [],
      deputyActivities: activitiesByOfficial.get(row.id) ?? [],
      predecessor: predecessorMap.get(row.id) ?? null,
      successor: successorMap.get(row.id) ?? null,
    },
  }));
}

type Vote = {
  officialId: string;
  position: string;
  ballotTitle: string;
  ballotDate: string;
};

type Affiliation = {
  officialId: string;
  partyOrGroup: string;
  startDate: string;
  endDate: string | null;
};

type Staffer = {
  officialId: string;
  firstName: string;
  lastName: string;
  startDate: string;
  endDate: string | null;
};

type Interest = {
  officialId: string;
  type: string;
  entityName: string;
  roleDescription: string | null;
  declaredDate: string;
};

type PressMention = {
  officialId: string;
  title: string;
  sourceName: string;
  sourceUrl: string;
  publishedDate: string;
  summary: string | null;
};

type Address = {
  officialId: string;
  type: string;
  street: string | null;
  postalCode: string | null;
  city: string | null;
  phone: string | null;
  email: string | null;
};

type ExternalLink = {
  officialId: string;
  platform: string;
  url: string;
};

type Activity = {
  officialId: string;
  type: string;
  title: string;
  date: string;
  status: string | null;
};

type Props = {
  deputy: {
    id: string;
    firstName: string;
    lastName: string;
    birthDate: string | null;
    photoUrl: string | null;
    district: string | null;
    department: string | null;
    startDate: string;
    politicalGroup: string | null;
    mandateType: string;
  };
  deputyVotes: Vote[];
  deputyAffiliations: Affiliation[];
  deputyStaffers: Staffer[];
  deputyInterests: Interest[];
  deputyPress: PressMention[];
  deputyAddresses: Address[];
  deputyLinks: ExternalLink[];
  deputyActivities: Activity[];
  predecessor: { id: string; firstName: string; lastName: string } | null;
  successor: { id: string; firstName: string; lastName: string } | null;
};

const { deputy, deputyVotes, deputyAffiliations, deputyStaffers, deputyInterests, deputyPress, deputyAddresses, deputyLinks, deputyActivities, predecessor, successor } = Astro.props as Props;

const addressTypeLabels: Record<string, string> = {
  constituency_office: 'Permanence',
  assembly_office: 'Bureau AN/Sénat',
};

const platformLabels: Record<string, string> = {
  twitter: 'X (Twitter)',
  facebook: 'Facebook',
  instagram: 'Instagram',
  youtube: 'YouTube',
  tiktok: 'TikTok',
  wikipedia_fr: 'Wikipédia',
  official_page: 'Fiche officielle',
  personal_website: 'Site personnel',
  madada: 'MaDada.fr',
};

const activityTypeLabels: Record<string, string> = {
  written_question: 'Question écrite',
  oral_question: 'Question orale',
  amendment: 'Amendement',
  report: 'Rapport',
};

const statusLabels: Record<string, string> = {
  adopted: 'Adopté',
  rejected: 'Rejeté',
  withdrawn: 'Retiré',
};

const statusColors: Record<string, string> = {
  adopted: 'text-green-700 bg-green-50',
  rejected: 'text-red-700 bg-red-50',
  withdrawn: 'text-yellow-700 bg-yellow-50',
};

const interestTypeLabels: Record<string, string> = {
  company_share: 'Participation en entreprise',
  nonprofit_role: 'Fonction associative/bénévole',
};
const fullName = `${deputy.firstName} ${deputy.lastName}`;

const positionLabels: Record<string, string> = {
  for: 'Pour',
  against: 'Contre',
  abstain: 'Abstention',
  absent: 'Absent',
};

const positionColors: Record<string, string> = {
  for: 'text-green-700 bg-green-50',
  against: 'text-red-700 bg-red-50',
  abstain: 'text-yellow-700 bg-yellow-50',
  absent: 'text-gray-500 bg-gray-50',
};
---

<BaseLayout title={fullName} description={`Fiche de ${fullName}, ${deputy.mandateType}`}>
  <div class="max-w-3xl">
    <a href="/" class="text-sm text-blue-600 hover:underline">&larr; Retour à la liste</a>

    <div class="mt-6 flex items-start gap-6">
      {deputy.photoUrl ? (
        <img
          src={deputy.photoUrl}
          alt={fullName}
          class="h-32 w-32 shrink-0 rounded-full object-cover bg-gray-100"
        />
      ) : (
        <div class="flex h-32 w-32 shrink-0 items-center justify-center rounded-full bg-gray-100 text-3xl font-medium text-gray-400">
          {deputy.firstName[0]}{deputy.lastName[0]}
        </div>
      )}

      <div>
        <h1 class="text-3xl font-bold">{fullName}</h1>
        {deputy.birthDate && (
          <p class="mt-1 text-gray-500">
            Né{deputy.firstName.endsWith('e') ? 'e' : ''} le {new Date(deputy.birthDate).toLocaleDateString('fr-FR')}
          </p>
        )}
      </div>
    </div>

    <section class="mt-8">
      <h2 class="text-xl font-semibold border-b border-gray-200 pb-2">Mandat en cours</h2>
      <dl class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
          <dt class="text-sm text-gray-500">Type</dt>
          <dd class="font-medium">{deputy.mandateType}</dd>
        </div>
        {deputy.district && (
          <div>
            <dt class="text-sm text-gray-500">Circonscription</dt>
            <dd class="font-medium">{deputy.district}</dd>
          </div>
        )}
        {deputy.department && (
          <div>
            <dt class="text-sm text-gray-500">Département</dt>
            <dd class="font-medium">{deputy.department}</dd>
          </div>
        )}
        {deputy.politicalGroup && (
          <div>
            <dt class="text-sm text-gray-500">Groupe politique</dt>
            <dd class="font-medium">{deputy.politicalGroup}</dd>
          </div>
        )}
        <div>
          <dt class="text-sm text-gray-500">Début de mandat</dt>
          <dd class="font-medium">{new Date(deputy.startDate).toLocaleDateString('fr-FR')}</dd>
        </div>
        {predecessor && (
          <div>
            <dt class="text-sm text-gray-500">Prédécesseur</dt>
            <dd class="font-medium">
              <a href={`/elus/${predecessor.id}`} class="text-blue-600 hover:underline">
                {predecessor.firstName} {predecessor.lastName}
              </a>
            </dd>
          </div>
        )}
        {successor && (
          <div>
            <dt class="text-sm text-gray-500">Successeur</dt>
            <dd class="font-medium">
              <a href={`/elus/${successor.id}`} class="text-blue-600 hover:underline">
                {successor.firstName} {successor.lastName}
              </a>
            </dd>
          </div>
        )}
      </dl>
    </section>

    <section class="mt-8">
      <h2 class="text-xl font-semibold border-b border-gray-200 pb-2">Coordonnées</h2>

      {deputyAddresses.length === 0 ? (
        <p class="mt-4 text-gray-500">Aucune adresse enregistrée.</p>
      ) : (
        <div class="mt-4 grid grid-cols-1 gap-6 sm:grid-cols-2">
          {deputyAddresses.map((addr) => (
            <div class="rounded-lg border border-gray-200 p-4">
              <p class="text-sm font-semibold text-gray-700">
                {addressTypeLabels[addr.type] ?? addr.type}
              </p>
              {(addr.street || addr.city) && (
                <p class="mt-2 text-sm text-gray-600">
                  {addr.street && <span>{addr.street}<br /></span>}
                  {addr.postalCode && <span>{addr.postalCode} </span>}
                  {addr.city}
                </p>
              )}
              {addr.phone && (
                <p class="mt-2 text-sm">
                  <a href={`tel:${addr.phone}`} class="text-blue-600 hover:underline">{addr.phone}</a>
                </p>
              )}
              {addr.email && (
                <p class="mt-1 text-sm">
                  <a href={`mailto:${addr.email}`} class="text-blue-600 hover:underline">{addr.email}</a>
                </p>
              )}
            </div>
          ))}
        </div>
      )}
    </section>

    <section class="mt-8">
      <h2 class="text-xl font-semibold border-b border-gray-200 pb-2">
        Affiliations politiques
        {deputyAffiliations.length > 0 && (
          <span class="ml-2 text-sm font-normal text-gray-400">({deputyAffiliations.length})</span>
        )}
      </h2>

      {deputyAffiliations.length === 0 ? (
        <p class="mt-4 text-gray-500">Aucune affiliation enregistrée.</p>
      ) : (
        <ul class="mt-4 space-y-3">
          {deputyAffiliations.map((a) => (
            <li class="flex items-baseline justify-between border-b border-gray-100 pb-3">
              <span class="font-medium">{a.partyOrGroup}</span>
              <span class="text-sm text-gray-500">
                {new Date(a.startDate).toLocaleDateString('fr-FR')}
                {' — '}
                {a.endDate ? new Date(a.endDate).toLocaleDateString('fr-FR') : 'en cours'}
              </span>
            </li>
          ))}
        </ul>
      )}
    </section>

    <section class="mt-8">
      <h2 class="text-xl font-semibold border-b border-gray-200 pb-2">
        Collaborateurs
        {deputyStaffers.length > 0 && (
          <span class="ml-2 text-sm font-normal text-gray-400">({deputyStaffers.length})</span>
        )}
      </h2>

      {deputyStaffers.length === 0 ? (
        <p class="mt-4 text-gray-500">Aucun collaborateur enregistré.</p>
      ) : (
        <ul class="mt-4 space-y-3">
          {deputyStaffers.map((s) => (
            <li class="flex items-baseline justify-between border-b border-gray-100 pb-3">
              <div>
                <span class="font-medium">{s.firstName} {s.lastName}</span>
                {!s.endDate && (
                  <span class="ml-2 inline-block rounded bg-green-50 px-2 py-0.5 text-xs font-medium text-green-700">actif</span>
                )}
                {s.endDate && (
                  <span class="ml-2 inline-block rounded bg-gray-50 px-2 py-0.5 text-xs font-medium text-gray-500">inactif</span>
                )}
              </div>
              <span class="text-sm text-gray-500">
                {new Date(s.startDate).toLocaleDateString('fr-FR')}
                {' — '}
                {s.endDate ? new Date(s.endDate).toLocaleDateString('fr-FR') : "aujourd'hui"}
              </span>
            </li>
          ))}
        </ul>
      )}
    </section>

    <section class="mt-8">
      <h2 class="text-xl font-semibold border-b border-gray-200 pb-2">
        Activité parlementaire
        {deputyActivities.length > 0 && (
          <span class="ml-2 text-sm font-normal text-gray-400">({deputyActivities.length})</span>
        )}
      </h2>

      {deputyActivities.length === 0 ? (
        <p class="mt-4 text-gray-500">Aucune activité parlementaire enregistrée.</p>
      ) : (
        <div class="mt-4 overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-gray-200 text-left text-gray-500">
                <th class="pb-2 pr-4 font-medium">Date</th>
                <th class="pb-2 pr-4 font-medium">Type</th>
                <th class="pb-2 pr-4 font-medium">Intitulé</th>
                <th class="pb-2 font-medium">Statut</th>
              </tr>
            </thead>
            <tbody>
              {deputyActivities.map((act) => (
                <tr class="border-b border-gray-100">
                  <td class="py-2 pr-4 whitespace-nowrap">
                    {new Date(act.date).toLocaleDateString('fr-FR')}
                  </td>
                  <td class="py-2 pr-4 whitespace-nowrap">
                    {activityTypeLabels[act.type] ?? act.type}
                  </td>
                  <td class="py-2 pr-4">{act.title}</td>
                  <td class="py-2">
                    {act.status ? (
                      <span class={`inline-block rounded px-2 py-0.5 text-xs font-medium ${statusColors[act.status] ?? ''}`}>
                        {statusLabels[act.status] ?? act.status}
                      </span>
                    ) : (
                      <span class="text-gray-400">—</span>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </section>

    <section class="mt-8">
      <h2 class="text-xl font-semibold border-b border-gray-200 pb-2">
        Intérêts déclarés
        {deputyInterests.length > 0 && (
          <span class="ml-2 text-sm font-normal text-gray-400">({deputyInterests.length})</span>
        )}
      </h2>

      {deputyInterests.length === 0 ? (
        <p class="mt-4 text-gray-500">Aucun intérêt déclaré.</p>
      ) : (
        <ul class="mt-4 space-y-3">
          {deputyInterests.map((i) => (
            <li class="border-b border-gray-100 pb-3">
              <div class="flex items-baseline justify-between">
                <span class="font-medium">{i.entityName}</span>
                <span class="text-sm text-gray-500">
                  {new Date(i.declaredDate).toLocaleDateString('fr-FR')}
                </span>
              </div>
              <div class="mt-1 flex items-center gap-2">
                <span class="inline-block rounded bg-blue-50 px-2 py-0.5 text-xs font-medium text-blue-700">
                  {interestTypeLabels[i.type] ?? i.type}
                </span>
                {i.roleDescription && (
                  <span class="text-sm text-gray-500">{i.roleDescription}</span>
                )}
              </div>
            </li>
          ))}
        </ul>
      )}
    </section>

    <section class="mt-8">
      <h2 class="text-xl font-semibold border-b border-gray-200 pb-2">
        Historique des votes
        {deputyVotes.length > 0 && (
          <span class="ml-2 text-sm font-normal text-gray-400">({deputyVotes.length})</span>
        )}
      </h2>

      {deputyVotes.length === 0 ? (
        <p class="mt-4 text-gray-500">Aucun vote enregistré.</p>
      ) : (
        <div class="mt-4 overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-gray-200 text-left text-gray-500">
                <th class="pb-2 pr-4 font-medium">Date</th>
                <th class="pb-2 pr-4 font-medium">Scrutin</th>
                <th class="pb-2 font-medium">Position</th>
              </tr>
            </thead>
            <tbody>
              {deputyVotes.map((v) => (
                <tr class="border-b border-gray-100">
                  <td class="py-2 pr-4 whitespace-nowrap">
                    {new Date(v.ballotDate).toLocaleDateString('fr-FR')}
                  </td>
                  <td class="py-2 pr-4">{v.ballotTitle}</td>
                  <td class="py-2">
                    <span class={`inline-block rounded px-2 py-0.5 text-xs font-medium ${positionColors[v.position] ?? ''}`}>
                      {positionLabels[v.position] ?? v.position}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </section>

    <section class="mt-8">
      <h2 class="text-xl font-semibold border-b border-gray-200 pb-2">
        Dans la presse
        {deputyPress.length > 0 && (
          <span class="ml-2 text-sm font-normal text-gray-400">({deputyPress.length})</span>
        )}
      </h2>

      {deputyPress.length === 0 ? (
        <p class="mt-4 text-gray-500">Aucune mention presse enregistrée.</p>
      ) : (
        <ul class="mt-4 space-y-4">
          {deputyPress.map((p) => (
            <li class="border-b border-gray-100 pb-4">
              <a
                href={p.sourceUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="font-medium text-blue-700 hover:underline"
              >
                {p.title}
              </a>
              <div class="mt-1 flex items-center gap-2 text-sm text-gray-500">
                <span>{p.sourceName}</span>
                <span>&middot;</span>
                <span>{new Date(p.publishedDate).toLocaleDateString('fr-FR')}</span>
              </div>
              {p.summary && (
                <p class="mt-2 text-sm text-gray-600">{p.summary}</p>
              )}
            </li>
          ))}
        </ul>
      )}
    </section>

    <section class="mt-8">
      <h2 class="text-xl font-semibold border-b border-gray-200 pb-2">Liens extérieurs</h2>

      {deputyLinks.length === 0 ? (
        <p class="mt-4 text-gray-500">Aucun lien externe enregistré.</p>
      ) : (
        <ul class="mt-4 flex flex-wrap gap-3">
          {deputyLinks.map((l) => (
            <li>
              <a
                href={l.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 rounded-full border border-gray-200 px-3 py-1.5 text-sm text-blue-700 hover:border-blue-300 hover:bg-blue-50 transition-colors no-underline"
              >
                {platformLabels[l.platform] ?? l.platform}
              </a>
            </li>
          ))}
        </ul>
      )}
    </section>
  </div>
</BaseLayout>

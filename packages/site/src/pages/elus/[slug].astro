---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDb } from '../../lib/db.js';
import { officials, mandates, votes, ballots, affiliations } from '@elupedia/shared';
import { eq, isNull, desc } from 'drizzle-orm';

export async function getStaticPaths() {
  const db = getDb();

  const rows = await db
    .select({
      id: officials.id,
      firstName: officials.firstName,
      lastName: officials.lastName,
      birthDate: officials.birthDate,
      photoUrl: officials.photoUrl,
      district: mandates.district,
      department: mandates.department,
      startDate: mandates.startDate,
      politicalGroup: mandates.politicalGroup,
      mandateType: mandates.type,
    })
    .from(officials)
    .innerJoin(mandates, eq(mandates.officialId, officials.id))
    .where(isNull(mandates.endDate));

  const allVotes = await db
    .select({
      officialId: votes.officialId,
      position: votes.position,
      ballotTitle: ballots.title,
      ballotDate: ballots.date,
    })
    .from(votes)
    .innerJoin(ballots, eq(ballots.id, votes.ballotId))
    .orderBy(desc(ballots.date));

  const votesByOfficial = new Map<string, typeof allVotes>();
  for (const v of allVotes) {
    const list = votesByOfficial.get(v.officialId) ?? [];
    list.push(v);
    votesByOfficial.set(v.officialId, list);
  }

  const allAffiliations = await db
    .select({
      officialId: affiliations.officialId,
      partyOrGroup: affiliations.partyOrGroup,
      startDate: affiliations.startDate,
      endDate: affiliations.endDate,
    })
    .from(affiliations)
    .orderBy(desc(affiliations.startDate));

  const affiliationsByOfficial = new Map<string, typeof allAffiliations>();
  for (const a of allAffiliations) {
    const list = affiliationsByOfficial.get(a.officialId) ?? [];
    list.push(a);
    affiliationsByOfficial.set(a.officialId, list);
  }

  return rows.map((row) => ({
    params: { slug: row.id },
    props: {
      deputy: row,
      deputyVotes: votesByOfficial.get(row.id) ?? [],
      deputyAffiliations: affiliationsByOfficial.get(row.id) ?? [],
    },
  }));
}

type Vote = {
  officialId: string;
  position: string;
  ballotTitle: string;
  ballotDate: string;
};

type Affiliation = {
  officialId: string;
  partyOrGroup: string;
  startDate: string;
  endDate: string | null;
};

type Props = {
  deputy: {
    id: string;
    firstName: string;
    lastName: string;
    birthDate: string | null;
    photoUrl: string | null;
    district: string | null;
    department: string | null;
    startDate: string;
    politicalGroup: string | null;
    mandateType: string;
  };
  deputyVotes: Vote[];
  deputyAffiliations: Affiliation[];
};

const { deputy, deputyVotes, deputyAffiliations } = Astro.props as Props;
const fullName = `${deputy.firstName} ${deputy.lastName}`;

const positionLabels: Record<string, string> = {
  for: 'Pour',
  against: 'Contre',
  abstain: 'Abstention',
  absent: 'Absent',
};

const positionColors: Record<string, string> = {
  for: 'text-green-700 bg-green-50',
  against: 'text-red-700 bg-red-50',
  abstain: 'text-yellow-700 bg-yellow-50',
  absent: 'text-gray-500 bg-gray-50',
};
---

<BaseLayout title={fullName} description={`Fiche de ${fullName}, ${deputy.mandateType}`}>
  <div class="max-w-3xl">
    <a href="/" class="text-sm text-blue-600 hover:underline">&larr; Retour à la liste</a>

    <div class="mt-6 flex items-start gap-6">
      {deputy.photoUrl ? (
        <img
          src={deputy.photoUrl}
          alt={fullName}
          class="h-32 w-32 shrink-0 rounded-full object-cover bg-gray-100"
        />
      ) : (
        <div class="flex h-32 w-32 shrink-0 items-center justify-center rounded-full bg-gray-100 text-3xl font-medium text-gray-400">
          {deputy.firstName[0]}{deputy.lastName[0]}
        </div>
      )}

      <div>
        <h1 class="text-3xl font-bold">{fullName}</h1>
        {deputy.birthDate && (
          <p class="mt-1 text-gray-500">
            Né{deputy.firstName.endsWith('e') ? 'e' : ''} le {new Date(deputy.birthDate).toLocaleDateString('fr-FR')}
          </p>
        )}
      </div>
    </div>

    <section class="mt-8">
      <h2 class="text-xl font-semibold border-b border-gray-200 pb-2">Mandat en cours</h2>
      <dl class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
          <dt class="text-sm text-gray-500">Type</dt>
          <dd class="font-medium">{deputy.mandateType}</dd>
        </div>
        {deputy.district && (
          <div>
            <dt class="text-sm text-gray-500">Circonscription</dt>
            <dd class="font-medium">{deputy.district}</dd>
          </div>
        )}
        {deputy.department && (
          <div>
            <dt class="text-sm text-gray-500">Département</dt>
            <dd class="font-medium">{deputy.department}</dd>
          </div>
        )}
        {deputy.politicalGroup && (
          <div>
            <dt class="text-sm text-gray-500">Groupe politique</dt>
            <dd class="font-medium">{deputy.politicalGroup}</dd>
          </div>
        )}
        <div>
          <dt class="text-sm text-gray-500">Début de mandat</dt>
          <dd class="font-medium">{new Date(deputy.startDate).toLocaleDateString('fr-FR')}</dd>
        </div>
      </dl>
    </section>

    <section class="mt-8">
      <h2 class="text-xl font-semibold border-b border-gray-200 pb-2">
        Affiliations politiques
        {deputyAffiliations.length > 0 && (
          <span class="ml-2 text-sm font-normal text-gray-400">({deputyAffiliations.length})</span>
        )}
      </h2>

      {deputyAffiliations.length === 0 ? (
        <p class="mt-4 text-gray-500">Aucune affiliation enregistrée.</p>
      ) : (
        <ul class="mt-4 space-y-3">
          {deputyAffiliations.map((a) => (
            <li class="flex items-baseline justify-between border-b border-gray-100 pb-3">
              <span class="font-medium">{a.partyOrGroup}</span>
              <span class="text-sm text-gray-500">
                {new Date(a.startDate).toLocaleDateString('fr-FR')}
                {' — '}
                {a.endDate ? new Date(a.endDate).toLocaleDateString('fr-FR') : 'en cours'}
              </span>
            </li>
          ))}
        </ul>
      )}
    </section>

    <section class="mt-8">
      <h2 class="text-xl font-semibold border-b border-gray-200 pb-2">
        Historique des votes
        {deputyVotes.length > 0 && (
          <span class="ml-2 text-sm font-normal text-gray-400">({deputyVotes.length})</span>
        )}
      </h2>

      {deputyVotes.length === 0 ? (
        <p class="mt-4 text-gray-500">Aucun vote enregistré.</p>
      ) : (
        <div class="mt-4 overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-gray-200 text-left text-gray-500">
                <th class="pb-2 pr-4 font-medium">Date</th>
                <th class="pb-2 pr-4 font-medium">Scrutin</th>
                <th class="pb-2 font-medium">Position</th>
              </tr>
            </thead>
            <tbody>
              {deputyVotes.map((v) => (
                <tr class="border-b border-gray-100">
                  <td class="py-2 pr-4 whitespace-nowrap">
                    {new Date(v.ballotDate).toLocaleDateString('fr-FR')}
                  </td>
                  <td class="py-2 pr-4">{v.ballotTitle}</td>
                  <td class="py-2">
                    <span class={`inline-block rounded px-2 py-0.5 text-xs font-medium ${positionColors[v.position] ?? ''}`}>
                      {positionLabels[v.position] ?? v.position}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </section>
  </div>
</BaseLayout>

                  {addressParts.length > 0 && (
                    <p class={`text-sm text-slate-600 ${img ? '' : 'mt-2'}`}>
                      {addr.street && <span>{addr.street}<br /></span>}
                      {addr.postalCode && <span>{addr.postalCode} </span>}
                      {addr.city}
                    </p>
                  )}
                  {(addr.phone || addr.email) && (
                    <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 border-t border-slate-100 pt-3">
                      {addr.phone && (
                        <a href={`tel:${addr.phone}`} class="inline-flex items-center gap-1.5 text-sm text-slate-600 hover:text-indigo-600 transition-colors">
                          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor">
                            <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z" />
                          </svg>
                          {addr.phone}
                        </a>
                      )}
                      {addr.email && (
                        <a href={`mailto:${addr.email}`} class="inline-flex items-center gap-1.5 text-sm text-slate-600 hover:text-indigo-600 transition-colors truncate">
                          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                            <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z" />
                            <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z" />
                          </svg>
                          {addr.email}
                        </a>
                      )}
                    </div>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      )}

                <tr class="border-b border-slate-100">
                  <td class="py-2 pr-4 whitespace-nowrap">
                    {new Date(v.ballotDate).toLocaleDateString('fr-FR')}
                  </td>
                  <td class="py-2 pr-4">{v.ballotTitle}</td>
                  <td class="py-2">
                    <span class={`inline-block rounded px-2 py-0.5 text-xs font-medium ${positionColors[v.position] ?? ''}`}>
                      {positionLabels[v.position] ?? v.position}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </section>

    <section id="presse" class="mt-8 scroll-mt-12">
      <h2 class="text-lg font-semibold border-l-4 border-indigo-500 pl-3">
        Dans la presse
        {deputyPress.length > 0 && (
          <span class="ml-2 text-sm font-normal text-slate-500">({deputyPress.length})</span>
        )}
      </h2>

      {deputyPress.length === 0 ? (
        <p class="mt-4 text-slate-500">Aucune mention presse enregistrée/trouvée.</p>
      ) : (
        <ul class="mt-4 space-y-4">
          {deputyPress.map((p) => (
            <li class="border-b border-slate-100 pb-4">
              <a
                href={p.sourceUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="font-medium text-indigo-600 hover:underline"
              >
                {p.title}
              </a>
              <div class="mt-1 flex items-center gap-2 text-sm text-slate-500">
                <span>{p.sourceName}</span>
                <span>&middot;</span>
                <span>{new Date(p.publishedDate).toLocaleDateString('fr-FR')}</span>
              </div>
              {p.summary && (
                <p class="mt-2 text-sm text-slate-600">{p.summary}</p>
              )}
            </li>
          ))}
        </ul>
      )}
    </section>

    <section id="chronologie" class="mt-8 scroll-mt-12">
      <h2 class="text-lg font-semibold border-l-4 border-indigo-500 pl-3">
        Chronologie
        {timelineEvents.length > 0 && (
          <span class="ml-2 text-sm font-normal text-slate-500">({timelineEvents.length})</span>
        )}
      </h2>

      {timelineEvents.length === 0 ? (
        <p class="mt-4 text-slate-500">Aucun événement à afficher.</p>
      ) : (
        <ul class="mt-4 space-y-3">
          {timelineEvents.map((evt) => (
            <li class="flex items-baseline gap-4 border-b border-slate-100 pb-3">
              <span class="shrink-0 text-sm text-slate-500 whitespace-nowrap">
                {new Date(evt.date).toLocaleDateString('fr-FR')}
              </span>
              <span class={`shrink-0 inline-block rounded px-2 py-0.5 text-xs font-medium ${timelineCategoryColors[evt.category] ?? ''}`}>
                {evt.category}
              </span>
              <span class="text-sm">{evt.label}</span>
            </li>
          ))}
        </ul>
      )}
    </section>

    <section id="liens" class="mt-8 scroll-mt-12">
      <h2 class="text-lg font-semibold border-l-4 border-indigo-500 pl-3">Liens extérieurs</h2>

      {(() => {
        const cardPlatforms = new Set(['facebook', 'twitter', 'personal_website']);
        const cardLinks = deputyLinks.filter((l) => cardPlatforms.has(l.platform));
        const pillLinks = deputyLinks.filter((l) => !cardPlatforms.has(l.platform));
        const hasAnCard = !!deputy.anId;
        const hasCards = hasAnCard || cardLinks.length > 0;
        const hasPills = pillLinks.length > 0;
        const hasNothing = !hasCards && !hasPills;

        const linkCardConfigs: Record<string, { icon: string; color: string; hoverColor: string; label: string }> = {
          facebook: {
            icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>',
            color: 'text-[#1877F2]',
            hoverColor: 'group-hover:text-[#1565C0]',
            label: 'Facebook',
          },
          twitter: {
            icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>',
            color: 'text-slate-900',
            hoverColor: 'group-hover:text-slate-700',
            label: 'X (Twitter)',
          },
          personal_website: {
            icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>',
            color: 'text-emerald-600',
            hoverColor: 'group-hover:text-emerald-700',
            label: 'Site personnel',
          },
        };

        const externalLinkIcon = '<svg xmlns="http://www.w3.org/2000/svg" class="ml-1 inline-block h-3 w-3 align-baseline" viewBox="0 0 12 12" fill="currentColor"><path d="M6 1h5v5l-2-2-3 3-2-2 3-3z"/><path d="M9.5 7.5v3h-8v-8h3l1-1h-4a1 1 0 00-1 1v8a1 1 0 001 1h8a1 1 0 001-1v-4z"/></svg>';

        return (
          <>
            {hasCards && (
              <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {deputy.anId && (
                  <a
                    href={`https://www.assemblee-nationale.fr/dyn/deputes/${deputy.anId}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group flex items-center gap-4 rounded-2xl bg-white p-4 shadow-sm ring-1 ring-slate-900/5 transition-shadow hover:shadow-md no-underline"
                  >
                    <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-indigo-50 text-indigo-600">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M5 21V7l8-4v18"/><path d="M19 21V11l-6-4"/><path d="M9 9v.01"/><path d="M9 12v.01"/><path d="M9 15v.01"/><path d="M9 18v.01"/></svg>
                    </div>
                    <div class="min-w-0">
                      <p class="text-sm font-semibold text-slate-800 group-hover:text-indigo-600 transition-colors">
                        Assemblée nationale
                      </p>
                      <p class="text-xs text-slate-500 truncate" set:html={`Fiche officielle${externalLinkIcon}`} />
                    </div>
                  </a>
                )}
                {cardLinks.map((l) => {
                  const cfg = linkCardConfigs[l.platform];
                  if (!cfg) return null;
                  const displayUrl = l.url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/+$/, '');
                  return (
                    <a
                      href={l.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="group flex items-center gap-4 rounded-2xl bg-white p-4 shadow-sm ring-1 ring-slate-900/5 transition-shadow hover:shadow-md no-underline"
                    >
                      <div class={`flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-slate-50 ${cfg.color}`}>
                        <Fragment set:html={cfg.icon} />
                      </div>
                      <div class="min-w-0">
                        <p class={`text-sm font-semibold text-slate-800 ${cfg.hoverColor} transition-colors`}>
                          {cfg.label}
                        </p>
                        <p class="text-xs text-slate-500 truncate" set:html={`${displayUrl}${externalLinkIcon}`} />
                      </div>
                    </a>
                  );
                })}
              </div>
            )}

            {hasPills && (
              <ul class="mt-4 flex flex-wrap gap-3">
                {pillLinks.map((l) => (
                  <li>
                    <a
                      href={l.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 rounded-full bg-white px-3.5 py-1.5 text-sm font-medium text-indigo-600 shadow-sm ring-1 ring-slate-900/5 hover:ring-indigo-400/40 hover:shadow-md transition-all no-underline"
                    >
                      {platformLabels[l.platform] ?? l.platform}
                    </a>
                  </li>
                ))}
              </ul>
            )}

            {hasNothing && (
              <p class="mt-4 text-slate-500">Aucun lien externe enregistré.</p>
            )}
          </>
        );
      })()}
    </section>
  </div>

  <QuestionDetailDrawer client:idle />

  <script>
    const tocInline = document.getElementById('toc-inline');
    const tocSticky = document.getElementById('toc-sticky');
    if (tocInline && tocSticky) {
      const visibilityObserver = new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting) {
            tocSticky.classList.add('-translate-y-full');
            tocSticky.setAttribute('aria-hidden', 'true');
          } else {
            tocSticky.classList.remove('-translate-y-full');
            tocSticky.setAttribute('aria-hidden', 'false');
          }
        },
        { threshold: 0 },
      );
      visibilityObserver.observe(tocInline);

      const sectionIds = [
        'mandat', 'coordonnees', 'affiliations', 'collaborateurs',
        'activite', 'commissions', 'electoral', 'interets',
        'votes', 'presse', 'chronologie', 'liens',
      ];

      let currentId = '';

      function setActive(id: string) {
        if (id === currentId) return;
        currentId = id;
        for (const nav of [tocInline, tocSticky]) {
          if (!nav) {
            continue;
          }
          for (const link of nav.querySelectorAll('a')) {
            const href = link.getAttribute('href');
            if (href === `#${id}`) {
              link.classList.remove('text-slate-600', 'text-slate-500');
              link.classList.add('text-indigo-600', 'font-semibold');
            } else {
              link.classList.remove('text-indigo-600', 'font-semibold');
              link.classList.add(
                nav === tocInline ? 'text-slate-600' : 'text-slate-500',
              );
            }
          }
        }
      }

      const spyObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              setActive(entry.target.id);
            }
          }
        },
        { rootMargin: '-10% 0px -80% 0px' },
      );

      for (const id of sectionIds) {
        const el = document.getElementById(id);
        if (el) spyObserver.observe(el);
      }
    }

    const filterContainer = document.getElementById('committees-filter');
    const statusFilterContainer = document.getElementById('committees-status-filter');
    const committeesList = document.getElementById('committees-list');
    const committeesCount = document.getElementById('committees-count');

    if (filterContainer && statusFilterContainer && committeesList) {
      const typeCheckboxes = filterContainer.querySelectorAll<HTMLInputElement>('[data-committee-filter]');
      const statusCheckboxes = statusFilterContainer.querySelectorAll<HTMLInputElement>('[data-committee-status-filter]');
      const items = committeesList.querySelectorAll<HTMLElement>('[data-committee-type]');

      function applyFilter() {
        const activeTypes = new Set<string>();
        for (const cb of typeCheckboxes) {
          if (cb.checked) activeTypes.add(cb.value);
        }
        const activeStatuses = new Set<string>();
        for (const cb of statusCheckboxes) {
          if (cb.checked) activeStatuses.add(cb.value);
        }
        let visible = 0;
        for (const item of items) {
          const show = activeTypes.has(item.dataset.committeeType!) && activeStatuses.has(item.dataset.committeeStatus!);
          item.style.display = show ? '' : 'none';
          if (show) visible++;
        }
        if (committeesCount) {
          committeesCount.textContent = `(${visible})`;
        }
      }

      for (const cb of typeCheckboxes) {
        cb.addEventListener('change', applyFilter);
      }
      for (const cb of statusCheckboxes) {
        cb.addEventListener('change', applyFilter);
      }
    }

    const activityTypeFilter = document.getElementById('activity-type-filter');
    const dateFrom = document.getElementById('activity-date-from') as HTMLInputElement | null;
    const dateTo = document.getElementById('activity-date-to') as HTMLInputElement | null;
    const dateReset = document.getElementById('activity-date-reset');
    const activityList = document.getElementById('activity-list');
    const activityCount = document.getElementById('activity-count');

    if (activityTypeFilter && dateFrom && dateTo && activityList) {
      const typeCheckboxes = activityTypeFilter.querySelectorAll<HTMLInputElement>('[data-activity-type-filter]');
      const rows = activityList.querySelectorAll<HTMLElement>('[data-activity-date]');

      function applyActivityFilter() {
        const activeTypes = new Set<string>();
        for (const cb of typeCheckboxes) {
          if (cb.checked) activeTypes.add(cb.value);
        }
        const from = dateFrom!.value;
        const to = dateTo!.value;
        let visible = 0;
        for (const row of rows) {
          const date = row.dataset.activityDate!;
          const type = row.dataset.activityType!;
          const show = activeTypes.has(type) && (!from || date >= from) && (!to || date <= to);
          row.style.display = show ? '' : 'none';
          if (show) visible++;
        }
        if (activityCount) {
          activityCount.textContent = `${visible} résultat${visible > 1 ? 's' : ''}`;
        }
      }

      for (const cb of typeCheckboxes) {
        cb.addEventListener('change', applyActivityFilter);
      }
      dateFrom.addEventListener('change', applyActivityFilter);
      dateTo.addEventListener('change', applyActivityFilter);

      if (dateReset) {
        dateReset.addEventListener('click', () => {
          dateFrom.value = '';
          dateTo.value = '';
          applyActivityFilter();
        });
      }
    }

    document.querySelectorAll<HTMLTableRowElement>('[data-activity-detail]').forEach((row) => {
      row.addEventListener('click', () => {
        const detail = JSON.parse(row.dataset.activityDetail!);
        window.dispatchEvent(new CustomEvent('open-question-detail', { detail }));
      });
    });

  </script>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDb } from '../../lib/db.js';
import { officials, mandates, votes, ballots, affiliations, staffers, interests, pressMentions, addresses, externalLinks, parliamentaryActivity, committees, electoralResults, declarationSnapshots, campaignAccounts } from '@elupedia/shared';
import { eq, isNull, desc, and, lt, gt, isNotNull, inArray } from 'drizzle-orm';
import { differenceInYears } from 'date-fns';
import { createHash } from 'node:crypto';
import QuestionDetailDrawer from '../../components/QuestionDetailDrawer.tsx';
import InterestDetailDrawer from '../../components/InterestDetailDrawer.tsx';

export async function getStaticPaths() {
  const db = getDb();

  const rows = await db
    .select({
      id: officials.id,
      slug: officials.slug,
      firstName: officials.firstName,
      lastName: officials.lastName,
      birthDate: officials.birthDate,
      photoUrl: officials.photoUrl,
      anId: officials.anId,
      senatId: officials.senatId,
      district: mandates.district,
      department: mandates.department,
      startDate: mandates.startDate,
      politicalGroup: mandates.politicalGroup,
      mandateType: mandates.type,
    })
    .from(officials)
    .innerJoin(mandates, eq(mandates.officialId, officials.id))
    .where(isNull(mandates.endDate));

  const allMandates = await db
    .select({
      officialId: mandates.officialId,
      type: mandates.type,
      district: mandates.district,
      department: mandates.department,
      startDate: mandates.startDate,
      endDate: mandates.endDate,
      politicalGroup: mandates.politicalGroup,
      updatedAt: mandates.updatedAt,
    })
    .from(mandates)
    .orderBy(desc(mandates.startDate));

  const mandatesByOfficial = new Map<string, typeof allMandates>();
  for (const m of allMandates) {
    const list = mandatesByOfficial.get(m.officialId) ?? [];
    list.push(m);
    mandatesByOfficial.set(m.officialId, list);
  }

  const allVotes = await db
    .select({
      officialId: votes.officialId,
      ballotId: votes.ballotId,
      position: votes.position,
      ballotTitle: ballots.title,
      ballotDate: ballots.date,
      updatedAt: votes.updatedAt,
    })
    .from(votes)
    .innerJoin(ballots, eq(ballots.id, votes.ballotId))
    .orderBy(desc(ballots.date));

  const votesByOfficial = new Map<string, typeof allVotes>();
  for (const v of allVotes) {
    const list = votesByOfficial.get(v.officialId) ?? [];
    if (list.length < 20) list.push(v);
    votesByOfficial.set(v.officialId, list);
  }

  const allAffiliations = await db
    .select({
      officialId: affiliations.officialId,
      partyOrGroup: affiliations.partyOrGroup,
      startDate: affiliations.startDate,
      endDate: affiliations.endDate,
      updatedAt: affiliations.updatedAt,
    })
    .from(affiliations)
    .orderBy(desc(affiliations.startDate));

  const affiliationsByOfficial = new Map<string, typeof allAffiliations>();
  for (const a of allAffiliations) {
    const list = affiliationsByOfficial.get(a.officialId) ?? [];
    list.push(a);
    affiliationsByOfficial.set(a.officialId, list);
  }

  const allStaffers = await db
    .select({
      officialId: staffers.officialId,
      firstName: staffers.firstName,
      lastName: staffers.lastName,
      startDate: staffers.startDate,
      endDate: staffers.endDate,
      updatedAt: staffers.updatedAt,
    })
    .from(staffers)
    .orderBy(desc(staffers.startDate), staffers.lastName);

  const staffersByOfficial = new Map<string, typeof allStaffers>();
  for (const s of allStaffers) {
    const list = staffersByOfficial.get(s.officialId) ?? [];
    list.push(s);
    staffersByOfficial.set(s.officialId, list);
  }

  const allInterests = await db
    .select({
      officialId: interests.officialId,
      type: interests.type,
      category: interests.category,
      entityName: interests.entityName,
      roleDescription: interests.roleDescription,
      declaredDate: interests.declaredDate,
      declarantComment: interests.declarantComment,
      sourceDocumentUrl: interests.sourceDocumentUrl,
      ownershipDetail: interests.ownershipDetail,
      annualAmount: interests.annualAmount,
      amountYear: interests.amountYear,
      amountIsNet: interests.amountIsNet,
      updatedAt: interests.updatedAt,
    })
    .from(interests)
    .orderBy(desc(interests.declaredDate));

  const interestsByOfficial = new Map<string, typeof allInterests>();
  for (const i of allInterests) {
    const list = interestsByOfficial.get(i.officialId) ?? [];
    list.push(i);
    interestsByOfficial.set(i.officialId, list);
  }

  const allSnapshots = await db
    .select({
      officialId: declarationSnapshots.officialId,
      declarationDate: declarationSnapshots.declarationDate,
      declarationType: declarationSnapshots.declarationType,
    })
    .from(declarationSnapshots)
    .orderBy(desc(declarationSnapshots.declarationDate));

  const snapshotsByOfficial = new Map<string, typeof allSnapshots>();
  for (const s of allSnapshots) {
    const list = snapshotsByOfficial.get(s.officialId) ?? [];
    list.push(s);
    snapshotsByOfficial.set(s.officialId, list);
  }

  const PRESS_BATCH = 50;
  const officialIds = rows.map((r) => r.id);
  const allPress: { officialId: string; title: string | null; sourceName: string | null; sourceUrl: string | null; publishedDate: string | null }[] = [];
  for (let i = 0; i < officialIds.length; i += PRESS_BATCH) {
    const chunk = officialIds.slice(i, i + PRESS_BATCH);
    const batch = await db
      .select({
        officialId: pressMentions.officialId,
        title: pressMentions.title,
        sourceName: pressMentions.sourceName,
        sourceUrl: pressMentions.sourceUrl,
        publishedDate: pressMentions.publishedDate,
        updatedAt: pressMentions.updatedAt,
      })
      .from(pressMentions)
      .where(inArray(pressMentions.officialId, chunk))
      .orderBy(desc(pressMentions.publishedDate));
    allPress.push(...batch);
  }

  const pressByOfficial = new Map<string, typeof allPress>();
  for (const p of allPress) {
    const list = pressByOfficial.get(p.officialId) ?? [];
    if (list.length < 20) list.push(p);
    pressByOfficial.set(p.officialId, list);
  }

  const allAddresses = await db
    .select({
      officialId: addresses.officialId,
      type: addresses.type,
      street: addresses.street,
      postalCode: addresses.postalCode,
      city: addresses.city,
      phone: addresses.phone,
      email: addresses.email,
      latitude: addresses.latitude,
      longitude: addresses.longitude,
      updatedAt: addresses.updatedAt,
    })
    .from(addresses);

  const mapsBaseUrl = process.env.MAPS_BASE_URL;

  type AddressWithMap = (typeof allAddresses)[number] & { mapUrl: string | null };
  const addressesWithMaps: AddressWithMap[] = allAddresses.map((addr) => {
    let mapUrl: string | null = null;
    if (mapsBaseUrl && addr.latitude != null && addr.longitude != null) {
      const hash = createHash('md5')
        .update(`${addr.latitude}_${addr.longitude}_13_400x200`)
        .digest('hex');
      mapUrl = `${mapsBaseUrl}/maps/${hash}.png`;
    }
    return { ...addr, mapUrl };
  });

  const addressesByOfficial = new Map<string, AddressWithMap[]>();
  for (const addr of addressesWithMaps) {
    const list = addressesByOfficial.get(addr.officialId) ?? [];
    list.push(addr);
    addressesByOfficial.set(addr.officialId, list);
  }

  const allLinks = await db
    .select({
      officialId: externalLinks.officialId,
      platform: externalLinks.platform,
      url: externalLinks.url,
      source: externalLinks.source,
      updatedAt: externalLinks.updatedAt,
    })
    .from(externalLinks)
    .where(eq(externalLinks.status, 'published'));

  const linksByOfficial = new Map<string, typeof allLinks>();
  for (const l of allLinks) {
    const list = linksByOfficial.get(l.officialId) ?? [];
    list.push(l);
    linksByOfficial.set(l.officialId, list);
  }

  const allActivities = await db
    .select({
      officialId: parliamentaryActivity.officialId,
      type: parliamentaryActivity.type,
      title: parliamentaryActivity.title,
      date: parliamentaryActivity.date,
      status: parliamentaryActivity.status,
      responseDate: parliamentaryActivity.responseDate,
      governmentComments: parliamentaryActivity.governmentComments,
      rubrique: parliamentaryActivity.rubrique,
      updatedAt: parliamentaryActivity.updatedAt,
    })
    .from(parliamentaryActivity)
    .orderBy(desc(parliamentaryActivity.date));

  const activitiesByOfficial = new Map<string, typeof allActivities>();
  for (const act of allActivities) {
    const list = activitiesByOfficial.get(act.officialId) ?? [];
    if (list.length < 20) list.push(act);
    activitiesByOfficial.set(act.officialId, list);
  }

  const allCommittees = await db
    .select({
      officialId: committees.officialId,
      name: committees.name,
      type: committees.type,
      startDate: committees.startDate,
      endDate: committees.endDate,
      updatedAt: committees.updatedAt,
    })
    .from(committees)
    .orderBy(desc(committees.startDate));

  const committeesByOfficial = new Map<string, typeof allCommittees>();
  for (const c of allCommittees) {
    const list = committeesByOfficial.get(c.officialId) ?? [];
    list.push(c);
    committeesByOfficial.set(c.officialId, list);
  }

  const allElectoralResults = await db
    .select({
      officialId: electoralResults.officialId,
      electionType: electoralResults.electionType,
      electionDate: electoralResults.electionDate,
      round: electoralResults.round,
      scorePercent: electoralResults.scorePercent,
      opponentCount: electoralResults.opponentCount,
      updatedAt: electoralResults.updatedAt,
    })
    .from(electoralResults)
    .orderBy(desc(electoralResults.electionDate));

  const electoralByOfficial = new Map<string, typeof allElectoralResults>();
  for (const er of allElectoralResults) {
    const list = electoralByOfficial.get(er.officialId) ?? [];
    list.push(er);
    electoralByOfficial.set(er.officialId, list);
  }

  const allCampaignAccounts = await db
    .select({
      officialId: campaignAccounts.officialId,
      electionType: campaignAccounts.electionType,
      electionDate: campaignAccounts.electionDate,
      politicalLabel: campaignAccounts.politicalLabel,
      expensesDeclared: campaignAccounts.expensesDeclared,
      expensesRetained: campaignAccounts.expensesRetained,
      revenueDeclared: campaignAccounts.revenueDeclared,
      donationsDeclared: campaignAccounts.donationsDeclared,
      personalContributionDeclared: campaignAccounts.personalContributionDeclared,
      partyContributionsDeclared: campaignAccounts.partyContributionsDeclared,
      reimbursement: campaignAccounts.reimbursement,
      decision: campaignAccounts.decision,
      updatedAt: campaignAccounts.updatedAt,
    })
    .from(campaignAccounts)
    .where(isNotNull(campaignAccounts.officialId))
    .orderBy(desc(campaignAccounts.electionDate));

  const campaignByOfficial = new Map<string, typeof allCampaignAccounts>();
  for (const ca of allCampaignAccounts) {
    if (!ca.officialId) continue;
    const list = campaignByOfficial.get(ca.officialId) ?? [];
    list.push(ca);
    campaignByOfficial.set(ca.officialId, list);
  }

  return rows.map((row) => {
    const allItems: { updatedAt: Date }[] = [
      ...(mandatesByOfficial.get(row.id) ?? []),
      ...(affiliationsByOfficial.get(row.id) ?? []),
      ...(staffersByOfficial.get(row.id) ?? []),
      ...(votesByOfficial.get(row.id) ?? []),
      ...(interestsByOfficial.get(row.id) ?? []),
      ...(pressByOfficial.get(row.id) ?? []),
      ...(activitiesByOfficial.get(row.id) ?? []),
      ...(committeesByOfficial.get(row.id) ?? []),
      ...(electoralByOfficial.get(row.id) ?? []),
      ...(addressesByOfficial.get(row.id) ?? []),
      ...(linksByOfficial.get(row.id) ?? []),
      ...(campaignByOfficial.get(row.id) ?? []),
    ];
    const lastUpdated = allItems.length > 0
      ? allItems.reduce((max, item) => item.updatedAt > max ? item.updatedAt : max, allItems[0].updatedAt)
      : new Date(row.startDate);

    return {
      params: { slug: row.slug ?? row.id },
      props: {
        deputy: row,
        deputyMandates: mandatesByOfficial.get(row.id) ?? [],
        deputyVotes: votesByOfficial.get(row.id) ?? [],
        deputyAffiliations: affiliationsByOfficial.get(row.id) ?? [],
        deputyStaffers: staffersByOfficial.get(row.id) ?? [],
        deputyInterests: interestsByOfficial.get(row.id) ?? [],
        deputySnapshots: snapshotsByOfficial.get(row.id) ?? [],
        deputyPress: pressByOfficial.get(row.id) ?? [],
        deputyAddresses: addressesByOfficial.get(row.id) ?? [],
        deputyLinks: linksByOfficial.get(row.id) ?? [],
        deputyActivities: activitiesByOfficial.get(row.id) ?? [],
        deputyCommittees: committeesByOfficial.get(row.id) ?? [],
        deputyElectoralResults: electoralByOfficial.get(row.id) ?? [],
        deputyCampaignAccounts: campaignByOfficial.get(row.id) ?? [],
        lastUpdated,
      },
    };
  });
}

type Mandate = {
  officialId: string;
  type: string;
  district: string | null;
  department: string | null;
  startDate: string;
  endDate: string | null;
  politicalGroup: string | null;
  updatedAt: Date;
};

type Vote = {
  officialId: string;
  ballotId: string;
  position: string;
  ballotTitle: string;
  ballotDate: string;
  updatedAt: Date;
};

type Affiliation = {
  officialId: string;
  partyOrGroup: string;
  startDate: string;
  endDate: string | null;
  updatedAt: Date;
};

type Staffer = {
  officialId: string;
  firstName: string;
  lastName: string;
  startDate: string;
  endDate: string | null;
  updatedAt: Date;
};

type Interest = {
  officialId: string;
  type: string;
  category: string;
  entityName: string;
  roleDescription: string | null;
  declaredDate: string;
  declarantComment: string | null;
  sourceDocumentUrl: string | null;
  ownershipDetail: string | null;
  annualAmount: string | null;
  amountYear: number | null;
  amountIsNet: boolean | null;
  updatedAt: Date;
};

type DeclarationSnapshot = {
  officialId: string;
  declarationDate: string;
  declarationType: string;
};

type PressMention = {
  officialId: string;
  title: string;
  sourceName: string;
  sourceUrl: string;
  publishedDate: string;
  updatedAt: Date;
};

type Address = {
  officialId: string;
  type: string;
  street: string | null;
  postalCode: string | null;
  city: string | null;
  phone: string | null;
  email: string | null;
  latitude: number | null;
  longitude: number | null;
  mapUrl: string | null;
  updatedAt: Date;
};

type ExternalLink = {
  officialId: string;
  platform: string;
  url: string;
  updatedAt: Date;
};

type Activity = {
  officialId: string;
  type: string;
  title: string;
  date: string;
  status: string | null;
  responseDate: string | null;
  governmentComments: string | null;
  rubrique: string | null;
  updatedAt: Date;
};

type Committee = {
  officialId: string;
  name: string;
  type: string;
  startDate: string;
  endDate: string | null;
  updatedAt: Date;
};

type ElectoralResult = {
  officialId: string;
  electionType: string;
  electionDate: string;
  round: number;
  scorePercent: number;
  opponentCount: number;
  updatedAt: Date;
};

type CampaignAccount = {
  officialId: string | null;
  electionType: string;
  electionDate: string;
  politicalLabel: string | null;
  expensesDeclared: number | null;
  expensesRetained: number | null;
  revenueDeclared: number | null;
  donationsDeclared: number | null;
  personalContributionDeclared: number | null;
  partyContributionsDeclared: number | null;
  reimbursement: number | null;
  decision: string;
  updatedAt: Date;
};

type Props = {
  deputy: {
    id: string;
    slug: string | null;
    firstName: string;
    lastName: string;
    birthDate: string | null;
    photoUrl: string | null;
    anId: string | null;
    senatId: string | null;
    district: string | null;
    department: string | null;
    startDate: string;
    politicalGroup: string | null;
    mandateType: string;
  };
  deputyMandates: Mandate[];
  deputyVotes: Vote[];
  deputyAffiliations: Affiliation[];
  deputyStaffers: Staffer[];
  deputyInterests: Interest[];
  deputySnapshots: DeclarationSnapshot[];
  deputyPress: PressMention[];
  deputyAddresses: Address[];
  deputyLinks: ExternalLink[];
  deputyActivities: Activity[];
  deputyCommittees: Committee[];
  deputyElectoralResults: ElectoralResult[];
  deputyCampaignAccounts: CampaignAccount[];
  lastUpdated: Date;
};

const { deputy, deputyMandates, deputyVotes, deputyAffiliations, deputyStaffers, deputyInterests, deputySnapshots, deputyPress, deputyAddresses, deputyLinks, deputyActivities, deputyCommittees, deputyElectoralResults, deputyCampaignAccounts, lastUpdated } = Astro.props as Props;

const addressTypeLabels: Record<string, string> = {
  constituency_office: 'Permanence',
  assembly_office: 'Bureau AN/Sénat',
  town_hall: 'Mairie',
};

const addressImages: Record<string, { src: string; alt: string; credit: string }> = {
  assembly_office: {
    src: 'https://upload.wikimedia.org/wikipedia/commons/thumb/3/39/Fa%C3%A7ade_Palais_Bourbon_3.jpg/960px-Fa%C3%A7ade_Palais_Bourbon_3.jpg',
    alt: 'Palais Bourbon, siège de l\'Assemblée nationale',
    credit: 'ZeusUpsistos / CC BY-SA 4.0',
  },
  constituency_office: {
    src: 'https://upload.wikimedia.org/wikipedia/commons/thumb/5/50/Circle-icons-gps.svg/960px-Circle-icons-gps.svg.png',
    alt: 'Immeuble de bureaux',
    credit: 'Albrecht Voß / CC BY-SA 4.0',
  },
  town_hall: {
    src: 'https://upload.wikimedia.org/wikipedia/commons/thumb/5/50/Circle-icons-gps.svg/960px-Circle-icons-gps.svg.png',
    alt: 'Mairie',
    credit: 'Albrecht Voß / CC BY-SA 4.0',
  },
};

const platformLabels: Record<string, string> = {
  twitter: 'X (Twitter)',
  facebook: 'Facebook',
  instagram: 'Instagram',
  youtube: 'YouTube',
  tiktok: 'TikTok',
  wikipedia_fr: 'Wikipédia',
  official_page: 'Fiche officielle',
  personal_website: 'Site personnel',
  madada: 'MaDada.fr',
};

const roundLabels: Record<number, string> = {
  1: '1er tour',
  2: '2nd tour',
};

const decisionLabels: Record<string, { label: string; color: string }> = {
  A: { label: 'Approuvé', color: 'bg-emerald-100 text-emerald-800 dark:bg-emerald-900 dark:text-emerald-200' },
  AR: { label: 'Approuvé après réformation', color: 'bg-amber-100 text-amber-800 dark:bg-amber-900 dark:text-amber-200' },
  R: { label: 'Rejeté', color: 'bg-rose-100 text-rose-800 dark:bg-rose-900 dark:text-rose-200' },
  DD: { label: 'Non déposé', color: 'bg-slate-100 text-slate-600 dark:bg-slate-700 dark:text-slate-300' },
};

const electionTypeLabels: Record<string, string> = {
  legislatives_2024: 'Législatives 2024',
  legislatives_2022: 'Législatives 2022',
  senatoriales_2023: 'Sénatoriales 2023',
};

function formatEuros(amount: number | null): string {
  if (amount == null) return '—';
  return amount.toLocaleString('fr-FR') + ' €';
}

const committeeTypeLabels: Record<string, string> = {
  standing_committee: 'Commission permanente',
  special_committee: 'Commission spéciale',
  delegation: 'Délégation',
  study_group: "Groupe d'études",
  friendship_group: "Groupe d'amitié",
};

const activityTypeLabels: Record<string, string> = {
  written_question: 'Question écrite',
  oral_question: 'Question orale',
  amendment: 'Amendement',
  report: 'Rapport',
};

const statusLabels: Record<string, string> = {
  adopted: 'Adopté',
  rejected: 'Rejeté',
  withdrawn: 'Retiré',
};

const statusColors: Record<string, string> = {
  adopted: 'text-green-700 bg-green-50',
  rejected: 'text-red-700 bg-red-50',
  withdrawn: 'text-yellow-700 bg-yellow-50',
};

const interestCategoryLabels: Record<string, string> = {
  professional_activity: 'Activités professionnelles',
  consulting_activity: 'Activités de conseil',
  governing_body_membership: 'Organes dirigeants',
  voluntary_activity: 'Activités bénévoles',
  elected_function: 'Fonctions électives annexes',
  financial_participation: 'Participations financières',
};

const interestCategoryOrder = [
  'professional_activity',
  'consulting_activity',
  'governing_body_membership',
  'voluntary_activity',
  'elected_function',
  'financial_participation',
];

const interestCategoryColors: Record<string, string> = {
  professional_activity: 'text-blue-700 bg-blue-50',
  consulting_activity: 'text-cyan-700 bg-cyan-50',
  governing_body_membership: 'text-purple-700 bg-purple-50',
  voluntary_activity: 'text-teal-700 bg-teal-50',
  elected_function: 'text-amber-700 bg-amber-50',
  financial_participation: 'text-rose-700 bg-rose-50',
};
const mandateTypeLabels: Record<string, string> = {
  depute: 'Député',
  senateur: 'Sénateur',
  maire: 'Maire',
  president: 'Président',
};

type InterestGroup = { category: string; label: string; items: Interest[] };
const interestGroups: InterestGroup[] = interestCategoryOrder
  .map((cat) => ({
    category: cat,
    label: interestCategoryLabels[cat] ?? cat,
    items: deputyInterests.filter((i) => i.type === cat),
  }))
  .filter((g) => g.items.length > 0);

const ungroupedInterests = deputyInterests.filter(
  (i) => !interestCategoryOrder.includes(i.type),
);
if (ungroupedInterests.length > 0) {
  interestGroups.push({
    category: 'other',
    label: 'Autres',
    items: ungroupedInterests,
  });
}

const fullName = `${deputy.firstName} ${deputy.lastName}`;
const mandateLabel = mandateTypeLabels[deputy.mandateType] ?? deputy.mandateType;

const sameAs = deputyLinks
  .map((l) => l.url)
  .filter((u) => u.startsWith('http'));

const worksForName = deputy.mandateType === 'depute'
  ? 'Assemblée nationale'
  : deputy.mandateType === 'senateur'
    ? 'Sénat'
    : deputy.mandateType === 'maire'
      ? deputy.district ?? undefined
      : undefined;

const isMaire = deputy.mandateType === 'maire';
const isParliamentary = deputy.mandateType === 'depute' || deputy.mandateType === 'senateur';

const constituencyAddress = deputyAddresses.find((a) =>
  isMaire ? a.type === 'town_hall' : a.type === 'constituency_office',
);

const metaDescription = [
  `${fullName}, ${mandateLabel}`,
  deputy.district && deputy.department ? `${deputy.district} (${deputy.department})` : null,
  deputy.politicalGroup ? `groupe ${deputy.politicalGroup}` : null,
].filter(Boolean).join(' — ');

const personJsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: fullName,
  givenName: deputy.firstName,
  familyName: deputy.lastName,
  jobTitle: mandateLabel,
  url: `https://elupedia.fr/elus/${deputy.slug ?? deputy.id}`,
  nationality: { '@type': 'Country', name: 'France' },
  ...(deputy.photoUrl && { image: deputy.photoUrl }),
  ...(deputy.birthDate && { birthDate: deputy.birthDate }),
  ...(sameAs.length > 0 && { sameAs }),
  ...(worksForName && {
    worksFor: {
      '@type': 'GovernmentOrganization',
      name: worksForName,
    },
  }),
  ...(deputy.politicalGroup && {
    memberOf: {
      '@type': 'Organization',
      name: deputy.politicalGroup,
    },
  }),
  ...(constituencyAddress?.city && {
    address: {
      '@type': 'PostalAddress',
      ...(constituencyAddress.street && { streetAddress: constituencyAddress.street }),
      addressLocality: constituencyAddress.city,
      ...(constituencyAddress.postalCode && { postalCode: constituencyAddress.postalCode }),
      addressCountry: 'FR',
    },
  }),
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://elupedia.fr/' },
    { '@type': 'ListItem', position: 2, name: 'Élus', item: 'https://elupedia.fr/elus' },
    { '@type': 'ListItem', position: 3, name: fullName, item: `https://elupedia.fr/elus/${deputy.slug ?? deputy.id}` },
  ],
};

const positionLabels: Record<string, string> = {
  for: 'Pour',
  against: 'Contre',
  abstain: 'Abstention',
  absent: 'Absent',
};

const positionColors: Record<string, string> = {
  for: 'text-green-700 bg-green-50',
  against: 'text-red-700 bg-red-50',
  abstain: 'text-yellow-700 bg-yellow-50',
  absent: 'text-slate-500 bg-slate-50',
};

const parliamentSource = deputy.mandateType === 'depute'
  ? { name: 'Assemblée nationale', url: 'https://data.assemblee-nationale.fr' }
  : deputy.mandateType === 'senateur'
    ? { name: 'Sénat', url: 'https://data.senat.fr' }
    : { name: 'RNE', url: 'https://www.data.gouv.fr/fr/datasets/repertoire-national-des-elus-1/' };

const contactSource = deputy.mandateType === 'maire'
  ? { name: 'DILA', url: 'https://api-lannuaire.service-public.fr' }
  : parliamentSource;

function maxUpdatedAt(items: { updatedAt: Date }[]): Date | null {
  if (items.length === 0) return null;
  return items.reduce((max, item) => item.updatedAt > max ? item.updatedAt : max, items[0].updatedAt);
}

const sectionDates = {
  mandates: maxUpdatedAt(deputyMandates),
  affiliations: maxUpdatedAt(deputyAffiliations),
  staffers: maxUpdatedAt(deputyStaffers),
  activities: maxUpdatedAt(deputyActivities),
  committees: maxUpdatedAt(deputyCommittees),
  electoral: maxUpdatedAt(deputyElectoralResults),
  interests: maxUpdatedAt(deputyInterests),
  votes: maxUpdatedAt(deputyVotes),
  press: maxUpdatedAt(deputyPress),
  addresses: maxUpdatedAt(deputyAddresses),
  links: maxUpdatedAt(deputyLinks),
  campaigns: maxUpdatedAt(deputyCampaignAccounts),
};

function fmtRetrieval(date: Date | null): string {
  if (!date) return '';
  return ` — dernière récupération le ${date.toLocaleDateString('fr-FR')}`;
}

---

<BaseLayout title={fullName} description={metaDescription} image={deputy.photoUrl ?? undefined} jsonLd={personJsonLd} ogType="profile">
  <Fragment slot="head">
    {deputy.photoUrl && <link rel="preload" as="image" href={deputy.photoUrl} fetchpriority="high" />}
    <meta property="profile:first_name" content={deputy.firstName} />
    <meta property="profile:last_name" content={deputy.lastName} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  </Fragment>
  <div class="max-w-3xl">
    <a href="/elus" class="inline-flex items-center gap-1 text-sm font-medium text-slate-500 hover:text-indigo-600 transition-colors no-underline dark:text-slate-400 dark:hover:text-indigo-400">
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" /></svg>
      Retour à l'annuaire
    </a>

    <div class="mt-6 grid grid-cols-1 md:grid-cols-[auto_1fr_auto] gap-6 items-center rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-900/5 dark:bg-slate-800 dark:ring-slate-700">
      {deputy.photoUrl ? (
        <img
          src={deputy.photoUrl}
          alt={fullName}
          class="h-28 w-28 shrink-0 rounded-2xl object-cover ring-2 ring-offset-2 ring-indigo-400 shadow-lg dark:ring-offset-slate-800"
          fetchpriority="high"
          decoding="async"
          width="112"
          height="112"
        />
      ) : (
        <div class="flex h-28 w-28 shrink-0 items-center justify-center rounded-2xl bg-indigo-50 text-3xl font-semibold text-indigo-600 ring-2 ring-offset-2 ring-indigo-400 shadow-lg dark:bg-indigo-900/30 dark:text-indigo-400 dark:ring-offset-slate-800">
          {deputy.firstName[0]}{deputy.lastName[0]}
        </div>
      )}

      <div>
        <h1 class="text-2xl font-bold tracking-tight dark:text-white">{fullName}</h1>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
          {mandateLabel}
          {deputy.district && deputy.department && ` — ${deputy.district} (${deputy.department})`}
        </p>
        {deputy.politicalGroup && (
          <span class="mt-2 inline-block rounded-full bg-indigo-50 border border-indigo-200/50 px-3 py-0.5 text-xs font-medium text-indigo-700 dark:bg-indigo-900/20 dark:border-indigo-500/30 dark:text-indigo-300">
            {deputy.politicalGroup}
          </span>
        )}
        {deputy.birthDate && (
          <p class="mt-2 text-xs text-slate-500 dark:text-slate-400">
            Né{deputy.firstName.endsWith('e') ? 'e' : ''} le {new Date(deputy.birthDate).toLocaleDateString('fr-FR')} ({differenceInYears(new Date(), new Date(deputy.birthDate))} ans)
          </p>
        )}
      </div>

      <div class="flex flex-wrap gap-2 md:flex-col">
        {deputy.mandateType === 'depute' && deputy.anId && (
          <a
            href={`https://www.assemblee-nationale.fr/dyn/deputes/${deputy.anId}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-medium text-slate-600 hover:border-indigo-300 hover:text-indigo-600 transition-colors no-underline dark:border-slate-600 dark:bg-slate-700 dark:text-slate-300 dark:hover:border-indigo-500 dark:hover:text-indigo-400"
          >
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" /></svg>
            Assemblée nationale
          </a>
        )}
        {deputy.mandateType === 'senateur' && deputy.photoUrl && (
          <a
            href={`https://www.senat.fr/senateur/${deputy.photoUrl.match(/senimg\/(.+)_carre\.jpg/)?.[1] ?? ''}.html`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-medium text-slate-600 hover:border-indigo-300 hover:text-indigo-600 transition-colors no-underline dark:border-slate-600 dark:bg-slate-700 dark:text-slate-300 dark:hover:border-indigo-500 dark:hover:text-indigo-400"
          >
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" /></svg>
            Sénat
          </a>
        )}
      </div>
    </div>

    <p class="mt-4 text-xs text-slate-500 dark:text-slate-400">
      Dernière mise à jour le {lastUpdated.toLocaleDateString('fr-FR')}
    </p>

    <nav id="toc-inline" class="mt-6 rounded-xl bg-white p-4 shadow-sm ring-1 ring-slate-900/5 dark:bg-slate-800 dark:ring-slate-700" aria-label="Sommaire">
      <p class="text-xs font-semibold uppercase tracking-wide text-slate-400 mb-2">Sommaire</p>
      <ul class="columns-2 gap-x-6 text-sm space-y-1">
        <li><a href="#mandat" class="text-slate-600 hover:text-indigo-600 transition-colors no-underline dark:text-slate-400 dark:hover:text-indigo-400">Mandat en cours</a></li>
        <li><a href="#tous-mandats" class="text-slate-600 hover:text-indigo-600 transition-colors no-underline dark:text-slate-400 dark:hover:text-indigo-400">Tous les mandats</a></li>
        <li><a href="#coordonnees" class="text-slate-600 hover:text-indigo-600 transition-colors no-underline dark:text-slate-400 dark:hover:text-indigo-400">Coordonnées</a></li>
        {isParliamentary && <li><a href="#affiliations" class="text-slate-600 hover:text-indigo-600 transition-colors no-underline dark:text-slate-400 dark:hover:text-indigo-400">Affiliations politiques</a></li>}
        {isParliamentary && <li><a href="#collaborateurs" class="text-slate-600 hover:text-indigo-600 transition-colors no-underline dark:text-slate-400 dark:hover:text-indigo-400">Collaborateurs</a></li>}
        {isParliamentary && <li><a href="#activite" class="text-slate-600 hover:text-indigo-600 transition-colors no-underline dark:text-slate-400 dark:hover:text-indigo-400">Activité parlementaire</a></li>}
        {isParliamentary && <li><a href="#commissions" class="text-slate-600 hover:text-indigo-600 transition-colors no-underline dark:text-slate-400 dark:hover:text-indigo-400">Commissions & groupes</a></li>}
        {isParliamentary && <li><a href="#electoral" class="text-slate-600 hover:text-indigo-600 transition-colors no-underline dark:text-slate-400 dark:hover:text-indigo-400">Historique électoral</a></li>}
        {deputyCampaignAccounts.length > 0 && <li><a href="#financement" class="text-slate-600 hover:text-indigo-600 transition-colors no-underline dark:text-slate-400 dark:hover:text-indigo-400">Financement</a></li>}
        <li><a href="#interets" class="text-slate-600 hover:text-indigo-600 transition-colors no-underline dark:text-slate-400 dark:hover:text-indigo-400">Intérêts déclarés</a></li>
        {isParliamentary && <li><a href="#votes" class="text-slate-600 hover:text-indigo-600 transition-colors no-underline dark:text-slate-400 dark:hover:text-indigo-400">Historique des votes</a></li>}
        <li><a href="#presse" class="text-slate-600 hover:text-indigo-600 transition-colors no-underline dark:text-slate-400 dark:hover:text-indigo-400">Dans la presse</a></li>
        <li><a href="#liens" class="text-slate-600 hover:text-indigo-600 transition-colors no-underline dark:text-slate-400 dark:hover:text-indigo-400">Liens extérieurs</a></li>
      </ul>
    </nav>

    {isParliamentary && deputyVotes.length > 0 && (() => {
      const voteCounts: Record<string, number> = { for: 0, against: 0, abstain: 0, absent: 0 };
      for (const v of deputyVotes) { voteCounts[v.position] = (voteCounts[v.position] ?? 0) + 1; }
      const total = deputyVotes.length;
      return (
        <div class="mt-6 rounded-xl bg-white p-4 shadow-sm ring-1 ring-slate-900/5 dark:bg-slate-800 dark:ring-slate-700">
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-400 mb-3">Répartition des votes</p>
          <div class="h-3 flex rounded-full overflow-hidden bg-slate-100 dark:bg-slate-700">
            {voteCounts.for > 0 && <div class="bg-emerald-500" style={`width:${(voteCounts.for / total) * 100}%`}></div>}
            {voteCounts.against > 0 && <div class="bg-rose-500" style={`width:${(voteCounts.against / total) * 100}%`}></div>}
            {voteCounts.abstain > 0 && <div class="bg-amber-500" style={`width:${(voteCounts.abstain / total) * 100}%`}></div>}
            {voteCounts.absent > 0 && <div class="bg-slate-300 dark:bg-slate-600" style={`width:${(voteCounts.absent / total) * 100}%`}></div>}
          </div>
          <div class="mt-2 flex flex-wrap gap-4 text-xs text-slate-600 dark:text-slate-400">
            <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-emerald-500"></span> Pour {voteCounts.for} ({(voteCounts.for / total * 100).toFixed(1)}%)</span>
            <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-rose-500"></span> Contre {voteCounts.against} ({(voteCounts.against / total * 100).toFixed(1)}%)</span>
            <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-amber-500"></span> Abstention {voteCounts.abstain} ({(voteCounts.abstain / total * 100).toFixed(1)}%)</span>
            {voteCounts.absent > 0 && <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-slate-300 dark:bg-slate-600"></span> Absent {voteCounts.absent} ({(voteCounts.absent / total * 100).toFixed(1)}%)</span>}
          </div>
        </div>
      );
    })()}

    <nav id="toc-sticky" class="fixed top-0 left-0 right-0 z-40 -translate-y-full bg-white/95 backdrop-blur-md shadow-md border-b border-slate-200 transition-transform duration-300 dark:bg-slate-900/95 dark:border-slate-700" aria-label="Sommaire" aria-hidden="true">
      <div class="mx-auto max-w-6xl px-4 py-2 overflow-x-auto">
        <ul class="flex items-center gap-4 text-xs font-medium whitespace-nowrap">
          <li><a href="#mandat" class="text-slate-500 hover:text-indigo-600 transition-colors no-underline dark:text-slate-400 dark:hover:text-indigo-400">Mandat</a></li>
          <li><a href="#tous-mandats" class="text-slate-500 hover:text-indigo-600 transition-colors no-underline dark:text-slate-400 dark:hover:text-indigo-400">Mandats</a></li>
          <li><a href="#coordonnees" class="text-slate-500 hover:text-indigo-600 transition-colors no-underline dark:text-slate-400 dark:hover:text-indigo-400">Coordonnées</a></li>
          {isParliamentary && <li><a href="#affiliations" class="text-slate-500 hover:text-indigo-600 transition-colors no-underline dark:text-slate-400 dark:hover:text-indigo-400">Affiliations</a></li>}
          {isParliamentary && <li><a href="#collaborateurs" class="text-slate-500 hover:text-indigo-600 transition-colors no-underline dark:text-slate-400 dark:hover:text-indigo-400">Collaborateurs</a></li>}
          {isParliamentary && <li><a href="#activite" class="text-slate-500 hover:text-indigo-600 transition-colors no-underline dark:text-slate-400 dark:hover:text-indigo-400">Activité</a></li>}
          {isParliamentary && <li><a href="#commissions" class="text-slate-500 hover:text-indigo-600 transition-colors no-underline dark:text-slate-400 dark:hover:text-indigo-400">Commissions</a></li>}
          {isParliamentary && <li><a href="#electoral" class="text-slate-500 hover:text-indigo-600 transition-colors no-underline dark:text-slate-400 dark:hover:text-indigo-400">Électoral</a></li>}
          {deputyCampaignAccounts.length > 0 && <li><a href="#financement" class="text-slate-500 hover:text-indigo-600 transition-colors no-underline dark:text-slate-400 dark:hover:text-indigo-400">Financement</a></li>}
          <li><a href="#interets" class="text-slate-500 hover:text-indigo-600 transition-colors no-underline dark:text-slate-400 dark:hover:text-indigo-400">Intérêts</a></li>
          {isParliamentary && <li><a href="#votes" class="text-slate-500 hover:text-indigo-600 transition-colors no-underline dark:text-slate-400 dark:hover:text-indigo-400">Votes</a></li>}
          <li><a href="#presse" class="text-slate-500 hover:text-indigo-600 transition-colors no-underline dark:text-slate-400 dark:hover:text-indigo-400">Presse</a></li>
          <li><a href="#liens" class="text-slate-500 hover:text-indigo-600 transition-colors no-underline dark:text-slate-400 dark:hover:text-indigo-400">Liens</a></li>
        </ul>
      </div>
    </nav>

    <section id="mandat" class="mt-8 scroll-mt-12">
      <h2 class="text-lg font-semibold border-l-4 border-indigo-500 pl-3 dark:text-white">
        Mandat en cours
      </h2>
      <dl class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
          <dt class="text-sm text-slate-500 dark:text-slate-400">Type</dt>
          <dd class="font-medium dark:text-white">{mandateLabel}</dd>
        </div>
        {deputy.district && (
          <div>
            <dt class="text-sm text-slate-500 dark:text-slate-400">Circonscription</dt>
            <dd class="font-medium dark:text-white">{deputy.district}</dd>
          </div>
        )}
        {deputy.department && (
          <div>
            <dt class="text-sm text-slate-500 dark:text-slate-400">Département</dt>
            <dd class="font-medium dark:text-white">{deputy.department}</dd>
          </div>
        )}
        {deputy.politicalGroup && (
          <div>
            <dt class="text-sm text-slate-500 dark:text-slate-400">Groupe politique</dt>
            <dd class="font-medium dark:text-white">{deputy.politicalGroup}</dd>
          </div>
        )}
        <div>
          <dt class="text-sm text-slate-500 dark:text-slate-400">Début de mandat</dt>
          <dd class="font-medium dark:text-white">{new Date(deputy.startDate).toLocaleDateString('fr-FR')}</dd>
        </div>
      </dl>
      <p class="mt-3 text-xs text-slate-400">Source : <a href={parliamentSource.url} target="_blank" rel="noopener noreferrer" class="underline hover:text-slate-600">{parliamentSource.name}</a>{fmtRetrieval(sectionDates.mandates)}</p>
    </section>

    <section id="tous-mandats" class="mt-8 scroll-mt-12">
      <h2 class="text-lg font-semibold border-l-4 border-indigo-500 pl-3 dark:text-white">Tous les mandats</h2>
      {deputyMandates.length === 0 ? (
        <p class="mt-4 text-slate-500 dark:text-slate-400">Aucun mandat enregistré.</p>
      ) : (
        <div class="mt-4 border-l-2 border-slate-200 ml-3 pl-4 space-y-6 dark:border-slate-700">
          {deputyMandates.map((m) => (
            <div class="relative">
              <div class={`absolute -left-[calc(1rem+5px)] top-1 h-2.5 w-2.5 rounded-full ${m.endDate ? 'bg-slate-300 dark:bg-slate-600' : 'bg-indigo-500'}`}></div>
              <div class="flex items-center gap-2">
                <span class="font-medium text-sm dark:text-white">{mandateTypeLabels[m.type] ?? m.type}</span>
                {!m.endDate && (
                  <span class="rounded-full bg-green-50 px-2 py-0.5 text-[10px] font-semibold text-green-700 dark:bg-green-900/20 dark:text-green-400">En cours</span>
                )}
              </div>
              <p class="mt-0.5 text-sm text-slate-600 dark:text-slate-400">
                {m.district && `${m.district} — `}{m.department ?? ''}
                {m.politicalGroup && ` · ${m.politicalGroup}`}
              </p>
              <p class="mt-0.5 text-xs text-slate-400 dark:text-slate-500">
                {new Date(m.startDate).toLocaleDateString('fr-FR')}
                {' → '}
                {m.endDate ? new Date(m.endDate).toLocaleDateString('fr-FR') : "aujourd'hui"}
              </p>
            </div>
          ))}
        </div>
      )}
      <p class="mt-3 text-xs text-slate-400">Source : <a href={parliamentSource.url} target="_blank" rel="noopener noreferrer" class="underline hover:text-slate-600">{parliamentSource.name}</a>{fmtRetrieval(sectionDates.mandates)}</p>
    </section>

    <section id="coordonnees" class="mt-8 scroll-mt-12">
      <h2 class="text-lg font-semibold border-l-4 border-indigo-500 pl-3 dark:text-white">
        Coordonnées
      </h2>

      {deputyAddresses.length === 0 ? (
        <p class="mt-4 text-slate-500">Aucune adresse enregistrée/trouvée.</p>
      ) : (
        <div class="mt-4 grid grid-cols-1 gap-6 sm:grid-cols-2">
          {deputyAddresses.map((addr) => {
            const fallbackImg = addressImages[addr.type];
            const hasMap = !!addr.mapUrl && addr.type !== 'assembly_office';
            const imgSrc = hasMap ? addr.mapUrl! : fallbackImg?.src;
            const imgAlt = hasMap
              ? `Carte OpenStreetMap — ${[addr.street, addr.city].filter(Boolean).join(', ')}`
              : fallbackImg?.alt;
            const addressParts = [addr.street, addr.postalCode, addr.city].filter(Boolean);
            const mapsQuery = addressParts.length > 0 ? encodeURIComponent(addressParts.join(' ')) : null;
            const osmUrl = addr.latitude != null && addr.longitude != null
              ? `https://www.openstreetmap.org/?mlat=${addr.latitude}&mlon=${addr.longitude}#map=15/${addr.latitude}/${addr.longitude}`
              : null;
            return (
              <div class="group rounded-2xl bg-white shadow-sm ring-1 ring-slate-900/5 overflow-hidden transition-shadow hover:shadow-md dark:bg-slate-800 dark:ring-slate-700">
                {imgSrc && (
                  <div class="relative h-40 overflow-hidden">
                    <img
                      src={imgSrc}
                      alt={imgAlt}
                      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                      loading="lazy"
                    />
                    <span class="absolute top-3 left-3 rounded-full bg-white/90 px-3 py-1 text-xs font-semibold text-slate-700 shadow-sm backdrop-blur-sm">
                      {addressTypeLabels[addr.type] ?? addr.type}
                    </span>
                    {(osmUrl || mapsQuery) && (
                      <a
                        href={osmUrl ?? `https://www.openstreetmap.org/search?query=${mapsQuery}`}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="absolute top-3 right-3 flex h-8 w-8 items-center justify-center rounded-full bg-white/90 text-slate-600 shadow-sm backdrop-blur-sm transition-colors hover:bg-indigo-600 hover:text-white"
                        title="Voir sur OpenStreetMap"
                      >
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                          <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
                        </svg>
                      </a>
                    )}
                    <span class="absolute bottom-1 right-2 text-[9px] text-white/70">
                      {hasMap ? '© OpenStreetMap' : fallbackImg?.credit}
                    </span>
                  </div>
                )}
                <div class="p-4">
                  {!imgSrc && (
                    <p class="text-sm font-semibold text-slate-700">
                      {addressTypeLabels[addr.type] ?? addr.type}
                    </p>
                  )}
                  {addressParts.length > 0 && (
                    <p class={`text-sm text-slate-600 ${imgSrc ? '' : 'mt-2'}`}>
                      {addr.street && <span>{addr.street}<br /></span>}
                      {addr.postalCode && <span>{addr.postalCode} </span>}
                      {addr.city}
                    </p>
                  )}
                  {(addr.phone || addr.email) && (
                    <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 border-t border-slate-100 pt-3">
                      {addr.phone && (
                        <a href={`tel:${addr.phone}`} class="inline-flex items-center gap-1.5 text-sm text-slate-600 hover:text-indigo-600 transition-colors">
                          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor">
                            <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z" />

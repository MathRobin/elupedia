            const img = addressImages[addr.type];
            const addressParts = [addr.street, addr.postalCode, addr.city].filter(Boolean);
            const mapsQuery = addressParts.length > 0 ? encodeURIComponent(addressParts.join(' ')) : null;
            return (
              <div class="group rounded-2xl bg-white shadow-sm ring-1 ring-slate-900/5 overflow-hidden transition-shadow hover:shadow-md">

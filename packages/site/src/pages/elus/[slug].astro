---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDb } from '../../lib/db.js';
import { officials, mandates, votes, ballots, affiliations, staffers, interests, pressMentions, addresses, externalLinks, parliamentaryActivity, committees, electoralResults } from '@elupedia/shared';
import { eq, isNull, desc, and, lt, gt, isNotNull } from 'drizzle-orm';
import { differenceInYears } from 'date-fns';

export async function getStaticPaths() {
  const db = getDb();

  const rows = await db
    .select({
      id: officials.id,
      firstName: officials.firstName,
      lastName: officials.lastName,
      birthDate: officials.birthDate,
      photoUrl: officials.photoUrl,
      district: mandates.district,
      department: mandates.department,
      startDate: mandates.startDate,
      politicalGroup: mandates.politicalGroup,
      mandateType: mandates.type,
    })
    .from(officials)
    .innerJoin(mandates, eq(mandates.officialId, officials.id))
    .where(isNull(mandates.endDate));

  const allVotes = await db
    .select({
      officialId: votes.officialId,
      position: votes.position,
      ballotTitle: ballots.title,
      ballotDate: ballots.date,
    })
    .from(votes)
    .innerJoin(ballots, eq(ballots.id, votes.ballotId))
    .orderBy(desc(ballots.date));

  const votesByOfficial = new Map<string, typeof allVotes>();
  for (const v of allVotes) {
    const list = votesByOfficial.get(v.officialId) ?? [];
    list.push(v);
    votesByOfficial.set(v.officialId, list);
  }

  const allAffiliations = await db
    .select({
      officialId: affiliations.officialId,
      partyOrGroup: affiliations.partyOrGroup,
      startDate: affiliations.startDate,
      endDate: affiliations.endDate,
    })
    .from(affiliations)
    .orderBy(desc(affiliations.startDate));

  const affiliationsByOfficial = new Map<string, typeof allAffiliations>();
  for (const a of allAffiliations) {
    const list = affiliationsByOfficial.get(a.officialId) ?? [];
    list.push(a);
    affiliationsByOfficial.set(a.officialId, list);
  }

  const allStaffers = await db
    .select({
      officialId: staffers.officialId,
      firstName: staffers.firstName,
      lastName: staffers.lastName,
      startDate: staffers.startDate,
      endDate: staffers.endDate,
    })
    .from(staffers)
    .orderBy(desc(staffers.startDate));

  const staffersByOfficial = new Map<string, typeof allStaffers>();
  for (const s of allStaffers) {
    const list = staffersByOfficial.get(s.officialId) ?? [];
    list.push(s);
    staffersByOfficial.set(s.officialId, list);
  }

  const allInterests = await db
    .select({
      officialId: interests.officialId,
      type: interests.type,
      entityName: interests.entityName,
      roleDescription: interests.roleDescription,
      declaredDate: interests.declaredDate,
    })
    .from(interests)
    .orderBy(desc(interests.declaredDate));

  const interestsByOfficial = new Map<string, typeof allInterests>();
  for (const i of allInterests) {
    const list = interestsByOfficial.get(i.officialId) ?? [];
    list.push(i);
    interestsByOfficial.set(i.officialId, list);
  }

  const allPress = await db
    .select({
      officialId: pressMentions.officialId,
      title: pressMentions.title,
      sourceName: pressMentions.sourceName,
      sourceUrl: pressMentions.sourceUrl,
      publishedDate: pressMentions.publishedDate,
      summary: pressMentions.summary,
    })
    .from(pressMentions)
    .orderBy(desc(pressMentions.publishedDate));

  const pressByOfficial = new Map<string, typeof allPress>();
  for (const p of allPress) {
    const list = pressByOfficial.get(p.officialId) ?? [];
    list.push(p);
    pressByOfficial.set(p.officialId, list);
  }

  const allAddresses = await db
    .select({
      officialId: addresses.officialId,
      type: addresses.type,
      street: addresses.street,
      postalCode: addresses.postalCode,
      city: addresses.city,
      phone: addresses.phone,
      email: addresses.email,
    })
    .from(addresses);

  const addressesByOfficial = new Map<string, typeof allAddresses>();
  for (const addr of allAddresses) {
    const list = addressesByOfficial.get(addr.officialId) ?? [];
    list.push(addr);
    addressesByOfficial.set(addr.officialId, list);
  }

  const allLinks = await db
    .select({
      officialId: externalLinks.officialId,
      platform: externalLinks.platform,
      url: externalLinks.url,
      source: externalLinks.source,
    })
    .from(externalLinks)
    .where(eq(externalLinks.status, 'published'));

  const linksByOfficial = new Map<string, typeof allLinks>();
  for (const l of allLinks) {
    const list = linksByOfficial.get(l.officialId) ?? [];
    list.push(l);
    linksByOfficial.set(l.officialId, list);
  }

  const allActivities = await db
    .select({
      officialId: parliamentaryActivity.officialId,
      type: parliamentaryActivity.type,
      title: parliamentaryActivity.title,
      date: parliamentaryActivity.date,
      status: parliamentaryActivity.status,
    })
    .from(parliamentaryActivity)
    .orderBy(desc(parliamentaryActivity.date));

  const activitiesByOfficial = new Map<string, typeof allActivities>();
  for (const act of allActivities) {
    const list = activitiesByOfficial.get(act.officialId) ?? [];
    list.push(act);
    activitiesByOfficial.set(act.officialId, list);
  }

  const allCommittees = await db
    .select({
      officialId: committees.officialId,
      name: committees.name,
      type: committees.type,
      startDate: committees.startDate,
      endDate: committees.endDate,
    })
    .from(committees)
    .orderBy(desc(committees.startDate));

  const committeesByOfficial = new Map<string, typeof allCommittees>();
  for (const c of allCommittees) {
    const list = committeesByOfficial.get(c.officialId) ?? [];
    list.push(c);
    committeesByOfficial.set(c.officialId, list);
  }

  const allElectoralResults = await db
    .select({
      officialId: electoralResults.officialId,
      electionType: electoralResults.electionType,
      electionDate: electoralResults.electionDate,
      round: electoralResults.round,
      scorePercent: electoralResults.scorePercent,
      opponentCount: electoralResults.opponentCount,
    })
    .from(electoralResults)
    .orderBy(desc(electoralResults.electionDate));

  const electoralByOfficial = new Map<string, typeof allElectoralResults>();
  for (const er of allElectoralResults) {
    const list = electoralByOfficial.get(er.officialId) ?? [];
    list.push(er);
    electoralByOfficial.set(er.officialId, list);
  }

  return rows.map((row) => {
    const dates: string[] = [row.startDate];
    for (const a of affiliationsByOfficial.get(row.id) ?? []) {
      dates.push(a.startDate);
      if (a.endDate) dates.push(a.endDate);
    }
    for (const s of staffersByOfficial.get(row.id) ?? []) {
      dates.push(s.startDate);
      if (s.endDate) dates.push(s.endDate);
    }
    for (const v of votesByOfficial.get(row.id) ?? []) {
      dates.push(v.ballotDate);
    }
    for (const i of interestsByOfficial.get(row.id) ?? []) {
      dates.push(i.declaredDate);
    }
    for (const p of pressByOfficial.get(row.id) ?? []) {
      dates.push(p.publishedDate);
    }
    for (const act of activitiesByOfficial.get(row.id) ?? []) {
      dates.push(act.date);
    }
    for (const c of committeesByOfficial.get(row.id) ?? []) {
      dates.push(c.startDate);
      if (c.endDate) dates.push(c.endDate);
    }
    for (const er of electoralByOfficial.get(row.id) ?? []) {
      dates.push(er.electionDate);
    }
    dates.sort((a, b) => b.localeCompare(a));
    const lastUpdated = dates[0] ?? row.startDate;

    return {
      params: { slug: row.id },
      props: {
        deputy: row,
        deputyVotes: votesByOfficial.get(row.id) ?? [],
        deputyAffiliations: affiliationsByOfficial.get(row.id) ?? [],
        deputyStaffers: staffersByOfficial.get(row.id) ?? [],
        deputyInterests: interestsByOfficial.get(row.id) ?? [],
        deputyPress: pressByOfficial.get(row.id) ?? [],
        deputyAddresses: addressesByOfficial.get(row.id) ?? [],
        deputyLinks: linksByOfficial.get(row.id) ?? [],
        deputyActivities: activitiesByOfficial.get(row.id) ?? [],
        deputyCommittees: committeesByOfficial.get(row.id) ?? [],
        deputyElectoralResults: electoralByOfficial.get(row.id) ?? [],
        lastUpdated,
      },
    };
  });
}

type Vote = {
  officialId: string;
  position: string;
  ballotTitle: string;
  ballotDate: string;
};

type Affiliation = {
  officialId: string;
  partyOrGroup: string;
  startDate: string;
  endDate: string | null;
};

type Staffer = {
  officialId: string;
  firstName: string;
  lastName: string;
  startDate: string;
  endDate: string | null;
};

type Interest = {
  officialId: string;
  type: string;
  entityName: string;
  roleDescription: string | null;
  declaredDate: string;
};

type PressMention = {
  officialId: string;
  title: string;
  sourceName: string;
  sourceUrl: string;
  publishedDate: string;
  summary: string | null;
};

type Address = {
  officialId: string;
  type: string;
  street: string | null;
  postalCode: string | null;
  city: string | null;
  phone: string | null;
  email: string | null;
};

type ExternalLink = {
  officialId: string;
  platform: string;
  url: string;
};

type Activity = {
  officialId: string;
  type: string;
  title: string;
  date: string;
  status: string | null;
};

type Committee = {
  officialId: string;
  name: string;
  type: string;
  startDate: string;
  endDate: string | null;
};

type ElectoralResult = {
  officialId: string;
  electionType: string;
  electionDate: string;
  round: number;
  scorePercent: number;
  opponentCount: number;
};

type Props = {
  deputy: {
    id: string;
    firstName: string;
    lastName: string;
    birthDate: string | null;
    photoUrl: string | null;
    district: string | null;
    department: string | null;
    startDate: string;
    politicalGroup: string | null;
    mandateType: string;
  };
  deputyVotes: Vote[];
  deputyAffiliations: Affiliation[];
  deputyStaffers: Staffer[];
  deputyInterests: Interest[];
  deputyPress: PressMention[];
  deputyAddresses: Address[];
  deputyLinks: ExternalLink[];
  deputyActivities: Activity[];
  deputyCommittees: Committee[];
  deputyElectoralResults: ElectoralResult[];
  lastUpdated: string;
};

const { deputy, deputyVotes, deputyAffiliations, deputyStaffers, deputyInterests, deputyPress, deputyAddresses, deputyLinks, deputyActivities, deputyCommittees, deputyElectoralResults, lastUpdated } = Astro.props as Props;

const addressTypeLabels: Record<string, string> = {
  constituency_office: 'Permanence',
  assembly_office: 'Bureau AN/Sénat',
};

const platformLabels: Record<string, string> = {
  twitter: 'X (Twitter)',
  facebook: 'Facebook',
  instagram: 'Instagram',
  youtube: 'YouTube',
  tiktok: 'TikTok',
  wikipedia_fr: 'Wikipédia',
  official_page: 'Fiche officielle',
  personal_website: 'Site personnel',
  madada: 'MaDada.fr',
};

const roundLabels: Record<number, string> = {
  1: '1er tour',
  2: '2nd tour',
};

const committeeTypeLabels: Record<string, string> = {
  standing_committee: 'Commission permanente',
  special_committee: 'Commission spéciale',
  delegation: 'Délégation',
  study_group: "Groupe d'études",
  friendship_group: "Groupe d'amitié",
};

const activityTypeLabels: Record<string, string> = {
  written_question: 'Question écrite',
  oral_question: 'Question orale',
  amendment: 'Amendement',
  report: 'Rapport',
};

const statusLabels: Record<string, string> = {
  adopted: 'Adopté',
  rejected: 'Rejeté',
  withdrawn: 'Retiré',
};

const statusColors: Record<string, string> = {
  adopted: 'text-green-700 bg-green-50',
  rejected: 'text-red-700 bg-red-50',
  withdrawn: 'text-yellow-700 bg-yellow-50',
};

const interestTypeLabels: Record<string, string> = {
  company_share: 'Participation en entreprise',
  nonprofit_role: 'Fonction associative/bénévole',
};
const fullName = `${deputy.firstName} ${deputy.lastName}`;

const positionLabels: Record<string, string> = {
  for: 'Pour',
  against: 'Contre',
  abstain: 'Abstention',
  absent: 'Absent',
};

const positionColors: Record<string, string> = {
  for: 'text-green-700 bg-green-50',
  against: 'text-red-700 bg-red-50',
  abstain: 'text-yellow-700 bg-yellow-50',
  absent: 'text-slate-500 bg-slate-50',
};

type TimelineEvent = { date: string; category: string; label: string };

const timelineEvents: TimelineEvent[] = [];

for (const a of deputyAffiliations) {
  timelineEvents.push({ date: a.startDate, category: 'Affiliation', label: `Rejoint ${a.partyOrGroup}` });
  if (a.endDate) {
    timelineEvents.push({ date: a.endDate, category: 'Affiliation', label: `Quitte ${a.partyOrGroup}` });
  }
}

for (const s of deputyStaffers) {
  timelineEvents.push({ date: s.startDate, category: 'Collaborateur', label: `Arrivée de ${s.firstName} ${s.lastName}` });
  if (s.endDate) {
    timelineEvents.push({ date: s.endDate, category: 'Collaborateur', label: `Départ de ${s.firstName} ${s.lastName}` });
  }
}

for (const v of deputyVotes) {
  timelineEvents.push({ date: v.ballotDate, category: 'Vote', label: `${positionLabels[v.position] ?? v.position} — ${v.ballotTitle}` });
}

for (const p of deputyPress) {
  timelineEvents.push({ date: p.publishedDate, category: 'Presse', label: p.title });
}

timelineEvents.sort((a, b) => b.date.localeCompare(a.date));

const timelineCategoryColors: Record<string, string> = {
  Affiliation: 'text-purple-700 bg-purple-50',
  Collaborateur: 'text-teal-700 bg-teal-50',
  Vote: 'text-indigo-600 bg-indigo-50',
  Presse: 'text-orange-700 bg-orange-50',
};
---

<BaseLayout title={fullName} description={`Fiche de ${fullName}, ${deputy.mandateType}`}>
  <div class="max-w-3xl" data-pagefind-body>
    <a href="/" class="inline-flex items-center gap-1 text-sm font-medium text-slate-500 hover:text-indigo-600 transition-colors no-underline">
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" /></svg>
      Retour à la liste
    </a>

    <div class="mt-6 flex items-start gap-6">
      {deputy.photoUrl ? (
        <img
          src={deputy.photoUrl}
          alt={fullName}
          class="h-28 w-28 shrink-0 rounded-2xl object-cover ring-4 ring-white shadow-lg"
        />
      ) : (
        <div class="flex h-28 w-28 shrink-0 items-center justify-center rounded-2xl bg-indigo-50 text-3xl font-semibold text-indigo-600 ring-4 ring-white shadow-lg">
          {deputy.firstName[0]}{deputy.lastName[0]}
        </div>
      )}

      <div>
        <h1 class="text-3xl font-extrabold tracking-tight">{fullName}</h1>
        {deputy.birthDate && (
          <p class="mt-1 text-slate-500">
            Né{deputy.firstName.endsWith('e') ? 'e' : ''} le {new Date(deputy.birthDate).toLocaleDateString('fr-FR')} ({differenceInYears(new Date(), new Date(deputy.birthDate))} ans)
          </p>
        )}
      </div>
    </div>

    <p class="mt-4 text-xs text-slate-500">
      Dernière mise à jour le {new Date(lastUpdated).toLocaleDateString('fr-FR')}
    </p>

    <nav class="mt-6 rounded-xl bg-white p-4 shadow-sm ring-1 ring-slate-900/5" aria-label="Sommaire">
      <p class="text-xs font-semibold uppercase tracking-wide text-slate-400 mb-2">Sommaire</p>
      <ul class="columns-2 gap-x-6 text-sm space-y-1">
        <li><a href="#mandat" class="text-slate-600 hover:text-indigo-600 transition-colors no-underline">Mandat en cours</a></li>
        <li><a href="#coordonnees" class="text-slate-600 hover:text-indigo-600 transition-colors no-underline">Coordonnées</a></li>
        <li><a href="#affiliations" class="text-slate-600 hover:text-indigo-600 transition-colors no-underline">Affiliations politiques</a></li>
        <li><a href="#collaborateurs" class="text-slate-600 hover:text-indigo-600 transition-colors no-underline">Collaborateurs</a></li>
        <li><a href="#activite" class="text-slate-600 hover:text-indigo-600 transition-colors no-underline">Activité parlementaire</a></li>
        <li><a href="#commissions" class="text-slate-600 hover:text-indigo-600 transition-colors no-underline">Commissions & groupes</a></li>
        <li><a href="#electoral" class="text-slate-600 hover:text-indigo-600 transition-colors no-underline">Historique électoral</a></li>
        <li><a href="#interets" class="text-slate-600 hover:text-indigo-600 transition-colors no-underline">Intérêts déclarés</a></li>
        <li><a href="#votes" class="text-slate-600 hover:text-indigo-600 transition-colors no-underline">Historique des votes</a></li>
        <li><a href="#presse" class="text-slate-600 hover:text-indigo-600 transition-colors no-underline">Dans la presse</a></li>
        <li><a href="#chronologie" class="text-slate-600 hover:text-indigo-600 transition-colors no-underline">Chronologie</a></li>
        <li><a href="#liens" class="text-slate-600 hover:text-indigo-600 transition-colors no-underline">Liens extérieurs</a></li>
      </ul>
    </nav>

    <section id="mandat" class="mt-8 scroll-mt-4">
      <h2 class="text-lg font-semibold border-l-4 border-indigo-500 pl-3">Mandat en cours</h2>
      <dl class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
          <dt class="text-sm text-slate-500">Type</dt>
          <dd class="font-medium">{deputy.mandateType}</dd>
        </div>
        {deputy.district && (
          <div>
            <dt class="text-sm text-slate-500">Circonscription</dt>
            <dd class="font-medium">{deputy.district}</dd>
          </div>
        )}
        {deputy.department && (
          <div>
            <dt class="text-sm text-slate-500">Département</dt>
            <dd class="font-medium">{deputy.department}</dd>
          </div>
        )}
        {deputy.politicalGroup && (
          <div>
            <dt class="text-sm text-slate-500">Groupe politique</dt>
            <dd class="font-medium">{deputy.politicalGroup}</dd>
          </div>
        )}
        <div>
          <dt class="text-sm text-slate-500">Début de mandat</dt>
          <dd class="font-medium">{new Date(deputy.startDate).toLocaleDateString('fr-FR')}</dd>
        </div>
      </dl>
    </section>

    <section id="coordonnees" class="mt-8 scroll-mt-4">
      <h2 class="text-lg font-semibold border-l-4 border-indigo-500 pl-3">Coordonnées</h2>

      {deputyAddresses.length === 0 ? (
        <p class="mt-4 text-slate-500">Aucune adresse enregistrée/trouvée.</p>
      ) : (
        <div class="mt-4 grid grid-cols-1 gap-6 sm:grid-cols-2">
          {deputyAddresses.map((addr) => (
            <div class="rounded-xl bg-white p-4 shadow-sm ring-1 ring-slate-900/5">
              <p class="text-sm font-semibold text-slate-700">
                {addressTypeLabels[addr.type] ?? addr.type}
              </p>
              {(addr.street || addr.city) && (
                <p class="mt-2 text-sm text-slate-600">
                  {addr.street && <span>{addr.street}<br /></span>}
                  {addr.postalCode && <span>{addr.postalCode} </span>}
                  {addr.city}
                </p>
              )}
              {addr.phone && (
                <p class="mt-2 text-sm">
                  <a href={`tel:${addr.phone}`} class="text-indigo-600 hover:underline">{addr.phone}</a>
                </p>
              )}
              {addr.email && (
                <p class="mt-1 text-sm">
                  <a href={`mailto:${addr.email}`} class="text-indigo-600 hover:underline">{addr.email}</a>
                </p>
              )}
            </div>
          ))}
        </div>
      )}
    </section>

    <section id="affiliations" class="mt-8 scroll-mt-4">
      <h2 class="text-lg font-semibold border-l-4 border-indigo-500 pl-3">
        Affiliations politiques
        {deputyAffiliations.length > 0 && (
          <span class="ml-2 text-sm font-normal text-slate-500">({deputyAffiliations.length})</span>
        )}
      </h2>

      {deputyAffiliations.length === 0 ? (
        <p class="mt-4 text-slate-500">Aucune affiliation enregistrée/trouvée.</p>
      ) : (
        <ul class="mt-4 space-y-3">
          {deputyAffiliations.map((a) => (
            <li class="flex items-baseline justify-between border-b border-slate-100 pb-3">
              <span class="font-medium">{a.partyOrGroup}</span>
              <span class="text-sm text-slate-500">
                {new Date(a.startDate).toLocaleDateString('fr-FR')}
                {' — '}
                {a.endDate ? new Date(a.endDate).toLocaleDateString('fr-FR') : 'en cours'}
              </span>
            </li>
          ))}
        </ul>
      )}
    </section>

    <section id="collaborateurs" class="mt-8 scroll-mt-4">
      <h2 class="text-lg font-semibold border-l-4 border-indigo-500 pl-3">
        Collaborateurs
        {deputyStaffers.length > 0 && (
          <span class="ml-2 text-sm font-normal text-slate-500">({deputyStaffers.length})</span>
        )}
      </h2>

      {deputyStaffers.length === 0 ? (
        <p class="mt-4 text-slate-500">Aucun collaborateur enregistré.</p>
      ) : (
        <ul class="mt-4 space-y-3">
          {deputyStaffers.map((s) => (
            <li class="flex items-baseline justify-between border-b border-slate-100 pb-3">
              <div>
                <span class="font-medium">{s.firstName} {s.lastName}</span>
                {!s.endDate && (
                  <span class="ml-2 inline-block rounded bg-green-50 px-2 py-0.5 text-xs font-medium text-green-700">actif</span>
                )}
                {s.endDate && (
                  <span class="ml-2 inline-block rounded bg-slate-50 px-2 py-0.5 text-xs font-medium text-slate-500">inactif</span>
                )}
              </div>
              <span class="text-sm text-slate-500">
                {new Date(s.startDate).toLocaleDateString('fr-FR')}
                {' — '}
                {s.endDate ? new Date(s.endDate).toLocaleDateString('fr-FR') : "aujourd'hui"}
              </span>
            </li>
          ))}
        </ul>
      )}
    </section>

    <section id="activite" class="mt-8 scroll-mt-4">
      <h2 class="text-lg font-semibold border-l-4 border-indigo-500 pl-3">
        Activité parlementaire
        {deputyActivities.length > 0 && (
          <span class="ml-2 text-sm font-normal text-slate-500">({deputyActivities.length})</span>
        )}
      </h2>

      {deputyActivities.length === 0 ? (
        <p class="mt-4 text-slate-500">Aucune activité parlementaire enregistrée/trouvée.</p>
      ) : (
        <div class="mt-4 space-y-6">
          {(() => {
            const byYear = new Map<number, Map<number, typeof deputyActivities>>();
            for (const act of deputyActivities) {
              const d = new Date(act.date);
              const y = d.getFullYear();
              const m = d.getMonth();
              if (!byYear.has(y)) byYear.set(y, new Map());
              const months = byYear.get(y)!;
              if (!months.has(m)) months.set(m, []);
              months.get(m)!.push(act);
            }
            const monthNames = ['Janvier', 'Février', 'Mars', 'Avril', 'Mai', 'Juin', 'Juillet', 'Août', 'Septembre', 'Octobre', 'Novembre', 'Décembre'];
            return [...byYear.entries()]
              .sort(([a], [b]) => b - a)
              .map(([year, months]) => (
                <div>
                  <h3 class="text-base font-semibold text-slate-800">{year}</h3>
                  <div class="mt-3 space-y-4">
                    {[...months.entries()]
                      .sort(([a], [b]) => b - a)
                      .map(([month, acts]) => (
                        <div>
                          <h4 class="text-sm font-medium text-slate-500 mb-2">{monthNames[month]}</h4>
                          <div class="overflow-x-auto">
                            <table class="w-full text-sm">
                              <thead>
                                <tr class="border-b border-slate-200 text-left text-slate-500">
                                  <th class="pb-2 pr-4 font-medium">Date</th>
                                  <th class="pb-2 pr-4 font-medium">Type</th>
                                  <th class="pb-2 pr-4 font-medium">Intitulé</th>
                                  <th class="pb-2 font-medium">Statut</th>
                                </tr>
                              </thead>
                              <tbody>
                                {acts.map((act) => (
                                  <tr class="border-b border-slate-100">
                                    <td class="py-2 pr-4 whitespace-nowrap">
                                      {new Date(act.date).toLocaleDateString('fr-FR')}
                                    </td>
                                    <td class="py-2 pr-4 whitespace-nowrap">
                                      {activityTypeLabels[act.type] ?? act.type}
                                    </td>
                                    <td class="py-2 pr-4">{act.title}</td>
                                    <td class="py-2">
                                      {act.status ? (
                                        <span class={`inline-block rounded px-2 py-0.5 text-xs font-medium ${statusColors[act.status] ?? ''}`}>
                                          {statusLabels[act.status] ?? act.status}
                                        </span>
                                      ) : (
                                        <span class="text-slate-400">—</span>
                                      )}
                                    </td>
                                  </tr>
                                ))}
                              </tbody>
                            </table>
                          </div>
                        </div>
                    ))}
                  </div>
                </div>
            ));
          })()}
        </div>
      )}
    </section>

    <section id="commissions" class="mt-8 scroll-mt-4">
      <h2 class="text-lg font-semibold border-l-4 border-indigo-500 pl-3">
        Commissions & groupes
        {deputyCommittees.length > 0 && (
          <span class="ml-2 text-sm font-normal text-slate-500">({deputyCommittees.length})</span>
        )}
      </h2>

      {deputyCommittees.length === 0 ? (
        <p class="mt-4 text-slate-500">Aucune commission enregistrée/trouvée.</p>
      ) : (
        <ul class="mt-4 space-y-3">
          {deputyCommittees.map((c) => (
            <li class="flex items-baseline justify-between border-b border-slate-100 pb-3">
              <div>
                <span class="font-medium">{c.name}</span>
                <span class="ml-2 inline-block rounded bg-indigo-50 px-2 py-0.5 text-xs font-medium text-indigo-600">
                  {committeeTypeLabels[c.type] ?? c.type}
                </span>
              </div>
              <span class="text-sm text-slate-500">
                {new Date(c.startDate).toLocaleDateString('fr-FR')}
                {' — '}
                {c.endDate ? new Date(c.endDate).toLocaleDateString('fr-FR') : 'en cours'}
              </span>
            </li>
          ))}
        </ul>
      )}
    </section>

    <section id="electoral" class="mt-8 scroll-mt-4">
      <h2 class="text-lg font-semibold border-l-4 border-indigo-500 pl-3">
        Historique électoral
        {deputyElectoralResults.length > 0 && (
          <span class="ml-2 text-sm font-normal text-slate-500">({deputyElectoralResults.length})</span>
        )}
      </h2>

      {deputyElectoralResults.length === 0 ? (
        <p class="mt-4 text-slate-500">Aucun résultat électoral enregistré.</p>
      ) : (
        <div class="mt-4 overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-slate-200 text-left text-slate-500">
                <th class="pb-2 pr-4 font-medium">Date</th>
                <th class="pb-2 pr-4 font-medium">Élection</th>
                <th class="pb-2 pr-4 font-medium">Tour</th>
                <th class="pb-2 pr-4 font-medium">Score</th>
                <th class="pb-2 font-medium">Candidats</th>
              </tr>
            </thead>
            <tbody>
              {deputyElectoralResults.map((er) => (
                <tr class="border-b border-slate-100">
                  <td class="py-2 pr-4 whitespace-nowrap">
                    {new Date(er.electionDate).toLocaleDateString('fr-FR')}
                  </td>
                  <td class="py-2 pr-4">{er.electionType}</td>
                  <td class="py-2 pr-4 whitespace-nowrap">
                    {roundLabels[er.round] ?? `Tour ${er.round}`}
                  </td>
                  <td class="py-2 pr-4 whitespace-nowrap font-medium">
                    {er.scorePercent.toFixed(1)} %
                  </td>
                  <td class="py-2">{er.opponentCount}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </section>

    <section id="interets" class="mt-8 scroll-mt-4">
      <h2 class="text-lg font-semibold border-l-4 border-indigo-500 pl-3">
        Intérêts déclarés
        {deputyInterests.length > 0 && (
          <span class="ml-2 text-sm font-normal text-slate-500">({deputyInterests.length})</span>
        )}
      </h2>

      {deputyInterests.length === 0 ? (
        <p class="mt-4 text-slate-500">Aucun intérêt déclaré.</p>
      ) : (
        <ul class="mt-4 space-y-3">
          {deputyInterests.map((i) => (
            <li class="border-b border-slate-100 pb-3">
              <div class="flex items-baseline justify-between">
                <span class="font-medium">{i.entityName}</span>
                <span class="text-sm text-slate-500">
                  {new Date(i.declaredDate).toLocaleDateString('fr-FR')}
                </span>
              </div>
              <div class="mt-1 flex items-center gap-2">
                <span class="inline-block rounded bg-indigo-50 px-2 py-0.5 text-xs font-medium text-indigo-600">
                  {interestTypeLabels[i.type] ?? i.type}
                </span>
                {i.roleDescription && (
                  <span class="text-sm text-slate-500">{i.roleDescription}</span>
                )}
              </div>
            </li>
          ))}
        </ul>
      )}
    </section>

    <section id="votes" class="mt-8 scroll-mt-4">
      <h2 class="text-lg font-semibold border-l-4 border-indigo-500 pl-3">
        Historique des votes
        {deputyVotes.length > 0 && (
          <span class="ml-2 text-sm font-normal text-slate-500">({deputyVotes.length})</span>
        )}
      </h2>

      {deputyVotes.length === 0 ? (
        <p class="mt-4 text-slate-500">Aucun vote enregistré.</p>
      ) : (
        <div class="mt-4 overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-slate-200 text-left text-slate-500">
                <th class="pb-2 pr-4 font-medium">Date</th>
                <th class="pb-2 pr-4 font-medium">Scrutin</th>
                <th class="pb-2 font-medium">Position</th>
              </tr>
            </thead>
            <tbody>
              {deputyVotes.map((v) => (
                <tr class="border-b border-slate-100">
                  <td class="py-2 pr-4 whitespace-nowrap">
                    {new Date(v.ballotDate).toLocaleDateString('fr-FR')}
                  </td>
                  <td class="py-2 pr-4">{v.ballotTitle}</td>
                  <td class="py-2">
                    <span class={`inline-block rounded px-2 py-0.5 text-xs font-medium ${positionColors[v.position] ?? ''}`}>
                      {positionLabels[v.position] ?? v.position}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </section>

    <section id="presse" class="mt-8 scroll-mt-4">
      <h2 class="text-lg font-semibold border-l-4 border-indigo-500 pl-3">
        Dans la presse
        {deputyPress.length > 0 && (
          <span class="ml-2 text-sm font-normal text-slate-500">({deputyPress.length})</span>
        )}
      </h2>

      {deputyPress.length === 0 ? (
        <p class="mt-4 text-slate-500">Aucune mention presse enregistrée/trouvée.</p>
      ) : (
        <ul class="mt-4 space-y-4">
          {deputyPress.map((p) => (
            <li class="border-b border-slate-100 pb-4">
              <a
                href={p.sourceUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="font-medium text-indigo-600 hover:underline"
              >
                {p.title}
              </a>
              <div class="mt-1 flex items-center gap-2 text-sm text-slate-500">
                <span>{p.sourceName}</span>
                <span>&middot;</span>
                <span>{new Date(p.publishedDate).toLocaleDateString('fr-FR')}</span>
              </div>
              {p.summary && (
                <p class="mt-2 text-sm text-slate-600">{p.summary}</p>
              )}
            </li>
          ))}
        </ul>
      )}
    </section>

    <section id="chronologie" class="mt-8 scroll-mt-4">
      <h2 class="text-lg font-semibold border-l-4 border-indigo-500 pl-3">
        Chronologie
        {timelineEvents.length > 0 && (
          <span class="ml-2 text-sm font-normal text-slate-500">({timelineEvents.length})</span>
        )}
      </h2>

      {timelineEvents.length === 0 ? (
        <p class="mt-4 text-slate-500">Aucun événement à afficher.</p>
      ) : (
        <ul class="mt-4 space-y-3">
          {timelineEvents.map((evt) => (
            <li class="flex items-baseline gap-4 border-b border-slate-100 pb-3">
              <span class="shrink-0 text-sm text-slate-500 whitespace-nowrap">
                {new Date(evt.date).toLocaleDateString('fr-FR')}
              </span>
              <span class={`shrink-0 inline-block rounded px-2 py-0.5 text-xs font-medium ${timelineCategoryColors[evt.category] ?? ''}`}>
                {evt.category}
              </span>
              <span class="text-sm">{evt.label}</span>
            </li>
          ))}
        </ul>
      )}
    </section>

    <section id="liens" class="mt-8 scroll-mt-4">
      <h2 class="text-lg font-semibold border-l-4 border-indigo-500 pl-3">Liens extérieurs</h2>

      {deputyLinks.length === 0 ? (
        <p class="mt-4 text-slate-500">Aucun lien externe enregistré.</p>
      ) : (
        <ul class="mt-4 flex flex-wrap gap-3">
          {deputyLinks.map((l) => (
            <li>
              <a
                href={l.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 rounded-full bg-white px-3.5 py-1.5 text-sm font-medium text-indigo-600 shadow-sm ring-1 ring-slate-900/5 hover:ring-indigo-400/40 hover:shadow-md transition-all no-underline"
              >
                {platformLabels[l.platform] ?? l.platform}
              </a>
            </li>
          ))}
        </ul>
      )}
    </section>
  </div>
</BaseLayout>

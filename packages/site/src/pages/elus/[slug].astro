                  {group.label}
                </span>
                <span class="text-slate-400 font-normal">({group.items.length})</span>
              </h3>
              <ul class="mt-2 space-y-2">
                {group.items.map((i) => (
                  <li
                    class="flex items-baseline justify-between border-b border-slate-100 pb-2 cursor-pointer group/interest hover:bg-slate-50 rounded px-1 -mx-1 transition-colors"
                    data-interest-detail={JSON.stringify({
                      entityName: i.entityName,
                      type: i.type,
                      category: i.category ?? group.category,
                      roleDescription: i.roleDescription,
                      declaredDate: i.declaredDate,
                      declarantComment: i.declarantComment,
                      sourceDocumentUrl: i.sourceDocumentUrl,
                      ownershipDetail: i.ownershipDetail,
                      annualAmount: i.annualAmount,
                      amountYear: i.amountYear,
                      amountIsNet: i.amountIsNet,
                      declarationSnapshots: deputySnapshots.map((s) => ({
                        declarationDate: s.declarationDate,
                        declarationType: s.declarationType,
                      })),
                    })}
                  >
                    <div>
                      <span class="font-medium text-sm group-hover/interest:text-indigo-600 transition-colors">{i.entityName}</span>
                      {i.roleDescription && (
                        <span class="ml-2 text-sm text-slate-500">{i.roleDescription}</span>
                      )}
                    </div>
                    <div class="flex items-center gap-2 shrink-0 ml-4">
                      <span class="text-xs text-slate-400 whitespace-nowrap">
                        {new Date(i.declaredDate).toLocaleDateString('fr-FR')}
                      </span>
                      <svg class="h-3.5 w-3.5 text-slate-300 group-hover/interest:text-indigo-400 transition-colors" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      )}
      <p class="mt-3 text-xs text-slate-400">Source : <a href="https://www.hatvp.fr/open-data/" target="_blank" rel="noopener noreferrer" class="underline hover:text-slate-600">HATVP</a>{fmtRetrieval(sectionDates.interests)}</p>
    </section>

    {isParliamentary && <section id="votes" class="mt-8 scroll-mt-12">
      <h2 class="text-lg font-semibold border-l-4 border-indigo-500 pl-3 dark:text-white">
        Historique des votes
        {deputyVotes.length > 0 && (
          <span class="ml-2 text-sm font-normal text-slate-500">({deputyVotes.length})</span>
        )}
      </h2>

      {deputyVotes.length === 0 ? (
        <p class="mt-4 text-slate-500">Aucun vote enregistré.</p>
      ) : (
        <div class="mt-4 overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-slate-200 text-left text-slate-500 dark:border-slate-700 dark:text-slate-400">
                <th class="pb-2 pr-4 font-medium">Date</th>
                <th class="pb-2 pr-4 font-medium">Scrutin</th>
                <th class="pb-2 font-medium">Position</th>
              </tr>
            </thead>
            <tbody>
              {deputyVotes.map((v) => (
                <tr class="border-b border-slate-100 dark:border-slate-700">
                  <td class="py-2 pr-4 whitespace-nowrap">
                    {new Date(v.ballotDate).toLocaleDateString('fr-FR')}
                  </td>
                  <td class="py-2 pr-4">
                    <a href={`/scrutins/${v.ballotId}`} class="text-indigo-600 hover:underline dark:text-indigo-400">{v.ballotTitle}</a>
                  </td>
                  <td class="py-2">
                    <span class={`inline-block rounded px-2 py-0.5 text-xs font-medium ${positionColors[v.position] ?? ''}`}>
                      {positionLabels[v.position] ?? v.position}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
      <p class="mt-3 text-xs text-slate-400">Source : <a href={parliamentSource.url} target="_blank" rel="noopener noreferrer" class="underline hover:text-slate-600">{parliamentSource.name}</a>{fmtRetrieval(sectionDates.votes)}</p>
    </section>}

    <section id="presse" class="mt-8 scroll-mt-12">
      <h2 class="text-lg font-semibold border-l-4 border-indigo-500 pl-3 dark:text-white">
        Dans la presse
        {deputyPress.length > 0 && (
          <span class="ml-2 text-sm font-normal text-slate-500">({deputyPress.length})</span>
        )}
      </h2>

      {deputyPress.length === 0 ? (
        <p class="mt-4 text-slate-500">Aucune mention presse enregistrée/trouvée.</p>
      ) : (
        <>
          <div id="press-grid" class="mt-4 grid gap-4 sm:grid-cols-2">
            {deputyPress.map((p, i) => {
              const d = new Date(p.publishedDate);
              const now = new Date();
              const diffDays = Math.floor((now.getTime() - d.getTime()) / 86400000);
              const dateLabel = diffDays === 0 ? "Aujourd'hui"
                : diffDays === 1 ? 'Hier'
                : diffDays < 7 ? `Il y a ${diffDays} jours`
                : diffDays < 30 ? `Il y a ${Math.floor(diffDays / 7)} sem.`
                : d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' });
              return (
                <a
                  href={p.sourceUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class:list={[
                    'press-card group relative flex flex-col rounded-xl border border-slate-200/80 bg-gradient-to-br from-white to-slate-50/50 p-5 shadow-sm transition-all duration-200 hover:border-orange-300/60 hover:shadow-lg hover:-translate-y-0.5 no-underline dark:border-slate-700 dark:from-slate-800 dark:to-slate-800/80 dark:hover:border-orange-500/40',
                    { 'hidden': i >= 10 },
                  ]}
                >
                  <div class="flex items-start gap-3">
                    <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-orange-100 text-orange-600 dark:bg-orange-900/30 dark:text-orange-400">
                      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 7.5h1.5m-1.5 3h1.5m-7.5 3h7.5m-7.5 3h7.5m3-9h3.375c.621 0 1.125.504 1.125 1.125V18a2.25 2.25 0 01-2.25 2.25M16.5 7.5V18a2.25 2.25 0 002.25 2.25M16.5 7.5V4.875c0-.621-.504-1.125-1.125-1.125H4.125C3.504 3.75 3 4.254 3 4.875V18a2.25 2.25 0 002.25 2.25h13.5" /></svg>
                    </span>
                    <span class="font-medium leading-snug text-slate-800 group-hover:text-orange-700 transition-colors line-clamp-2 dark:text-slate-100 dark:group-hover:text-orange-400">
                      {p.title}
                    </span>
                  </div>
                  <div class="mt-auto flex items-center gap-2 pt-4 pl-11">
                    <span class="inline-flex items-center rounded-full bg-orange-50 px-2.5 py-0.5 text-xs font-semibold text-orange-700 ring-1 ring-inset ring-orange-600/10 dark:bg-orange-900/20 dark:text-orange-300 dark:ring-orange-400/20">{p.sourceName}</span>
                    <span class="text-xs text-slate-400 dark:text-slate-500">{dateLabel}</span>
                    <svg class="ml-auto h-4 w-4 text-slate-300 opacity-0 transition-all group-hover:opacity-100 group-hover:text-orange-500 dark:text-slate-600" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" /></svg>
                  </div>
                </a>
              );
            })}
          </div>
          {deputyPress.length > 10 && (
            <button
              id="press-show-more"
              type="button"
              class="mt-4 w-full rounded-lg border border-slate-200 bg-white py-2.5 text-sm font-medium text-slate-600 transition-all hover:border-orange-300 hover:text-orange-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-400 dark:hover:border-orange-500/40 dark:hover:text-orange-400"
            >
              Voir les {deputyPress.length - 10} autres articles
            </button>
          )}
        </>
      )}
      <p class="mt-3 text-xs text-slate-400">Source : <a href="https://news.google.com" target="_blank" rel="noopener noreferrer" class="underline hover:text-slate-600">Google Actualités</a> (flux RSS){fmtRetrieval(sectionDates.press)}</p>
    </section>

    <section id="liens" class="mt-8 scroll-mt-12">
      <h2 class="text-lg font-semibold border-l-4 border-indigo-500 pl-3 dark:text-white">
        Liens extérieurs
      </h2>

      {(() => {
        const cardPlatforms = new Set(['facebook', 'twitter', 'personal_website']);
        const cardLinks = deputyLinks.filter((l) => cardPlatforms.has(l.platform));
        const pillLinks = deputyLinks.filter((l) => !cardPlatforms.has(l.platform));
        const hasAnCard = !!deputy.anId;
        const hasCards = hasAnCard || cardLinks.length > 0;
        const hasPills = pillLinks.length > 0;
        const hasNothing = !hasCards && !hasPills;

        const linkCardConfigs: Record<string, { icon: string; color: string; hoverColor: string; label: string }> = {
          facebook: {
            icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>',
            color: 'text-[#1877F2]',
            hoverColor: 'group-hover:text-[#1565C0]',
            label: 'Facebook',
          },
          twitter: {
            icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>',
            color: 'text-slate-900',
            hoverColor: 'group-hover:text-slate-700',
            label: 'X (Twitter)',
          },
          personal_website: {
            icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>',
            color: 'text-emerald-600',
            hoverColor: 'group-hover:text-emerald-700',
            label: 'Site personnel',
          },
        };

        const externalLinkIcon = '<svg xmlns="http://www.w3.org/2000/svg" class="ml-1 inline-block h-3 w-3 align-baseline" viewBox="0 0 12 12" fill="currentColor"><path d="M6 1h5v5l-2-2-3 3-2-2 3-3z"/><path d="M9.5 7.5v3h-8v-8h3l1-1h-4a1 1 0 00-1 1v8a1 1 0 001 1h8a1 1 0 001-1v-4z"/></svg>';

        return (
          <>
            {hasCards && (
              <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {deputy.anId && (
                  <a
                    href={`https://www.assemblee-nationale.fr/dyn/deputes/${deputy.anId}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group flex items-center gap-4 rounded-2xl bg-white p-4 shadow-sm ring-1 ring-slate-900/5 transition-shadow hover:shadow-md no-underline dark:bg-slate-800 dark:ring-slate-700"
                  >
                    <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-indigo-50 text-indigo-600">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M5 21V7l8-4v18"/><path d="M19 21V11l-6-4"/><path d="M9 9v.01"/><path d="M9 12v.01"/><path d="M9 15v.01"/><path d="M9 18v.01"/></svg>
                    </div>
                    <div class="min-w-0">
                      <p class="text-sm font-semibold text-slate-800 group-hover:text-indigo-600 transition-colors dark:text-slate-100 dark:group-hover:text-indigo-400">
                        Assemblée nationale
                      </p>
                      <p class="text-xs text-slate-500 truncate dark:text-slate-400" set:html={`Fiche officielle${externalLinkIcon}`} />
                    </div>
                  </a>
                )}
                {cardLinks.map((l) => {
                  const cfg = linkCardConfigs[l.platform];
                  if (!cfg) return null;
                  const displayUrl = l.url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/+$/, '');
                  return (
                    <a
                      href={l.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="group flex items-center gap-4 rounded-2xl bg-white p-4 shadow-sm ring-1 ring-slate-900/5 transition-shadow hover:shadow-md no-underline dark:bg-slate-800 dark:ring-slate-700"
                    >
                      <div class={`flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-slate-50 ${cfg.color}`}>
                        <Fragment set:html={cfg.icon} />
                      </div>
                      <div class="min-w-0">
                        <p class={`text-sm font-semibold text-slate-800 ${cfg.hoverColor} transition-colors`}>
                          {cfg.label}
                        </p>
                        <p class="text-xs text-slate-500 truncate dark:text-slate-400" set:html={`${displayUrl}${externalLinkIcon}`} />
                      </div>
                    </a>
                  );
                })}
              </div>
            )}

            {hasPills && (
              <ul class="mt-4 flex flex-wrap gap-3">
                {pillLinks.map((l) => (
                  <li>
                    <a
                      href={l.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 rounded-full bg-white px-3.5 py-1.5 text-sm font-medium text-indigo-600 shadow-sm ring-1 ring-slate-900/5 hover:ring-indigo-400/40 hover:shadow-md transition-all no-underline dark:bg-slate-800 dark:ring-slate-700 dark:text-indigo-400 dark:hover:ring-indigo-500/40"
                    >
                      {platformLabels[l.platform] ?? l.platform}
                    </a>
                  </li>
                ))}
              </ul>
            )}

            {hasNothing && (
              <p class="mt-4 text-slate-500">Aucun lien externe enregistré.</p>
            )}
          </>
        );
      })()}
      <p class="mt-3 text-xs text-slate-400">Source : <a href={parliamentSource.url} target="_blank" rel="noopener noreferrer" class="underline hover:text-slate-600">{parliamentSource.name}</a>{fmtRetrieval(sectionDates.links)}</p>
    </section>
  </div>

  <QuestionDetailDrawer client:idle />
  <InterestDetailDrawer client:idle />

  <script>
    const tocInline = document.getElementById('toc-inline');
    const tocSticky = document.getElementById('toc-sticky');
    if (tocInline && tocSticky) {
      const visibilityObserver = new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting) {
            tocSticky.classList.add('-translate-y-full');
            tocSticky.setAttribute('aria-hidden', 'true');
          } else {
            tocSticky.classList.remove('-translate-y-full');
            tocSticky.setAttribute('aria-hidden', 'false');
          }
        },
        { threshold: 0 },
      );
      visibilityObserver.observe(tocInline);

      const sectionIds = [
        'mandat', 'coordonnees', 'affiliations', 'collaborateurs',
        'activite', 'commissions', 'electoral', 'financement',
        'interets', 'votes', 'presse', 'liens',
      ];

      let currentId = '';

      function setActive(id: string) {
        if (id === currentId) return;
        currentId = id;
        for (const nav of [tocInline, tocSticky]) {
          if (!nav) {
            continue;
          }
          for (const link of nav.querySelectorAll('a')) {
            const href = link.getAttribute('href');
            if (href === `#${id}`) {
              link.classList.remove('text-slate-600', 'text-slate-500');
              link.classList.add('text-indigo-600', 'font-semibold');
            } else {
              link.classList.remove('text-indigo-600', 'font-semibold');
              link.classList.add(
                nav === tocInline ? 'text-slate-600' : 'text-slate-500',
              );
            }
          }
        }
      }

      const spyObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              setActive(entry.target.id);
            }
          }
        },
        { rootMargin: '-10% 0px -80% 0px' },
      );

      for (const id of sectionIds) {
        const el = document.getElementById(id);
        if (el) spyObserver.observe(el);
      }
    }

    const filterContainer = document.getElementById('committees-filter');
    const statusFilterContainer = document.getElementById('committees-status-filter');
    const committeesList = document.getElementById('committees-list');
    const committeesCount = document.getElementById('committees-count');

    if (filterContainer && statusFilterContainer && committeesList) {
      const typeCheckboxes = filterContainer.querySelectorAll<HTMLInputElement>('[data-committee-filter]');
      const statusCheckboxes = statusFilterContainer.querySelectorAll<HTMLInputElement>('[data-committee-status-filter]');
      const items = committeesList.querySelectorAll<HTMLElement>('[data-committee-type]');

      function applyFilter() {
        const activeTypes = new Set<string>();
        for (const cb of typeCheckboxes) {
          if (cb.checked) activeTypes.add(cb.value);
        }
        const activeStatuses = new Set<string>();
        for (const cb of statusCheckboxes) {
          if (cb.checked) activeStatuses.add(cb.value);
        }
        let visible = 0;
        for (const item of items) {
          const show = activeTypes.has(item.dataset.committeeType!) && activeStatuses.has(item.dataset.committeeStatus!);
          item.style.display = show ? '' : 'none';
          if (show) visible++;
        }
        if (committeesCount) {
          committeesCount.textContent = `(${visible})`;
        }
      }

      for (const cb of typeCheckboxes) {
        cb.addEventListener('change', applyFilter);
      }
      for (const cb of statusCheckboxes) {
        cb.addEventListener('change', applyFilter);
      }
    }

    const activityTypeFilter = document.getElementById('activity-type-filter');
    const dateFrom = document.getElementById('activity-date-from') as HTMLInputElement | null;
    const dateTo = document.getElementById('activity-date-to') as HTMLInputElement | null;
    const dateReset = document.getElementById('activity-date-reset');
    const activityList = document.getElementById('activity-list');
    const activityCount = document.getElementById('activity-count');

    const rubriqueFilter = document.getElementById('activity-rubrique-filter');
    const ministryFilter = document.getElementById('activity-ministry-filter');

    if (activityTypeFilter && dateFrom && dateTo && activityList) {
      const typeCheckboxes = activityTypeFilter.querySelectorAll<HTMLInputElement>('[data-activity-type-filter]');
      const rubriqueCheckboxes = rubriqueFilter?.querySelectorAll<HTMLInputElement>('[data-activity-rubrique-filter]') ?? [];
      const ministryCheckboxes = ministryFilter?.querySelectorAll<HTMLInputElement>('[data-activity-ministry-filter]') ?? [];
      const rows = activityList.querySelectorAll<HTMLElement>('[data-activity-date]');

      function applyActivityFilter() {
        const activeTypes = new Set<string>();
        for (const cb of typeCheckboxes) {
          if (cb.checked) activeTypes.add(cb.value);
        }
        const activeRubriques = new Set<string>();
        for (const cb of rubriqueCheckboxes) {
          if (cb.checked) activeRubriques.add(cb.value);
        }
        const activeMinistries = new Set<string>();
        for (const cb of ministryCheckboxes) {
          if (cb.checked) activeMinistries.add(cb.value);
        }
        const hasRubriqueFilter = rubriqueCheckboxes.length > 0;
        const hasMinistryFilter = ministryCheckboxes.length > 0;
        const from = dateFrom!.value;
        const to = dateTo!.value;
        let visible = 0;
        for (const row of rows) {
          const date = row.dataset.activityDate!;
          const type = row.dataset.activityType!;
          const rubrique = row.dataset.activityRubrique ?? '';
          const ministry = row.dataset.activityMinistry ?? '';
          const matchesRubrique = !hasRubriqueFilter || !rubrique || activeRubriques.has(rubrique);
          const matchesMinistry = !hasMinistryFilter || !ministry || activeMinistries.has(ministry);
          const show = activeTypes.has(type) && matchesRubrique && matchesMinistry && (!from || date >= from) && (!to || date <= to);
          row.style.display = show ? '' : 'none';
          if (show) visible++;
        }
        if (activityCount) {
          activityCount.textContent = `${visible} résultat${visible > 1 ? 's' : ''}`;
        }
      }

      for (const cb of typeCheckboxes) {
        cb.addEventListener('change', applyActivityFilter);
      }
      for (const cb of rubriqueCheckboxes) {
        cb.addEventListener('change', applyActivityFilter);
      }
      for (const cb of ministryCheckboxes) {
        cb.addEventListener('change', applyActivityFilter);
      }
      dateFrom.addEventListener('change', applyActivityFilter);
      dateTo.addEventListener('change', applyActivityFilter);

      if (dateReset) {
        dateReset.addEventListener('click', () => {
          dateFrom.value = '';
          dateTo.value = '';
          applyActivityFilter();
        });
      }
    }

    document.querySelectorAll<HTMLElement>('[data-interest-detail]').forEach((el) => {
      el.addEventListener('click', () => {
        const detail = JSON.parse(el.dataset.interestDetail!);
        window.dispatchEvent(new CustomEvent('open-interest-detail', { detail }));
      });
    });

    document.querySelectorAll<HTMLTableRowElement>('[data-activity-detail]').forEach((row) => {
      row.addEventListener('click', () => {
        const detail = JSON.parse(row.dataset.activityDetail!);
        window.dispatchEvent(new CustomEvent('open-question-detail', { detail }));
      });
    });

    const pressBtn = document.getElementById('press-show-more');
    if (pressBtn) {
      pressBtn.addEventListener('click', () => {
        document.querySelectorAll('#press-grid .press-card.hidden').forEach((c) => c.classList.remove('hidden'));
        pressBtn.remove();
      });
    }

  </script>
</BaseLayout>

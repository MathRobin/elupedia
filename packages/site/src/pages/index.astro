---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSearch from '../components/HeroSearch';
import { getDb } from '../lib/db.js';
import { officials, mandates, ballots, senatorialElections, senatorialCandidates } from '@elupedia/shared';
import { eq, isNull, sql } from 'drizzle-orm';

const db = getDb();

const searchRows = await db
  .select({
    slug: officials.slug,
    firstName: officials.firstName,
    lastName: officials.lastName,
    mandateType: mandates.type,
    politicalGroup: mandates.politicalGroup,
  })
  .from(officials)
  .innerJoin(mandates, eq(mandates.officialId, officials.id))
  .where(isNull(mandates.endDate))
  .orderBy(officials.lastName);

const searchList = searchRows.map((r) => ({
  slug: r.slug!,
  firstName: r.firstName,
  lastName: r.lastName,
  mandateType: r.mandateType,
  politicalGroup: r.politicalGroup,
}));

const [countResult] = await db
  .select({ count: sql<number>`count(distinct ${officials.id})` })
  .from(officials)
  .innerJoin(mandates, eq(mandates.officialId, officials.id))
  .where(isNull(mandates.endDate));

const [ballotCount] = await db
  .select({ count: sql<number>`count(*)` })
  .from(ballots);

const totalOfficials = Number(countResult?.count ?? 0);
const totalBallots = Number(ballotCount?.count ?? 0);

const SENATORIAL_YEAR = '2026';
const [senatorialStats] = await db
  .select({
    candidateCount: sql<number>`count(*)`,
    departementCount: sql<number>`count(distinct ${senatorialElections.departementCode})`,
  })
  .from(senatorialCandidates)
  .innerJoin(senatorialElections, eq(senatorialCandidates.electionId, senatorialElections.id))
  .where(eq(senatorialElections.electionYear, SENATORIAL_YEAR));

const senatorialCandidateCount = Number(senatorialStats?.candidateCount ?? 0);
const senatorialDepartementCount = Number(senatorialStats?.departementCount ?? 0);
const [senatorialDateRow] = await db
  .select({ electionDate: senatorialElections.electionDate })
  .from(senatorialElections)
  .where(eq(senatorialElections.electionYear, SENATORIAL_YEAR))
  .limit(1);
const senatorialElectionIsUpcoming = senatorialDateRow
  ? new Date(senatorialDateRow.electionDate).getTime() > Date.now()
  : false;
---

<BaseLayout
  title="Elupedia"
  description="Encyclopédie ouverte des élus français — données officielles consolidées, transparence totale, neutralité absolue."
>
  <div class="flex flex-col gap-20">

    <!-- Hero -->
    <section class="text-center pt-8 pb-2">
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 dark:text-white">
        Chaque élu, chaque vote,<br class="hidden sm:inline" />
        <span class="text-indigo-600 dark:text-indigo-400">les faits, rien que les faits.</span>
      </h1>
      <p class="mt-6 mx-auto max-w-2xl text-lg text-slate-600 dark:text-slate-400">
        Élupedia consolide en un lieu unique les données officielles éparpillées
        entre l'Assemblée nationale, le Sénat, la HATVP et data.gouv.fr.
        {totalOfficials > 0 && (
          <span class="font-medium text-slate-700 dark:text-slate-300">
            {' '}{totalOfficials.toLocaleString('fr-FR')} élus
          </span>
        )}
        {totalBallots > 0 && (
          <span class="font-medium text-slate-700 dark:text-slate-300">
            {' '}· {totalBallots.toLocaleString('fr-FR')} scrutins
          </span>
        )}
      </p>

      <div class="mt-8">
        <HeroSearch client:load officials={searchList} />
      </div>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a
          href="/elus"
          class="inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-indigo-700 transition-colors no-underline"
        >
          <i class="fa-solid fa-users h-5 w-5 flex items-center justify-center" aria-hidden="true"></i>
          Explorer l'annuaire des élus
        </a>
        <a
          href="/votes"
          class="inline-flex items-center gap-2 rounded-xl border border-slate-300 bg-white px-6 py-3 text-sm font-semibold text-slate-700 shadow-sm hover:border-indigo-400 hover:text-indigo-700 transition-colors no-underline dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200 dark:hover:border-indigo-500 dark:hover:text-indigo-400"
        >
          <i class="fa-solid fa-check-to-slot h-5 w-5 flex items-center justify-center" aria-hidden="true"></i>
          Consulter les votes
        </a>
      </div>

      <p class="mt-6 text-sm text-slate-500 dark:text-slate-400">
        Projet open source sous licence AGPL-3.0 —
        <a
          href="https://github.com/MathRobin/elupedia"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 font-medium text-slate-600 underline underline-offset-2 hover:text-indigo-600 transition-colors dark:text-slate-300 dark:hover:text-indigo-400"
        >
          <i class="fa-brands fa-github" aria-hidden="true"></i>
          tout le code est public sur GitHub
        </a>
      </p>
    </section>

    {senatorialCandidateCount > 0 && (
      <section class="rounded-2xl border border-purple-200/60 bg-gradient-to-br from-purple-50 to-indigo-50 p-6 sm:p-8 dark:border-purple-500/30 dark:from-purple-950/30 dark:to-indigo-950/30">
        <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <span class="inline-flex items-center rounded-full bg-purple-100 px-3 py-1 text-xs font-semibold text-purple-700 ring-1 ring-inset ring-purple-600/10 dark:bg-purple-900/40 dark:text-purple-300">
              {senatorialElectionIsUpcoming ? 'Élection à venir' : 'Élection récente'} · 27 septembre {SENATORIAL_YEAR}
            </span>
            <h2 class="mt-3 text-2xl font-bold text-slate-900 dark:text-white">
              Élections sénatoriales {SENATORIAL_YEAR}
            </h2>
            <p class="mt-2 max-w-xl text-slate-600 dark:text-slate-400">
              La moitié du Sénat est renouvelée le 27 septembre {SENATORIAL_YEAR}. Découvrez le panorama complet des{' '}
              <span class="font-medium text-slate-800 dark:text-slate-200">{senatorialCandidateCount.toLocaleString('fr-FR')} candidat(e)s</span>
              {' '}dans les <span class="font-medium text-slate-800 dark:text-slate-200">{senatorialDepartementCount} circonscriptions</span> concernées.
            </p>
          </div>
          <a
            href={`/elections/senatoriale/${SENATORIAL_YEAR}-1`}
            class="inline-flex shrink-0 items-center gap-2 rounded-xl bg-purple-600 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-purple-700 transition-colors no-underline"
          >
            <i class="fa-solid fa-landmark h-5 w-5 flex items-center justify-center" aria-hidden="true"></i>
            Voir le panorama des candidats
          </a>
        </div>
      </section>
    )}

    <!-- Fonctionnalités -->
    <section>
      <h2 class="text-center text-2xl font-bold text-slate-900 dark:text-white">
        Ce que vous trouverez sur Élupedia
      </h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-700 dark:bg-slate-800">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600 dark:bg-indigo-900/30 dark:text-indigo-400">
            <i class="fa-solid fa-user-tie text-2xl" aria-hidden="true"></i>
          </div>
          <h3 class="mt-4 text-lg font-semibold text-slate-900 dark:text-white">Fiches Députés, Sénateurs, Maires & Conseillers départementaux</h3>
          <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
            Profils complets, mandats actuels et passés, organes parlementaires, équipe de collaborateurs.
          </p>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-700 dark:bg-slate-800">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600 dark:bg-emerald-900/30 dark:text-emerald-400">
            <i class="fa-solid fa-chart-column text-2xl" aria-hidden="true"></i>
          </div>
          <h3 class="mt-4 text-lg font-semibold text-slate-900 dark:text-white">Analyse des Votes</h3>
          <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
            Détail des positions prises sur chaque texte de loi et amendement, filtrables par groupe politique ou nature de vote.
          </p>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:col-span-2 lg:col-span-1 dark:border-slate-700 dark:bg-slate-800">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-amber-50 text-amber-600 dark:bg-amber-900/30 dark:text-amber-400">
            <i class="fa-solid fa-shield-halved text-2xl" aria-hidden="true"></i>
          </div>
          <h3 class="mt-4 text-lg font-semibold text-slate-900 dark:text-white">Transparence & Données brutes</h3>
          <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
            Traçabilité vers les sources officielles, aucune donnée interprétée ou modifiée.
          </p>
        </div>
      </div>
    </section>

    <!-- Engagements -->
    <section class="rounded-2xl bg-slate-900 p-8 sm:p-12 dark:bg-slate-800">
      <h2 class="text-center text-2xl font-bold text-white">Nos engagements</h2>
      <div class="mt-8 grid gap-8 sm:grid-cols-2">
        <div class="flex gap-4">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-indigo-500/20 text-indigo-400">
            <i class="fa-solid fa-eye text-xl" aria-hidden="true"></i>
          </div>
          <div>
            <h3 class="font-semibold text-white">Transparence radicale</h3>
            <p class="mt-1 text-sm text-slate-400">
              Chaque donnée est citée avec sa source officielle et horodatée.
            </p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-emerald-400">
            <i class="fa-solid fa-scale-balanced text-xl" aria-hidden="true"></i>
          </div>
          <div>
            <h3 class="font-semibold text-white">Neutralité absolue</h3>
            <p class="mt-1 text-sm text-slate-400">
              Aucun classement, aucun score, aucune opinion. Les données parlent d'elles-mêmes.
            </p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-sky-500/20 text-sky-400">
            <i class="fa-brands fa-github text-xl" aria-hidden="true"></i>
          </div>
          <div>
            <h3 class="font-semibold text-white">Open source</h3>
            <p class="mt-1 text-sm text-slate-400">
              L'intégralité du code est publique sous licence AGPL-3.0 : chacun peut vérifier
              comment les données sont collectées et affichées, signaler une erreur ou contribuer.
              {' '}
              <a
                href="https://github.com/MathRobin/elupedia"
                target="_blank"
                rel="noopener noreferrer"
                class="font-medium text-sky-400 underline underline-offset-2 hover:text-sky-300 transition-colors"
              >
                Voir le dépôt
              </a>
            </p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-amber-500/20 text-amber-400">
            <i class="fa-solid fa-hand-holding-heart text-xl" aria-hidden="true"></i>
          </div>
          <div>
            <h3 class="font-semibold text-white">Gratuité et indépendance</h3>
            <p class="mt-1 text-sm text-slate-400">
              Accès libre, sans publicité et sans revente de données. Projet autofinancé,
              sans financement public ni privé.
            </p>
          </div>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>

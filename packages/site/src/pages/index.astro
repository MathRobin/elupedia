---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBar from '../components/SearchBar';
import { getDb } from '../lib/db.js';
import { officials, mandates } from '@elupedia/shared';
import { eq, isNull } from 'drizzle-orm';

type Deputy = {
  id: string;
  firstName: string;
  lastName: string;
  photoUrl: string | null;
  district: string | null;
  politicalGroup: string | null;
};

let deputesList: Deputy[] = [];
let error: string | null = null;

try {
  const db = getDb();
  const rows = await db
    .select({
      id: officials.id,
      firstName: officials.firstName,
      lastName: officials.lastName,
      photoUrl: officials.photoUrl,
      district: mandates.district,
      politicalGroup: mandates.politicalGroup,
    })
    .from(officials)
    .innerJoin(mandates, eq(mandates.officialId, officials.id))
    .where(isNull(mandates.endDate));

  deputesList = rows;
} catch (e) {
  error = e instanceof Error ? e.message : String(e);
}
---

<BaseLayout>
  <h1 class="text-4xl font-bold">Députés de Gironde</h1>
  <p class="mt-2 text-lg text-gray-600">
    {deputesList.length > 0
      ? `${deputesList.length} députés en exercice`
      : 'Aucun député trouvé'}
  </p>

  <div class="mt-6">
    <SearchBar client:load />
  </div>

  {error && (
    <p class="mt-4 text-sm text-red-600">
      Impossible de charger les données : {error}
    </p>
  )}

  <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {deputesList.map((d) => (
      <a
        href={`/elus/${d.id}`}
        class="group flex items-start gap-4 rounded-lg border border-gray-200 p-4 hover:border-gray-400 hover:shadow-sm transition-all no-underline"
      >
        {d.photoUrl ? (
          <img
            src={d.photoUrl}
            alt={`${d.firstName} ${d.lastName}`}
            class="h-16 w-16 shrink-0 rounded-full object-cover bg-gray-100"
            loading="lazy"
          />
        ) : (
          <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-gray-100 text-xl font-medium text-gray-400">
            {d.firstName[0]}{d.lastName[0]}
          </div>
        )}
        <div class="min-w-0">
          <p class="font-semibold text-gray-900 group-hover:text-blue-700 transition-colors">
            {d.firstName} {d.lastName}
          </p>
          {d.district && (
            <p class="mt-1 text-sm text-gray-500">{d.district}</p>
          )}
          {d.politicalGroup && (
            <p class="mt-1 text-xs text-gray-400">{d.politicalGroup}</p>
          )}
        </div>
      </a>
    ))}
  </div>
</BaseLayout>

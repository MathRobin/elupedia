---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSearch from '../components/HeroSearch';
import { getDb } from '../lib/db.js';
import { officials, mandates, ballots } from '@elupedia/shared';
import { eq, isNull, sql } from 'drizzle-orm';

const db = getDb();

const searchRows = await db
  .select({
    slug: officials.slug,
    firstName: officials.firstName,
    lastName: officials.lastName,
    mandateType: mandates.type,
    politicalGroup: mandates.politicalGroup,
  })
  .from(officials)
  .innerJoin(mandates, eq(mandates.officialId, officials.id))
  .where(isNull(mandates.endDate))
  .orderBy(officials.lastName);

const searchList = searchRows.map((r) => ({
  slug: r.slug!,
  firstName: r.firstName,
  lastName: r.lastName,
  mandateType: r.mandateType,
  politicalGroup: r.politicalGroup,
}));

const [countResult] = await db
  .select({ count: sql<number>`count(distinct ${officials.id})` })
  .from(officials)
  .innerJoin(mandates, eq(mandates.officialId, officials.id))
  .where(isNull(mandates.endDate));

const [ballotCount] = await db
  .select({ count: sql<number>`count(*)` })
  .from(ballots);

const totalOfficials = Number(countResult?.count ?? 0);
const totalBallots = Number(ballotCount?.count ?? 0);
---

<BaseLayout
  title="Elupedia"
  description="Encyclopédie ouverte des élus français — données officielles consolidées, transparence totale, neutralité absolue."
>
  <div class="flex flex-col gap-20">

    <!-- Hero -->
    <section class="text-center pt-8 pb-2">
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 dark:text-white">
        Chaque élu, chaque vote,<br class="hidden sm:inline" />
        <span class="text-indigo-600 dark:text-indigo-400">les faits, rien que les faits.</span>
      </h1>
      <p class="mt-6 mx-auto max-w-2xl text-lg text-slate-600 dark:text-slate-400">
        Élupedia consolide en un lieu unique les données officielles éparpillées
        entre l'Assemblée nationale, le Sénat, la HATVP et data.gouv.fr.
        {totalOfficials > 0 && (
          <span class="font-medium text-slate-700 dark:text-slate-300">
            {' '}{totalOfficials.toLocaleString('fr-FR')} élus
          </span>
        )}
        {totalBallots > 0 && (
          <span class="font-medium text-slate-700 dark:text-slate-300">
            {' '}· {totalBallots.toLocaleString('fr-FR')} scrutins
          </span>
        )}
      </p>

      <div class="mt-8">
        <HeroSearch client:load officials={searchList} />
      </div>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a
          href="/elus"
          class="inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-indigo-700 transition-colors no-underline"
        >
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" /></svg>
          Explorer l'annuaire des élus
        </a>
        <a
          href="/votes"
          class="inline-flex items-center gap-2 rounded-xl border border-slate-300 bg-white px-6 py-3 text-sm font-semibold text-slate-700 shadow-sm hover:border-indigo-400 hover:text-indigo-700 transition-colors no-underline dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200 dark:hover:border-indigo-500 dark:hover:text-indigo-400"
        >
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 0 0 2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75 2.25 2.25 0 0 0-.1-.664m-5.8 0A2.251 2.251 0 0 1 13.5 2.25H15a2.25 2.25 0 0 1 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25ZM6.75 12h.008v.008H6.75V12Zm0 3h.008v.008H6.75V15Zm0 3h.008v.008H6.75V18Z" /></svg>
          Consulter les votes
        </a>
      </div>
    </section>

    <!-- Fonctionnalités -->
    <section>
      <h2 class="text-center text-2xl font-bold text-slate-900 dark:text-white">
        Ce que vous trouverez sur Élupedia
      </h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-700 dark:bg-slate-800">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600 dark:bg-indigo-900/30 dark:text-indigo-400">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" /></svg>
          </div>
          <h3 class="mt-4 text-lg font-semibold text-slate-900 dark:text-white">Fiches Députés & Sénateurs</h3>
          <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
            Profils complets, mandats actuels et passés, organes parlementaires, équipe de collaborateurs.
          </p>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-700 dark:bg-slate-800">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600 dark:bg-emerald-900/30 dark:text-emerald-400">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z" /></svg>
          </div>
          <h3 class="mt-4 text-lg font-semibold text-slate-900 dark:text-white">Analyse des Votes</h3>
          <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
            Détail des positions prises sur chaque texte de loi et amendement, filtrables par groupe politique ou nature de vote.
          </p>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:col-span-2 lg:col-span-1 dark:border-slate-700 dark:bg-slate-800">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-amber-50 text-amber-600 dark:bg-amber-900/30 dark:text-amber-400">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" /></svg>
          </div>
          <h3 class="mt-4 text-lg font-semibold text-slate-900 dark:text-white">Transparence & Données brutes</h3>
          <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
            Traçabilité vers les sources officielles, aucune donnée interprétée ou modifiée.
          </p>
        </div>
      </div>
    </section>

    <!-- Engagements -->
    <section class="rounded-2xl bg-slate-900 p-8 sm:p-12 dark:bg-slate-800">
      <h2 class="text-center text-2xl font-bold text-white">Nos engagements</h2>
      <div class="mt-8 grid gap-8 sm:grid-cols-2">
        <div class="flex gap-4">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-indigo-500/20 text-indigo-400">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /></svg>
          </div>
          <div>
            <h3 class="font-semibold text-white">Transparence radicale</h3>
            <p class="mt-1 text-sm text-slate-400">
              Chaque donnée est citée avec sa source officielle et horodatée. Le code est ouvert (AGPL-3.0).
            </p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-emerald-400">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v17.25m0 0c-1.472 0-2.882.265-4.185.75M12 20.25c1.472 0 2.882.265 4.185.75M18.75 4.97A48.416 48.416 0 0 0 12 4.5c-2.291 0-4.545.16-6.75.47m13.5 0c1.01.143 2.01.317 3 .52m-3-.52 2.62 10.726c.122.499-.106 1.028-.589 1.202a5.988 5.988 0 0 1-2.031.352 5.988 5.988 0 0 1-2.031-.352c-.483-.174-.711-.703-.59-1.202L18.75 4.971Zm-16.5.52c.99-.203 1.99-.377 3-.52m0 0 2.62 10.726c.122.499-.106 1.028-.589 1.202a5.989 5.989 0 0 1-2.031.352 5.989 5.989 0 0 1-2.031-.352c-.483-.174-.711-.703-.59-1.202L5.25 4.971Z" /></svg>
          </div>
          <div>
            <h3 class="font-semibold text-white">Neutralité absolue</h3>
            <p class="mt-1 text-sm text-slate-400">
              Aucun classement, aucun score, aucune opinion. Les données parlent d'elles-mêmes.
            </p>
          </div>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>

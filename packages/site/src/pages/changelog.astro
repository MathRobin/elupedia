---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Changelog';
const description = "Historique des évolutions d'Elupedia, l'encyclopédie ouverte des élus français.";

interface ChangelogEntry {
  date: string;
  title: string;
  description: string;
  tag: 'feature' | 'perf' | 'data' | 'infra';
}

const changelog: ChangelogEntry[] = [
  {
    date: '2026-09-06',
    title: 'Décorations officielles',
    description: "Ingestion des décorations (Légion d'honneur, Ordre national du Mérite, Médaille militaire) depuis les archives de la Grande Chancellerie. Affichage sur les fiches d'élus.",
    tag: 'data',
  },
  {
    date: '2026-09-05',
    title: 'Résultats électoraux législatifs et sénatoriaux',
    description: "Ingestion des résultats des élections législatives et sénatoriales depuis les données OVH. Affichage détaillé sur les fiches d'élus avec scores, nuances et statut élu/non-élu.",
    tag: 'data',
  },
  {
    date: '2026-09-05',
    title: 'Résultats municipaux pour tous les élus',
    description: "Les résultats municipaux sont maintenant visibles sur les fiches de tous les élus candidats, pas uniquement les maires.",
    tag: 'feature',
  },
  {
    date: '2026-09-05',
    title: 'Réconciliation candidats–élus',
    description: "Nouveau script de réconciliation qui rattache automatiquement les candidats aux élections à leur fiche d'élu via la normalisation des noms.",
    tag: 'data',
  },
  {
    date: '2026-09-04',
    title: 'Enrichissement Schema.org',
    description: "JSON-LD enrichi sur les fiches d'élus : genre, lieu de naissance, titre honorifique, affiliations politiques.",
    tag: 'perf',
  },
  {
    date: '2026-09-04',
    title: 'Statut déclaration HATVP',
    description: "Bandeau signalant les élus ayant déposé leur déclaration HATVP mais dont les données ne sont pas encore publiées.",
    tag: 'feature',
  },
  {
    date: '2026-09-04',
    title: 'Photos AN au format legislature',
    description: "Les photos de députés utilisent le nouveau format d'URL de l'AN basé sur la législature, corrigeant les liens cassés.",
    tag: 'data',
  },
  {
    date: '2026-09-03',
    title: 'Photos S3 et presse maires',
    description: "Synchronisation des photos d'élus sur S3 (servies via CDN). Ingestion de la presse pour les maires en complément des parlementaires.",
    tag: 'data',
  },
  {
    date: '2026-09-03',
    title: "Affichage de tous les élus et fin de mandat",
    description: "La liste des élus inclut désormais les anciens mandataires. Les fiches affichent la date de fin du dernier mandat.",
    tag: 'feature',
  },
  {
    date: '2026-09-03',
    title: 'Carte de juridiction sur les fiches',
    description: "Carte SVG de la France sur les fiches de parlementaires, avec le département de la circonscription coloré aux couleurs du groupe politique.",
    tag: 'feature',
  },
  {
    date: '2026-09-03',
    title: 'Résultats municipaux',
    description: "Ingestion des résultats des élections municipales depuis les CSV du pipeline OVH (34 000+ communes). Affichage sur les fiches maires.",
    tag: 'data',
  },
  {
    date: '2026-09-03',
    title: 'Chronologie complète',
    description: "Nouvelle vue chronologique type git-tree sur les fiches d'élus, regroupant mandats, votes clés et événements en ordre anti-chronologique.",
    tag: 'feature',
  },
  {
    date: '2026-09-02',
    title: 'Photos maires Wikidata et filtres avancés',
    description: "Récupération des photos de maires via Wikidata. Filtres multi-sélection par type de scrutin et présence de photo sur la page votes.",
    tag: 'feature',
  },
  {
    date: '2026-09-02',
    title: 'Carte départementale interactive sur les scrutins',
    description: "Carte SVG interactive de la France sur les pages de scrutin, montrant les résultats par département.",
    tag: 'feature',
  },
  {
    date: '2026-09-02',
    title: 'Signatures de parrainages et RIP',
    description: "Ingestion des parrainages présidentiels (Conseil constitutionnel) et des signatures de référendums d'initiative partagée. Affichage sur les fiches.",
    tag: 'data',
  },
  {
    date: '2026-09-02',
    title: 'Rendu hybride Astro',
    description: "Passage en rendu statique avec requêtes serveur à la demande pour les pages lourdes, réduisant les temps de build et évitant les limites mémoire Neon.",
    tag: 'perf',
  },
  {
    date: '2026-09-02',
    title: 'QR code de partage',
    description: "Le bouton Partager propose désormais un QR code avec le logo Elupedia, à scanner ou télécharger.",
    tag: 'feature',
  },
  {
    date: '2026-09-02',
    title: 'Comptes de campagne CNCCFP',
    description: "Intégration des données de financement de campagne (législatives 2022 et 2024, sénatoriales 2023) de la CNCCFP. Nouvelle section « Financement de campagne » sur les fiches d'élus.",
    tag: 'data',
  },
  {
    date: '2026-09-01',
    title: 'Cartes statiques des adresses',
    description: "Chaque adresse de permanence affiche une carte OpenStreetMap statique, générée à l'ingestion et servie via CDN.",
    tag: 'feature',
  },
  {
    date: '2026-08-31',
    title: 'Intégration des maires',
    description: "Ingestion des maires via le RNE, adresses de mairies via la DILA, déclarations HATVP étendues aux maires, scraping des sites web communaux pour les réseaux sociaux.",
    tag: 'data',
  },
  {
    date: '2026-08-31',
    title: 'Activité parlementaire du Sénat',
    description: "Ingestion de l'activité parlementaire, commissions, délégations et liens sociaux des sénateurs.",
    tag: 'data',
  },
  {
    date: '2026-08-31',
    title: 'Publication automatique sur les réseaux sociaux',
    description: "Génération d'images OG avec Satori et publication quotidienne automatique via Postiz.",
    tag: 'infra',
  },
  {
    date: '2026-08-31',
    title: "Refonte de la page d'accueil et navigation",
    description: "Nouvelle page d'accueil type landing, pages /élus et /votes avec filtres avancés, pagination, mode sombre et bouton de partage.",
    tag: 'feature',
  },
  {
    date: '2026-08-30',
    title: 'Votes et scrutins',
    description: "Ingestion des résultats de scrutins AN. Refonte de la page scrutin avec filtres par position et groupe. Liens vers les détails depuis les fiches députés.",
    tag: 'feature',
  },
  {
    date: '2026-08-30',
    title: 'SEO et performances',
    description: "Schema.org et Open Graph sur les pages d'élus et de scrutins. Chargement différé des ressources bloquantes, préchargement de la photo.",
    tag: 'perf',
  },
  {
    date: '2026-08-29',
    title: 'Déploiement Vercel',
    description: "Mise en production du site sur Vercel avec build statique, migrations Drizzle et déploiement automatique post-ingestion.",
    tag: 'infra',
  },
  {
    date: '2026-08-29',
    title: 'Ingestion de la presse',
    description: "Collecte des mentions presse via Google Actualités RSS. Affichage sur les fiches d'élus avec liens vers les articles sources.",
    tag: 'data',
  },
  {
    date: '2026-08-22',
    title: 'Recherche Pagefind',
    description: "Intégration de Pagefind pour la recherche instantanée côté client sur l'ensemble du site.",
    tag: 'feature',
  },
  {
    date: '2026-08-22',
    title: 'Fiches députés complètes',
    description: "Pages détaillées avec mandats, votes, groupes, collaborateurs, intérêts déclarés, adresses, liens externes, activité parlementaire, commissions et historique électoral.",
    tag: 'feature',
  },
  {
    date: '2026-08-22',
    title: 'Scaffold du site Astro',
    description: "Initialisation du site public avec Astro, React, Tailwind CSS. Layout de base, consentement cookies (tarteaucitron), sitemap.",
    tag: 'infra',
  },
  {
    date: '2026-08-22',
    title: "Pipeline d'ingestion AN",
    description: "Première version du pipeline d'ingestion : députés, collaborateurs, affiliations, intérêts HATVP, adresses, activité parlementaire, commissions, résultats électoraux. Orchestrateur avec retry exponentiel.",
    tag: 'data',
  },
  {
    date: '2026-08-21',
    title: 'Création du projet',
    description: "Initialisation du monorepo Yarn 4 workspaces, schéma PostgreSQL avec Drizzle ORM, CI GitHub Actions, documentation de base.",
    tag: 'infra',
  },
];

const tagConfig: Record<ChangelogEntry['tag'], { label: string; color: string }> = {
  feature: { label: 'Fonctionnalité', color: 'bg-indigo-100 text-indigo-700 dark:bg-indigo-900/40 dark:text-indigo-300' },
  data: { label: 'Données', color: 'bg-emerald-100 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300' },
  perf: { label: 'Performance', color: 'bg-amber-100 text-amber-700 dark:bg-amber-900/40 dark:text-amber-300' },
  infra: { label: 'Infrastructure', color: 'bg-slate-100 text-slate-700 dark:bg-slate-700/40 dark:text-slate-300' },
};

function formatDate(iso: string): string {
  return new Date(iso).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
}

const grouped = changelog.reduce<Record<string, ChangelogEntry[]>>((acc, entry) => {
  (acc[entry.date] ??= []).push(entry);
  return acc;
}, {});

const dates = Object.keys(grouped).sort((a, b) => b.localeCompare(a));
---

<BaseLayout title={title} description={description} hideShare>
  <div class="mx-auto max-w-3xl">
    <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">Changelog</h1>
    <p class="mt-2 text-lg text-slate-500 dark:text-slate-400">
      L'évolution d'Elupedia au fil du temps.
    </p>

    <div class="mt-10 relative">
      <div class="absolute left-4 top-0 bottom-0 w-px bg-slate-200 dark:bg-slate-700 sm:left-[7.5rem]" aria-hidden="true"></div>

      {dates.map((date) => (
        <div class="relative mb-10">
          <div class="flex items-start gap-6 sm:gap-8">
            <div class="hidden sm:block w-24 shrink-0 pt-1 text-right">
              <time datetime={date} class="text-sm font-medium text-slate-500 dark:text-slate-400">
                {formatDate(date)}
              </time>
            </div>

            <div class="relative flex-1">
              <div class="absolute -left-[0.4375rem] top-2 h-3.5 w-3.5 rounded-full border-2 border-white bg-indigo-500 dark:border-slate-900 sm:-left-[2.9375rem]" aria-hidden="true"></div>

              <time datetime={date} class="mb-2 block text-sm font-medium text-slate-500 dark:text-slate-400 sm:hidden">
                {formatDate(date)}
              </time>

              <div class="space-y-4">
                {grouped[date].map((entry) => (
                  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-slate-800">
                    <div class="flex flex-wrap items-center gap-2">
                      <span class={`inline-block rounded-full px-2.5 py-0.5 text-xs font-semibold ${tagConfig[entry.tag].color}`}>
                        {tagConfig[entry.tag].label}
                      </span>
                      <h2 class="text-base font-semibold text-slate-900 dark:text-white">
                        {entry.title}
                      </h2>
                    </div>
                    <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
                      {entry.description}
                    </p>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>

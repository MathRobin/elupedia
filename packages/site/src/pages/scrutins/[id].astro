---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDb } from '../../lib/db.js';
import { ballots, votes, officials, mandates } from '@elupedia/shared';
import { eq, isNull } from 'drizzle-orm';
import { DEPARTMENT_CODES } from '../../lib/department-codes.js';
import DepartmentMapWrapper from '../../components/DepartmentMapWrapper';

export async function getStaticPaths() {
  const db = getDb();

  const allBallots = await db
    .select({
      id: ballots.id,
      anId: ballots.anId,
      title: ballots.title,
      date: ballots.date,
      type: ballots.type,
    })
    .from(ballots);

  const allVotes = await db
    .select({
      ballotId: votes.ballotId,
      position: votes.position,
      officialId: votes.officialId,
      slug: officials.slug,
      firstName: officials.firstName,
      lastName: officials.lastName,
      photoUrl: officials.photoUrl,
      politicalGroup: mandates.politicalGroup,
      department: mandates.department,
    })
    .from(votes)
    .innerJoin(officials, eq(officials.id, votes.officialId))
    .leftJoin(mandates, eq(mandates.officialId, votes.officialId))
    .where(isNull(mandates.endDate));

  const votesByBallot = new Map<string, typeof allVotes>();
  for (const v of allVotes) {
    const list = votesByBallot.get(v.ballotId) ?? [];
    list.push(v);
    votesByBallot.set(v.ballotId, list);
  }

  return allBallots.map((ballot) => ({
    params: { id: ballot.id },
    props: {
      ballot,
      ballotVotes: votesByBallot.get(ballot.id) ?? [],
    },
  }));
}

type BallotVote = {
  ballotId: string;
  position: string;
  officialId: string;
  slug: string | null;
  firstName: string;
  lastName: string;
  photoUrl: string | null;
  politicalGroup: string | null;
  department: string | null;
};

type Props = {
  ballot: {
    id: string;
    anId: string | null;
    title: string;
    date: string;
    type: string;
  };
  ballotVotes: BallotVote[];
};

const { ballot, ballotVotes } = Astro.props as Props;

const positionLabels: Record<string, string> = {
  for: 'Pour',
  against: 'Contre',
  abstain: 'Abstention',
  absent: 'Absent',
};

const positionColors: Record<string, string> = {
  for: 'bg-emerald-500',
  against: 'bg-red-500',
  abstain: 'bg-amber-400',
  absent: 'bg-slate-300',
};

const positionBadge: Record<string, string> = {
  for: 'text-emerald-700 bg-emerald-50 ring-emerald-600/10 dark:text-emerald-400 dark:bg-emerald-900/20 dark:ring-emerald-400/20',
  against: 'text-red-700 bg-red-50 ring-red-600/10 dark:text-red-400 dark:bg-red-900/20 dark:ring-red-400/20',
  abstain: 'text-amber-700 bg-amber-50 ring-amber-600/10 dark:text-amber-400 dark:bg-amber-900/20 dark:ring-amber-400/20',
  absent: 'text-slate-600 bg-slate-50 ring-slate-500/10 dark:text-slate-400 dark:bg-slate-800 dark:ring-slate-400/20',
};

const counts: Record<string, number> = { for: 0, against: 0, abstain: 0, absent: 0 };
for (const v of ballotVotes) {
  counts[v.position] = (counts[v.position] ?? 0) + 1;
}

const groups = [...new Set(ballotVotes.map((v) => v.politicalGroup).filter(Boolean))].sort((a, b) => a!.localeCompare(b!, 'fr'));

const sortedVotes = [...ballotVotes].sort((a, b) =>
  `${a.lastName} ${a.firstName}`.localeCompare(`${b.lastName} ${b.firstName}`, 'fr'),
);

const votesByDept: Record<string, { for: number; against: number; abstain: number; absent: number }> = {};
const deptNames: Record<string, string> = {};
const normalizedDeptCodes: Record<string, string> = {};
for (const [name, code] of Object.entries(DEPARTMENT_CODES)) {
  deptNames[code] = name;
  normalizedDeptCodes[name.toLowerCase().replace(/\s+/g, '-')] = code;
}
function resolveDeptCode(dept: string): string | undefined {
  return DEPARTMENT_CODES[dept] ?? normalizedDeptCodes[dept.toLowerCase().replace(/\s+/g, '-')];
}
for (const v of ballotVotes) {
  if (!v.department) continue;
  const code = resolveDeptCode(v.department);
  if (!code) continue;
  if (!votesByDept[code]) votesByDept[code] = { for: 0, against: 0, abstain: 0, absent: 0 };
  const pos = v.position as 'for' | 'against' | 'abstain' | 'absent';
  if (pos in votesByDept[code]) votesByDept[code][pos]++;
}

const dateFormatted = new Date(ballot.date).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
const metaDescription = [
  `Scrutin du ${dateFormatted}`,
  `${counts.for} pour, ${counts.against} contre, ${counts.abstain} abstentions, ${counts.absent} absents`,
  ballot.type,
].join(' — ');

const ballotJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'VoteAction',
  name: ballot.title,
  startTime: ballot.date,
  location: {
    '@type': 'GovernmentOrganization',
    name: 'Assemblée nationale',
  },
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://www.elupedia.fr/' },
    { '@type': 'ListItem', position: 2, name: 'Votes', item: 'https://www.elupedia.fr/votes' },
    { '@type': 'ListItem', position: 3, name: ballot.title, item: `https://www.elupedia.fr/scrutins/${ballot.id}` },
  ],
};

const sourceUrl = ballot.anId
  ? `https://www.assemblee-nationale.fr/dyn/17/scrutins/${ballot.anId}`
  : null;
---

<BaseLayout title={ballot.title} description={metaDescription} jsonLd={ballotJsonLd}>
  <Fragment slot="head">
    <meta property="og:type" content="article" />
    <meta property="article:published_time" content={ballot.date} />
    <meta property="article:section" content="Scrutin" />
    <meta property="article:tag" content={ballot.type} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  </Fragment>
  <div class="max-w-5xl">
    <a href="/votes" class="inline-flex items-center gap-1 text-sm font-medium text-slate-500 hover:text-indigo-600 transition-colors no-underline">
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" /></svg>
      Retour aux votes
    </a>

    <h1 class="mt-6 text-2xl font-extrabold tracking-tight sm:text-3xl dark:text-white">{ballot.title}</h1>
    <div class="mt-2 flex flex-wrap items-center gap-3 text-sm text-slate-500 dark:text-slate-400">
      <span class="inline-flex items-center gap-1.5">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" /></svg>
        {new Date(ballot.date).toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })}
      </span>
      <span class="rounded-full bg-indigo-50 px-2.5 py-0.5 text-xs font-medium text-indigo-700 ring-1 ring-inset ring-indigo-600/10 dark:bg-indigo-900/20 dark:text-indigo-300 dark:ring-indigo-400/20">{ballot.type}</span>
      {sourceUrl && (
        <a
          href={sourceUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 text-indigo-600 hover:text-indigo-800 transition-colors no-underline dark:text-indigo-400 dark:hover:text-indigo-300"
        >
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" /></svg>
          Source officielle
        </a>
      )}
    </div>

    {ballotVotes.length > 0 && (
      <div class="mt-4">
        <span class={`inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-sm font-semibold ${
          counts.for > counts.against
            ? 'bg-emerald-50 text-emerald-700 ring-1 ring-inset ring-emerald-600/10 dark:bg-emerald-900/20 dark:text-emerald-400 dark:ring-emerald-400/20'
            : 'bg-red-50 text-red-700 ring-1 ring-inset ring-red-600/10 dark:bg-red-900/20 dark:text-red-400 dark:ring-red-400/20'
        }`}>
          {counts.for > counts.against ? 'Adopté' : 'Rejeté'}
        </span>
      </div>
    )}

    {ballotVotes.length > 0 && (
      <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
        {(['for', 'against', 'abstain', 'absent'] as const).map((pos) => (
          <div class="rounded-xl border border-slate-200/80 bg-white p-4 dark:border-slate-700 dark:bg-slate-800">
            <div class="flex items-center gap-2">
              <span class={`h-3 w-3 rounded-full ${positionColors[pos]}`}></span>
              <span class="text-sm font-medium text-slate-600 dark:text-slate-300">{positionLabels[pos]}</span>
            </div>
            <p class="mt-1 text-2xl font-bold tabular-nums text-slate-800 dark:text-white">{counts[pos] ?? 0}</p>
          </div>
        ))}
      </div>
    )}

    {ballotVotes.length > 0 && (
      <div class="mt-3 h-3 flex rounded-full overflow-hidden">
        {counts.for > 0 && <div class="bg-emerald-500" style={`width:${(counts.for / ballotVotes.length) * 100}%`}></div>}
        {counts.against > 0 && <div class="bg-red-500" style={`width:${(counts.against / ballotVotes.length) * 100}%`}></div>}
        {counts.abstain > 0 && <div class="bg-amber-400" style={`width:${(counts.abstain / ballotVotes.length) * 100}%`}></div>}
        {counts.absent > 0 && <div class="bg-slate-300 dark:bg-slate-600" style={`width:${(counts.absent / ballotVotes.length) * 100}%`}></div>}
      </div>
    )}

    <section class="mt-8">
      <h2 class="text-lg font-semibold border-l-4 border-indigo-500 pl-3 dark:text-white">
        Votes des députés
        <span class="ml-2 text-sm font-normal text-slate-500" id="visible-count">({ballotVotes.length})</span>
      </h2>

      {ballotVotes.length === 0 ? (
        <p class="mt-4 text-slate-500">Aucun vote enregistré pour ce scrutin.</p>
      ) : (
        <>
          <div class="mt-4 space-y-3">
            <div class="flex flex-wrap gap-2" id="position-filters">
              {(['for', 'against', 'abstain', 'absent'] as const).map((pos) => (
                <label class="inline-flex cursor-pointer items-center gap-1.5 rounded-full bg-white px-3 py-1.5 text-sm ring-1 ring-slate-900/5 select-none transition-all has-[:checked]:bg-indigo-50 has-[:checked]:ring-indigo-400/40 dark:bg-slate-800 dark:ring-slate-700 dark:has-[:checked]:bg-indigo-900/30 dark:has-[:checked]:ring-indigo-500/40">
                  <input type="checkbox" value={pos} checked class="accent-indigo-600 h-3.5 w-3.5" data-position-filter />
                  <span class={`h-2 w-2 rounded-full ${positionColors[pos]}`}></span>
                  <span class="dark:text-slate-300">{positionLabels[pos]} <span class="text-slate-400">({counts[pos] ?? 0})</span></span>
                </label>
              ))}
            </div>

            {groups.length > 1 && (
              <div class="flex flex-wrap gap-2" id="group-filters">
                <button type="button" id="group-toggle-all" class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-600 hover:bg-slate-200 transition-colors dark:bg-slate-700 dark:text-slate-300 dark:hover:bg-slate-600">
                  Tout cocher/décocher
                </button>
                {groups.map((g) => {
                  const gCount = ballotVotes.filter((v) => v.politicalGroup === g).length;
                  return (
                    <label class="inline-flex cursor-pointer items-center gap-1.5 rounded-full bg-white px-3 py-1.5 text-sm ring-1 ring-slate-900/5 select-none transition-all has-[:checked]:bg-indigo-50 has-[:checked]:ring-indigo-400/40 dark:bg-slate-800 dark:ring-slate-700 dark:has-[:checked]:bg-indigo-900/30 dark:has-[:checked]:ring-indigo-500/40">
                      <input type="checkbox" value={g} checked class="accent-indigo-600 h-3.5 w-3.5" data-group-filter />
                      <span class="dark:text-slate-300">{g} <span class="text-slate-400">({gCount})</span></span>
                    </label>
                  );
                })}
              </div>
            )}
          </div>

          <div class="mt-4 grid gap-2 sm:grid-cols-2 lg:grid-cols-3" id="votes-grid">
            {sortedVotes.map((v) => (
              <a
                href={`/elus/${v.slug ?? v.officialId}`}
                class="vote-card group flex items-center gap-3 rounded-lg border border-slate-200/80 bg-white p-3 transition-all hover:border-indigo-300/60 hover:shadow-sm no-underline dark:border-slate-700 dark:bg-slate-800 dark:hover:border-indigo-500/40"
                data-position={v.position}
                data-group={v.politicalGroup ?? ''}
                data-department={resolveDeptCode(v.department ?? '') ?? ''}
              >
                {v.photoUrl ? (
                  <img
                    src={v.photoUrl}
                    alt=""
                    class="h-10 w-10 rounded-full object-cover ring-2 ring-white dark:ring-slate-700"
                    loading="lazy"
                  />
                ) : (
                  <span class="flex h-10 w-10 items-center justify-center rounded-full bg-slate-100 text-sm font-semibold text-slate-500 ring-2 ring-white dark:bg-slate-700 dark:text-slate-400 dark:ring-slate-600">
                    {v.firstName[0]}{v.lastName[0]}
                  </span>
                )}
                <div class="min-w-0 flex-1">
                  <p class="truncate text-sm font-medium text-slate-800 group-hover:text-indigo-600 transition-colors dark:text-slate-100 dark:group-hover:text-indigo-400">
                    {v.firstName} {v.lastName}
                  </p>
                  <p class="truncate text-xs text-slate-400 dark:text-slate-500">{v.politicalGroup ?? 'Sans groupe'}</p>
                </div>
                <span class={`shrink-0 rounded-full px-2 py-0.5 text-xs font-semibold ring-1 ring-inset ${positionBadge[v.position] ?? ''}`}>
                  {positionLabels[v.position] ?? v.position}
                </span>
              </a>
            ))}
          </div>

          <p id="no-results" class="mt-4 hidden text-slate-500 dark:text-slate-400">Aucun député ne correspond aux filtres sélectionnés.</p>
        </>
      )}
    </section>

    {ballotVotes.length > 0 && Object.keys(votesByDept).length > 0 && (
      <section class="mt-10">
        <h2 class="text-lg font-semibold border-l-4 border-indigo-500 pl-3 dark:text-white">
          Répartition géographique
        </h2>
        <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">
          Survolez un département pour voir le détail des votes. Cliquez pour filtrer la liste ci-dessus.
        </p>
        <div class="mt-4 max-w-xl">
          <DepartmentMapWrapper client:load votesByDept={votesByDept} deptNames={deptNames} />
        </div>
      </section>
    )}
  </div>

  <script>
    const grid = document.getElementById('votes-grid');
    const visibleCount = document.getElementById('visible-count');
    const noResults = document.getElementById('no-results');
    if (grid) {
      const cards = grid.querySelectorAll<HTMLElement>('.vote-card');
      let activeDept: string | null = null;

      function applyFilters() {
        const posChecked = new Set(
          [...document.querySelectorAll<HTMLInputElement>('[data-position-filter]:checked')].map((i) => i.value),
        );
        const groupInputs = document.querySelectorAll<HTMLInputElement>('[data-group-filter]');
        const groupChecked = groupInputs.length > 0
          ? new Set([...groupInputs].filter((i) => i.checked).map((i) => i.value))
          : null;

        let count = 0;
        cards.forEach((card) => {
          const pos = card.dataset.position ?? '';
          const grp = card.dataset.group ?? '';
          const dept = card.dataset.department ?? '';
          const matchPos = posChecked.has(pos);
          const matchGrp = !groupChecked || groupChecked.has(grp) || (!grp && groupChecked.size === 0);
          const matchDept = !activeDept || dept === activeDept;
          const show = matchPos && matchGrp && matchDept;
          card.classList.toggle('hidden', !show);
          if (show) count++;
        });

        if (visibleCount) visibleCount.textContent = `(${count})`;
        if (noResults) noResults.classList.toggle('hidden', count > 0);
      }

      document.querySelectorAll('[data-position-filter], [data-group-filter]').forEach((input) => {
        input.addEventListener('change', applyFilters);
      });

      document.addEventListener('dept-filter', ((e: CustomEvent<string | null>) => {
        activeDept = e.detail;
        applyFilters();
      }) as EventListener);

      const toggleAll = document.getElementById('group-toggle-all');
      if (toggleAll) {
        toggleAll.addEventListener('click', () => {
          const inputs = document.querySelectorAll<HTMLInputElement>('[data-group-filter]');
          const allChecked = [...inputs].every((i) => i.checked);
          inputs.forEach((i) => (i.checked = !allChecked));
          applyFilters();
        });
      }
    }
  </script>
</BaseLayout>

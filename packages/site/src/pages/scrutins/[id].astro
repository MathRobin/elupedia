---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDb } from '../../lib/db.js';
import { ballots, votes, officials, mandates } from '@elupedia/shared';
import { eq, isNull } from 'drizzle-orm';

export async function getStaticPaths() {
  const db = getDb();

  const allBallots = await db
    .select({
      id: ballots.id,
      title: ballots.title,
      date: ballots.date,
      type: ballots.type,
    })
    .from(ballots);

  const allVotes = await db
    .select({
      ballotId: votes.ballotId,
      position: votes.position,
      officialId: votes.officialId,
      firstName: officials.firstName,
      lastName: officials.lastName,
      politicalGroup: mandates.politicalGroup,
    })
    .from(votes)
    .innerJoin(officials, eq(officials.id, votes.officialId))
    .leftJoin(mandates, eq(mandates.officialId, votes.officialId))
    .where(isNull(mandates.endDate));

  const votesByBallot = new Map<string, typeof allVotes>();
  for (const v of allVotes) {
    const list = votesByBallot.get(v.ballotId) ?? [];
    list.push(v);
    votesByBallot.set(v.ballotId, list);
  }

  return allBallots.map((ballot) => ({
    params: { id: ballot.id },
    props: {
      ballot,
      ballotVotes: votesByBallot.get(ballot.id) ?? [],
    },
  }));
}

type BallotVote = {
  ballotId: string;
  position: string;
  officialId: string;
  firstName: string;
  lastName: string;
  politicalGroup: string | null;
};

type Props = {
  ballot: {
    id: string;
    title: string;
    date: string;
    type: string;
  };
  ballotVotes: BallotVote[];
};

const { ballot, ballotVotes } = Astro.props as Props;

const positionLabels: Record<string, string> = {
  for: 'Pour',
  against: 'Contre',
  abstain: 'Abstention',
  absent: 'Absent',
};

const positionColors: Record<string, string> = {
  for: 'text-green-700 bg-green-50',
  against: 'text-red-700 bg-red-50',
  abstain: 'text-yellow-700 bg-yellow-50',
  absent: 'text-gray-500 bg-gray-50',
};

const sortedByName = [...ballotVotes].sort((a, b) =>
  `${a.lastName} ${a.firstName}`.localeCompare(`${b.lastName} ${b.firstName}`, 'fr'),
);
---

<BaseLayout title={ballot.title} description={`Scrutin du ${new Date(ballot.date).toLocaleDateString('fr-FR')}`}>
  <div class="max-w-3xl" data-pagefind-body>
    <a href="/" class="text-sm text-blue-600 hover:underline">&larr; Retour à la liste</a>

    <h1 class="mt-6 text-3xl font-bold">{ballot.title}</h1>
    <p class="mt-2 text-gray-500">
      {ballot.type} — {new Date(ballot.date).toLocaleDateString('fr-FR')}
    </p>

    <section class="mt-8">
      <h2 class="text-xl font-semibold border-b border-gray-200 pb-2">
        Votes des élus
        {ballotVotes.length > 0 && (
          <span class="ml-2 text-sm font-normal text-gray-400">({ballotVotes.length})</span>
        )}
      </h2>

      {ballotVotes.length === 0 ? (
        <p class="mt-4 text-gray-500">Aucun vote enregistré pour ce scrutin.</p>
      ) : (
        <div class="mt-4 overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-gray-200 text-left text-gray-500">
                <th class="pb-2 pr-4 font-medium">Élu</th>
                <th class="pb-2 pr-4 font-medium">Groupe politique</th>
                <th class="pb-2 font-medium">Position</th>
              </tr>
            </thead>
            <tbody>
              {sortedByName.map((v) => (
                <tr class="border-b border-gray-100">
                  <td class="py-2 pr-4">
                    <a href={`/elus/${v.officialId}`} class="text-blue-600 hover:underline">
                      {v.firstName} {v.lastName}
                    </a>
                  </td>
                  <td class="py-2 pr-4 text-gray-500">
                    {v.politicalGroup ?? '—'}
                  </td>
                  <td class="py-2">
                    <span class={`inline-block rounded px-2 py-0.5 text-xs font-medium ${positionColors[v.position] ?? ''}`}>
                      {positionLabels[v.position] ?? v.position}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </section>
  </div>
</BaseLayout>

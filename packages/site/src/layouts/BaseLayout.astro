---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  jsonLd?: Record<string, unknown>;
  ogType?: string;
}

const {
  title = 'Elupedia',
  description = 'Encyclopédie ouverte des élus français',
  image,
  jsonLd,
  ogType = 'website',
} = Astro.props;

const fullTitle = title === 'Elupedia' ? title : `${title} — Elupedia`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ?? new URL('/og-default.png', Astro.site).href;

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Elupedia',
  url: Astro.site?.href,
  description: 'Encyclopédie ouverte des élus français',
};
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/x-icon" href="/img/favicon.ico" />
    <title>{fullTitle}</title>
    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://www2.assemblee-nationale.fr" crossorigin />
    <link rel="dns-prefetch" href="https://www2.assemblee-nationale.fr" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Elupedia" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline src="/tarteaucitron/tarteaucitron.min.js"></script>
    <script is:inline>
      tarteaucitron.init({
        privacyUrl: '/donnees-personnelles',
        bodyPosition: 'bottom',
        hashtag: '#tarteaucitron',
        cookieName: 'tarteaucitron',
        orientation: 'middle',
        groupServices: false,
        showDetailsOnClick: true,
        serviceDefaultState: 'wait',
        showAlertSmall: false,
        cookieslist: false,
        closePopup: false,
        showIcon: true,
        iconPosition: 'BottomLeft',
        adblocker: false,
        DenyAllCta: true,
        AcceptAllCta: true,
        highPrivacy: true,
        handleBrowserDNTRequest: false,
        removeCredit: false,
        moreInfoLink: true,
        useExternalCss: true,
        useExternalJs: false,
        readmoreLink: '',
        mandatory: true,
        mandatoryCta: true,
      });
    </script>
    <link rel="stylesheet" href="/tarteaucitron/css/tarteaucitron.css" />
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900 flex flex-col antialiased">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:bg-indigo-600 focus:text-white focus:px-4 focus:py-2 focus:text-sm">
      Aller au contenu principal
    </a>

    <div class="h-1 bg-gradient-to-r from-blue-700 via-white to-red-600" aria-hidden="true"></div>

    <header class="bg-slate-900 shadow-lg">
      <nav class="mx-auto max-w-6xl px-4 py-4 flex items-center justify-between" aria-label="Navigation principale">
        <a href="/" class="flex items-center gap-2.5 text-xl font-bold text-white no-underline tracking-tight">
          <img src="/img/logo-32x32.png" alt="" width="32" height="32" class="w-8 h-8 rounded-lg" />
          Elupedia
        </a>
        <ul class="flex items-center gap-6 text-sm font-medium">
          <li><a href="/a-propos" class="text-slate-300 hover:text-white transition-colors no-underline">À propos</a></li>
          <li><a href="/donnees-personnelles" class="text-slate-300 hover:text-white transition-colors no-underline">Données personnelles</a></li>
          <li><a href="/mentions-legales" class="text-slate-300 hover:text-white transition-colors no-underline">Mentions légales</a></li>
        </ul>
      </nav>
    </header>

    <main id="main-content" class="mx-auto max-w-6xl px-4 py-10 flex-1 w-full">
      <slot />
    </main>

    <footer class="bg-slate-900 mt-auto">
      <div class="mx-auto max-w-6xl px-4 py-8">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <div>
            <p class="font-semibold text-white">Elupedia</p>
            <p class="mt-1 text-sm text-slate-400">Données ouvertes sur les élus français.</p>
          </div>
          <ul class="flex gap-6 text-sm text-slate-400">
            <li><a href="/a-propos" class="hover:text-white transition-colors no-underline">À propos</a></li>
            <li><a href="/mentions-legales" class="hover:text-white transition-colors no-underline">Mentions légales</a></li>
            <li>
              <a href="https://github.com/MathRobin/elupedia" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors no-underline">
                GitHub
              </a>
            </li>
          </ul>
        </div>
        <p class="mt-6 pt-6 border-t border-slate-800 text-xs text-slate-500">
          © 2024–2026 Elupedia · Licence AGPL-3.0 · Données sous Licence Ouverte 2.0
        </p>
      </div>
    </footer>
    <script>
      import { inject } from '@vercel/analytics';
      inject();
    </script>
  </body>
</html>

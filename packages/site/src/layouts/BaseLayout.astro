---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Elupedia',
  description = 'Encyclopédie ouverte des élus français',
} = Astro.props;

const fullTitle = title === 'Elupedia' ? title : `${title} — Elupedia`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og-default.png', Astro.site);
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <link rel="canonical" href={canonicalUrl.href} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Elupedia" />
    <script is:inline src="/tarteaucitron/tarteaucitron.min.js"></script>
    <script is:inline>
      tarteaucitron.init({
        privacyUrl: '/donnees-personnelles',
        bodyPosition: 'bottom',
        hashtag: '#tarteaucitron',
        cookieName: 'tarteaucitron',
        orientation: 'middle',
        groupServices: false,
        showDetailsOnClick: true,
        serviceDefaultState: 'wait',
        showAlertSmall: false,
        cookieslist: false,
        closePopup: false,
        showIcon: true,
        iconPosition: 'BottomRight',
        adblocker: false,
        DenyAllCta: true,
        AcceptAllCta: true,
        highPrivacy: true,
        handleBrowserDNTRequest: false,
        removeCredit: false,
        moreInfoLink: true,
        useExternalCss: true,
        useExternalJs: false,
        readmoreLink: '',
        mandatory: true,
        mandatoryCta: true,
      });
    </script>
    <link rel="stylesheet" href="/tarteaucitron/css/tarteaucitron.css" />
  </head>
  <body class="min-h-screen bg-white text-gray-900 flex flex-col">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:bg-blue-600 focus:text-white focus:px-4 focus:py-2 focus:text-sm">
      Aller au contenu principal
    </a>

    <header class="border-b border-gray-200">
      <nav class="mx-auto max-w-6xl px-4 py-4 flex items-center justify-between" aria-label="Navigation principale">
        <a href="/" class="text-xl font-bold text-gray-900 no-underline">
          Elupedia
        </a>
        <ul class="flex items-center gap-4 text-sm">
          <li><a href="/a-propos" class="text-gray-600 hover:text-gray-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-blue-600 no-underline">À propos</a></li>
          <li><a href="/donnees-personnelles" class="text-gray-600 hover:text-gray-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-blue-600 no-underline">Données personnelles</a></li>
          <li><a href="/mentions-legales" class="text-gray-600 hover:text-gray-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-blue-600 no-underline">Mentions légales</a></li>
        </ul>
      </nav>
    </header>

    <main id="main-content" class="mx-auto max-w-6xl px-4 py-8 flex-1">
      <slot />
    </main>

    <footer class="border-t border-gray-200 mt-auto">
      <div class="mx-auto max-w-6xl px-4 py-6 text-sm text-gray-500">
        <p>Elupedia — Données ouvertes sur les élus français.</p>
      </div>
    </footer>
    <script>
      import { inject } from '@vercel/analytics';
      inject();
    </script>
  </body>
</html>

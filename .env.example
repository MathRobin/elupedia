# Required at build time (Vercel: set as Environment Variable, NOT prefixed with PUBLIC_)
# Used by packages/shared to connect to Neon PostgreSQL during static site generation
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Génération des scripts de shorts vidéo (packages/shorts, API Claude)
ANTHROPIC_API_KEY=

# Dossier des fichiers produits par les shorts (prises de voix, audio, vidéo),
# relatif à packages/shorts
# SHORTS_OUTPUT_DIR=out
# ffmpeg / ffprobe : ceux du système, sinon ceux embarqués par Remotion
# FFMPEG_PATH=
# FFPROBE_PATH=

# Publication YouTube des shorts (packages/shorts) : identifiant client OAuth
# « Application de bureau » (Google Cloud, API YouTube Data v3 activée), puis
# `yarn --cwd packages/shorts youtube-auth` une fois pour obtenir le refresh token
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# public (défaut) | unlisted | private
# YOUTUBE_PRIVACY_STATUS=public

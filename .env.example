# Required at build time (Vercel: set as Environment Variable, NOT prefixed with PUBLIC_)
# Used by packages/shared to connect to Neon PostgreSQL during static site generation
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Génération des scripts de shorts vidéo (packages/shorts, API Claude)
ANTHROPIC_API_KEY=

# Voix off des shorts synthétisée par ElevenLabs (packages/shorts, commande
# `voiceover generate`, étape voiceover-shorts du DAG ingest-votes). Sans ces
# deux variables, la voix reste à enregistrer à la main (voiceover sheet/import).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Débit de la voix, 0.7 à 1.2 (1 = normal ; 0.95 par défaut, ton posé)
# ELEVENLABS_SPEED=0.95

# Deploy Hook Vercel (projet → Settings → Git → Deploy Hooks, branche main) :
# appelé en fin de DAG d'ingestion quand un rapport signale des changements,
# pour reconstruire les pages statiques (accueil, annuaire, votes).
# VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/prj_xxx/yyy

# Racine du dépôt que l'admin (packages/admin) doit regarder : rapports
# d'ingestion, DAGs, fichiers des shorts. Par défaut, le dépôt d'où l'admin est
# lancée ; à fixer si l'admin tourne depuis un autre checkout (worktree) que
# celui que Dagu met à jour.
# ELUPEDIA_REPO_ROOT=/usr/airporting/elupedia

# Dossier des fichiers produits par les shorts (prises de voix, audio, vidéo),
# relatif à packages/shorts
# SHORTS_OUTPUT_DIR=out
# ffmpeg / ffprobe : ceux du système, sinon ceux embarqués par Remotion
# FFMPEG_PATH=
# FFPROBE_PATH=

# Publication YouTube des shorts (packages/shorts) : identifiant client OAuth
# « Application de bureau » (Google Cloud, API YouTube Data v3 activée), puis
# `yarn --cwd packages/shorts youtube-auth` une fois pour obtenir le refresh token
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# public (défaut) | unlisted | private
# YOUTUBE_PRIVACY_STATUS=public

# Admin (packages/admin) : secret de signature des sessions Auth.js, requis
# (openssl rand -base64 32). Sur Vercel, AUTH_URL est inutile (hôte détecté).
# AUTH_SECRET=
# Force le mode de l'admin : 1 = machine d'ingestion/rendu (disque et tâches
# shorts disponibles), 0 = hébergée sans disque. Par défaut : 0 si VERCEL est
# posée, 1 sinon (voir packages/admin/src/lib/runtime.ts).
# ADMIN_LOCAL_MACHINE=

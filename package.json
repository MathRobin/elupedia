{
  "name": "elupedia",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run && yarn workspaces foreach -A run test",
    "typecheck": "tsc --build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx packages/shared/src/seed.ts",
    "smoke-test": "bash scripts/smoke-test.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.2.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "js-yaml": "^5.3.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "~5.8",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
